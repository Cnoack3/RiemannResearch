module(
    name = "riemann_research",
    version = "0.1.0",
    bazel_compatibility = [">=9.0.0", "<10.0.0"],
)

bazel_dep(name = "rules_lean", version = "0.7.0")
# Temporary compatibility patch for the pinned upstream revision:
# - Forward the existing Lake math-template compiler options to lean_library.
# - Bootstrap only required external modules; whole-library builds hit unrelated
#   upstream errors with our pinned Lean/dependency versions.
# - Pin Lean 4.33.0-rc2 archive checksums and make bootstrap retries safe.
# Drop the override when an upstream release provides equivalent support.
git_override(
    module_name = "rules_lean",
    remote = "https://github.com/tomato-bazel/rules_lean.git",
    commit = "e3b343ff799554a1e1a1d158d4a96eac5cdaa3ea",
    patches = ["//bazel:rules_lean_compat.patch"],
    patch_strip = 1,
)

lake = use_extension("@rules_lean//lean:lake.bzl", "lake")
# Dependency repository setup runs on the local client, even with RBE.
lake.workspace(
    name = "lake_deps",
    lean_toolchain = "//:lean-toolchain",
    lakefile = "//:lakefile.toml",
    lake_manifest = "//:lake-manifest.json",
    cache_roots = ["Mathlib"],
    allow_source_build = False,
    source_build_targets = [
        "Architect",
        "PrimeNumberTheoremAnd.SmoothExistence",
        "PrimeNumberTheoremAnd.Mathlib.Analysis.Asymptotics.Asymptotics",
        "Batteries.Tactic.Lemma",
    ],
)
use_repo(lake, "lake_deps")
register_toolchains("@lake_deps//:lean_toolchain_def")
