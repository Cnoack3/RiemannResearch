import Mathlib.Algebra.Category.ModuleCat.Descent
import Mathlib.Algebra.Category.ModuleCat.Pseudofunctor
import Mathlib.Algebra.Category.Ring.Colimits
import Mathlib.Algebra.Category.Ring.Constructions
import Mathlib.AlgebraicGeometry.Sites.Fpqc
import Mathlib.CategoryTheory.Sites.Coverage
import Mathlib.CategoryTheory.Sites.Descent.DescentDataPrime
import Mathlib.CategoryTheory.Sites.Descent.IsStack

/-!
# Affine faithfully flat descent for modules

This file puts two existing Mathlib descriptions of affine module descent in a
common project API:

* singleton Čech descent data for the extension-of-scalars pseudofunctor;
* coalgebras for the extension--restriction comonad.

For a faithfully flat ring map, Mathlib's comonadicity theorem makes the second
description equivalent to modules over the base ring. The remaining
Čech-to-comonad comparison is deliberately not asserted here: it requires the
tensor-product base-change isomorphism on the double overlap and its triple
overlap coherence.
-/

@[expose] public section

universe u v

noncomputable section

open CategoryTheory
open CategoryTheory.Limits
open AlgebraicGeometry

namespace RiemannResearch.AlgebraicGeometry

/-- The fpqc precoverage on affine schemes, pulled back along `Spec`. -/
noncomputable def affineFpqcPrecoverage :
    Precoverage (CommRingCat.{u}ᵒᵖ) :=
  Precoverage.comap Scheme.Spec Scheme.fpqcPrecoverage

/-- The Grothendieck topology generated by the affine fpqc precoverage. -/
noncomputable def affineFpqcTopology :
    GrothendieckTopology (CommRingCat.{u}ᵒᵖ) :=
  affineFpqcPrecoverage.toGrothendieck

/-- A faithfully flat ring map gives a singleton cover in the affine fpqc
precoverage. -/
theorem affineFpqcPrecoverage_singleton_mem
    {R A : CommRingCat.{u}} (f : R ⟶ A)
    (hf : f.hom.FaithfullyFlat) :
    Presieve.singleton f.op ∈
      affineFpqcPrecoverage.coverings (Opposite.op R) := by
  change Presieve.singleton f.op ∈
    (Precoverage.comap Scheme.Spec Scheme.fpqcPrecoverage).coverings
      (Opposite.op R)
  rw [Precoverage.mem_comap_iff]
  have h := (flat_and_surjective_SpecMap_iff f).2 hf
  let _ : Flat (Spec.map f) := h.1
  let _ : Surjective (Spec.map f) := h.2
  simp


/-- Extension of scalars, reindexed to the variance used by the affine site
`CommRingCatᵒᵖ`. -/
noncomputable def affineModulePseudofunctor :
    Pseudofunctor (LocallyDiscrete (CommRingCat.{u}ᵒᵖ)ᵒᵖ) Cat :=
  (unopUnop CommRingCat.{u}).toPseudofunctor.comp
    CommRingCat.moduleCatExtendScalarsPseudofunctor

@[simp]
theorem affineModulePseudofunctor_obj
    (R : LocallyDiscrete (CommRingCat.{u}ᵒᵖ)ᵒᵖ) :
    affineModulePseudofunctor.obj R =
      Cat.of (ModuleCat R.as.unop.unop) := by
  rfl

@[simp]
theorem affineModulePseudofunctor_map
    {R A : LocallyDiscrete (CommRingCat.{u}ᵒᵖ)ᵒᵖ}
    (f : R ⟶ A) :
    (affineModulePseudofunctor.map f).toFunctor =
      ModuleCat.extendScalars (CommRingCat.Hom.hom f.as.unop.unop) := by
  rfl

private noncomputable def canonicalChosenPullback
    {C : Type u} [Category.{v} C] {X₁ X₂ S : C}
    (f₁ : X₁ ⟶ S) (f₂ : X₂ ⟶ S) [HasPullback f₁ f₂] :
    ChosenPullback f₁ f₂ where
  pullback := pullback f₁ f₂
  p₁ := pullback.fst f₁ f₂
  p₂ := pullback.snd f₁ f₂
  condition := pullback.condition
  isLimit := pullbackIsPullback f₁ f₂

private noncomputable def canonicalChosenPullback₃
    {C : Type u} [Category.{v} C] {X₁ X₂ X₃ S : C}
    {f₁ : X₁ ⟶ S} {f₂ : X₂ ⟶ S} {f₃ : X₃ ⟶ S}
    (h₁₂ : ChosenPullback f₁ f₂)
    (h₂₃ : ChosenPullback f₂ f₃)
    (h₁₃ : ChosenPullback f₁ f₃)
    [HasPullback h₁₂.p₂ h₂₃.p₁] :
    ChosenPullback₃ h₁₂ h₂₃ h₁₃ := by
  let h := canonicalChosenPullback h₁₂.p₂ h₂₃.p₁
  refine { chosenPullback := h, l := ?_ }
  apply Classical.choice
  apply ChosenPullback.LiftStruct.nonempty
  · rw [Category.assoc, h₁₂.hp₁, Category.assoc, h₂₃.hp₂,
      ← h₁₂.hp₂, ← h₂₃.hp₁, ← Category.assoc, h.condition, Category.assoc]
  · rw [Category.assoc, h₁₂.hp₁]

/-- The tensor-product pullback representing the double overlap of the
singleton affine cover attached to `f`. Its underlying ring is
`A ⊗[R] A`. -/
noncomputable def affineCechPair
    {R A : CommRingCat.{u}} (f : R ⟶ A) :
    ChosenPullback f.op f.op := by
  letI : Algebra R A := RingHom.toAlgebra f.hom
  let h := (CommRingCat.isPushout_tensorProduct R A A).op
  exact
    { pullback := Opposite.op (CommRingCat.of (TensorProduct R A A))
      p₁ := (CommRingCat.ofHom
        Algebra.TensorProduct.includeRight.toRingHom).op
      p₂ := (CommRingCat.ofHom
        Algebra.TensorProduct.includeLeftRingHom).op
      condition := h.w
      isLimit := Classical.choice h.isLimit' }

/-- The canonical iterated pullback representing the triple overlap of the
singleton affine cover attached to `f`. -/
noncomputable def affineCechTriple
    {R A : CommRingCat.{u}} (f : R ⟶ A) :
    ChosenPullback₃ (affineCechPair f) (affineCechPair f)
      (affineCechPair f) :=
  canonicalChosenPullback₃ _ _ _

/-- Singleton affine Čech descent data, expressed using chosen double and
triple overlaps. -/
abbrev AffineCechModuleDescentData
    {R A : CommRingCat.{u}} (f : R ⟶ A) :=
  affineModulePseudofunctor.DescentData'
    (fun _ _ : PUnit.{u + 1} => affineCechPair f)
    (fun _ _ _ : PUnit.{u + 1} => affineCechTriple f)

/-- The choice-free category of singleton descent data for an affine ring map. -/
abbrev AffineModuleDescentData
    {R A : CommRingCat.{u}} (f : R ⟶ A) :=
  affineModulePseudofunctor.DescentData
    (fun _ : PUnit.{u + 1} => f.op)

/-- Chosen Čech descent data and choice-free descent data are equivalent. -/
noncomputable def affineCechDescentEquivalence
    {R A : CommRingCat.{u}} (f : R ⟶ A) :
    AffineCechModuleDescentData f ≌ AffineModuleDescentData f :=
  Pseudofunctor.DescentData'.descentDataEquivalence
    affineModulePseudofunctor
    (fun _ _ : PUnit.{u + 1} => affineCechPair f)
    (fun _ _ _ : PUnit.{u + 1} => affineCechTriple f)

/-- The canonical comparison from modules over the base ring to singleton
affine descent data. -/
noncomputable def affineModuleDescentComparison
    {R A : CommRingCat.{u}} (f : R ⟶ A) :
    ModuleCat R ⥤ AffineModuleDescentData f :=
  affineModulePseudofunctor.toDescentData
    (fun _ : PUnit.{u + 1} => f.op)

/-- Evaluation of singleton affine descent data at its unique cover member. -/
noncomputable def AffineModuleDescentData.evaluation
    {R A : CommRingCat.{u}} (f : R ⟶ A) :
    AffineModuleDescentData f ⥤ ModuleCat A where
  obj D := D.obj PUnit.unit
  map g := g.hom PUnit.unit
  map_id _ := rfl
  map_comp _ _ := rfl

/-- Forgetting the canonical affine descent datum recovers extension of
scalars. -/
@[simp]
theorem affineModuleDescentComparison_comp_evaluation
    {R A : CommRingCat.{u}} (f : R ⟶ A) :
    affineModuleDescentComparison f ⋙ AffineModuleDescentData.evaluation f =
      ModuleCat.extendScalars f.hom := by
  rfl

/-- The canonical comparison expressed in the chosen Čech normal form. -/
noncomputable def affineCechModuleDescentComparison
    {R A : CommRingCat.{u}} (f : R ⟶ A) :
    ModuleCat R ⥤ AffineCechModuleDescentData f :=
  affineModuleDescentComparison f ⋙
    Pseudofunctor.DescentData'.fromDescentDataFunctor
      affineModulePseudofunctor
      (fun _ _ : PUnit.{u + 1} => affineCechPair f)
      (fun _ _ _ : PUnit.{u + 1} => affineCechTriple f)

/-- Evaluation of chosen singleton Čech data at its unique cover member. -/
noncomputable def AffineCechModuleDescentData.evaluation
    {R A : CommRingCat.{u}} (f : R ⟶ A) :
    AffineCechModuleDescentData f ⥤ ModuleCat A where
  obj D := D.obj PUnit.unit
  map g := g.hom PUnit.unit
  map_id _ := rfl
  map_comp _ _ := rfl

/-- The chosen Čech comparison also has extension of scalars as its underlying
module-valued functor. -/
@[simp]
theorem affineCechModuleDescentComparison_comp_evaluation
    {R A : CommRingCat.{u}} (f : R ⟶ A) :
    affineCechModuleDescentComparison f ⋙
        AffineCechModuleDescentData.evaluation f =
      ModuleCat.extendScalars f.hom := by
  rfl

/-- The Eilenberg--Moore category for the extension--restriction comonad. -/
abbrev ComonadicModuleDescentData
    {R A : Type u} [CommRing R] [CommRing A] (f : R →+* A) :=
  (ModuleCat.extendRestrictScalarsAdj.{u, u, u} f).toComonad.Coalgebra

/-- The comparison into coalgebras for the extension--restriction comonad. -/
noncomputable def comonadicModuleDescentComparison
    {R A : Type u} [CommRing R] [CommRing A] (f : R →+* A) :
    ModuleCat.{u} R ⥤ ComonadicModuleDescentData f :=
  Comonad.comparison (ModuleCat.extendRestrictScalarsAdj.{u, u, u} f)

/-- The forgetful functor from extension--restriction coalgebras. -/
noncomputable def ComonadicModuleDescentData.forget
    {R A : Type u} [CommRing R] [CommRing A] (f : R →+* A) :
    ComonadicModuleDescentData f ⥤ ModuleCat.{u} A :=
  (ModuleCat.extendRestrictScalarsAdj.{u, u, u} f).toComonad.forget

/-- Forgetting the canonical coalgebra recovers extension of scalars, naturally. -/
noncomputable def comonadicModuleDescentComparisonForgetIso
    {R A : Type u} [CommRing R] [CommRing A] (f : R →+* A) :
    comonadicModuleDescentComparison f ⋙
        ComonadicModuleDescentData.forget f ≅
      ModuleCat.extendScalars.{u, u, u} f :=
  Comonad.comparisonForget
    (ModuleCat.extendRestrictScalarsAdj.{u, u, u} f)

/-- For a faithfully flat ring map, the comonadic comparison is an
equivalence. -/
theorem comonadicModuleDescentComparison_isEquivalence
    {R A : Type u} [CommRing R] [CommRing A]
    {f : R →+* A} (hf : f.FaithfullyFlat) :
    (comonadicModuleDescentComparison f).IsEquivalence := by
  let _ : ComonadicLeftAdjoint (ModuleCat.extendScalars.{u, u, u} f) :=
    comonadicExtendScalars hf
  change (Comonad.comparison
    (comonadicAdjunction
      (ModuleCat.extendScalars.{u, u, u} f))).IsEquivalence
  infer_instance

/-- Faithfully flat descent for modules, packaged as an equivalence with the
extension--restriction coalgebra category. -/
noncomputable def comonadicModuleDescentEquivalence
    {R A : Type u} [CommRing R] [CommRing A]
    {f : R →+* A} (hf : f.FaithfullyFlat) :
    ModuleCat.{u} R ≌ ComonadicModuleDescentData f := by
  let _ : (comonadicModuleDescentComparison f).IsEquivalence :=
    comonadicModuleDescentComparison_isEquivalence hf
  exact (comonadicModuleDescentComparison f).asEquivalence

@[simp]
theorem comonadicModuleDescentEquivalence_functor
    {R A : Type u} [CommRing R] [CommRing A]
    {f : R →+* A} (hf : f.FaithfullyFlat) :
    (comonadicModuleDescentEquivalence hf).functor =
      comonadicModuleDescentComparison f := by
  rfl

/-- The exact remaining bridge between chosen Čech descent data and comonadic
descent data. Besides an equivalence of categories, it records compatibility
with the two canonical comparison functors. -/
structure AffineCechComonadicBridge
    {R A : CommRingCat.{u}} (f : R ⟶ A) where
  /-- Chosen Čech descent data are equivalent to coalgebras for the
  extension--restriction comonad. -/
  equivalence :
    AffineCechModuleDescentData f ≌ ComonadicModuleDescentData f.hom
  /-- The equivalence identifies the Čech comparison with the comonadic
  comparison. -/
  comparisonIso :
    affineCechModuleDescentComparison f ⋙ equivalence.functor ≅
      comonadicModuleDescentComparison f.hom

/-- A faithfully flat ring map has effective chosen Čech module descent once
the Čech--comonadic bridge is supplied. -/
theorem affineCechModuleDescentComparison_isEquivalence_of_bridge
    {R A : CommRingCat.{u}} (f : R ⟶ A)
    (hf : f.hom.FaithfullyFlat)
    (bridge : AffineCechComonadicBridge f) :
    (affineCechModuleDescentComparison f).IsEquivalence := by
  let _ : (comonadicModuleDescentComparison f.hom).IsEquivalence :=
    comonadicModuleDescentComparison_isEquivalence hf
  let _ :
      (affineCechModuleDescentComparison f ⋙
        bridge.equivalence.functor).IsEquivalence :=
    Functor.isEquivalence_of_iso bridge.comparisonIso.symm
  exact Functor.isEquivalence_of_comp_right
    (affineCechModuleDescentComparison f) bridge.equivalence.functor

/-- A faithfully flat ring map has effective choice-free module descent once
the Čech--comonadic bridge is supplied. -/
theorem affineModuleDescentComparison_isEquivalence_of_bridge
    {R A : CommRingCat.{u}} (f : R ⟶ A)
    (hf : f.hom.FaithfullyFlat)
    (bridge : AffineCechComonadicBridge f) :
    (affineModuleDescentComparison f).IsEquivalence := by
  have h :=
    affineCechModuleDescentComparison_isEquivalence_of_bridge f hf bridge
  change (affineModuleDescentComparison f ⋙
    (affineCechDescentEquivalence f).inverse).IsEquivalence at h
  let _ : (affineModuleDescentComparison f ⋙
    (affineCechDescentEquivalence f).inverse).IsEquivalence := h
  exact Functor.isEquivalence_of_comp_right
    (affineModuleDescentComparison f) (affineCechDescentEquivalence f).inverse

/-- Under the Čech--comonadic bridge, the affine module pseudofunctor is a stack
for the singleton cover attached to a faithfully flat ring map. -/
theorem affineModulePseudofunctor_isStackFor_singleton_of_bridge
    {R A : CommRingCat.{u}} (f : R ⟶ A)
    (hf : f.hom.FaithfullyFlat)
    (bridge : AffineCechComonadicBridge f) :
    affineModulePseudofunctor.IsStackFor (Presieve.singleton f.op) := by
  rw [← Presieve.ofArrows_pUnit]
  exact
    (affineModulePseudofunctor.isStackFor_ofArrows_iff
      (ι := PUnit.{u + 1})
      (X := fun _ : PUnit.{u + 1} => Opposite.op A)
      (S := Opposite.op R)
      (fun _ : PUnit.{u + 1} => f.op)).2
      (affineModuleDescentComparison_isEquivalence_of_bridge f hf bridge)

end RiemannResearch.AlgebraicGeometry
