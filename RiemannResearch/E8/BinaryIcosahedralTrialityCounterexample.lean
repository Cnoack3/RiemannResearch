import RiemannResearch.E8.BinaryIcosahedralAtlas
import RiemannResearch.E8.BinaryIcosahedralSubsystemOrbits

/-!
# Binary icosahedral triality counterexample

Exact matrix certificates showing that the displayed degree-five
binary-tetrahedral stabilizer acts through the inner `W(D₄) × W(D₄)` image.
The accompanying GAP/TomLib certificate identifies its projective row up to
the immaterial pair `{4015,4017}`.
-/

open Matrix

namespace RiemannResearch.E8.BinaryIcosahedralAtlas

/-- The first ATLAS generator preserves the displayed integral quadratic
form. -/
theorem a_preserves_Q : A * Q * A.transpose = Q := by decide

/-- The second ATLAS generator preserves the displayed integral quadratic
form. -/
theorem b_preserves_Q : B * Q * B.transpose = Q := by decide

/-- The displayed integral quadratic form is symmetric. -/
theorem q_symmetric : Q.transpose = Q := by decide

/-! ## The certified inner action and the triality counterexample

The eight roots in `BinaryIcosahedralAtlas` are the simple roots of the two
orthogonal `D₄` components, as checked by `rootGram_eq_d4d4`. The submonoid
below is the matrix image generated by their simple reflections. Membership
therefore gives an exact certificate that an element acts through the inner
`W(D₄) × W(D₄)` image.

The independent GAP countercertificate checks that the matrix group generated
by `A,B` has order 120, narrows its projective class to the TomLib pair
`{4015, 4017}`, and checks that the matrix group generated by `w,j,r` is its
order-24 `2.A₄` stabilizer of this root subsystem. Both candidate rows have a
unique degree-five subsystem orbit. Those finite group-enumeration and
TomLib-identification statements remain at the documented external-certificate
boundary; the matrix isometries, reflection factorizations, and inner
order-three counterexample are checked here by Lean.
-/

/-- The eight simple-reflection matrices for the certified `D₄ ⊕ D₄`
subsystem. -/
def certifiedInnerD4xD4Generators : Set Mat8 :=
  Set.range fun i : I8 => refl (roots i)

/-- The reflection-generated matrix image of the certified inner
`W(D₄) × W(D₄)` action. -/
def certifiedInnerD4xD4 : Submonoid Mat8 :=
  Submonoid.closure certifiedInnerD4xD4Generators

theorem refl_root_mem_certifiedInnerD4xD4 (i : I8) :
    refl (roots i) ∈ certifiedInnerD4xD4 :=
  Submonoid.subset_closure (Set.mem_range_self i)

private theorem refl_a0_mem : refl a0 ∈ certifiedInnerD4xD4 := by
  change refl (roots 0) ∈ certifiedInnerD4xD4
  exact refl_root_mem_certifiedInnerD4xD4 0

private theorem refl_a1_mem : refl a1 ∈ certifiedInnerD4xD4 := by
  change refl (roots 1) ∈ certifiedInnerD4xD4
  exact refl_root_mem_certifiedInnerD4xD4 1

private theorem refl_a2_mem : refl a2 ∈ certifiedInnerD4xD4 := by
  change refl (roots 2) ∈ certifiedInnerD4xD4
  exact refl_root_mem_certifiedInnerD4xD4 2

private theorem refl_a3_mem : refl a3 ∈ certifiedInnerD4xD4 := by
  change refl (roots 3) ∈ certifiedInnerD4xD4
  exact refl_root_mem_certifiedInnerD4xD4 3

private theorem refl_b0_mem : refl b0 ∈ certifiedInnerD4xD4 := by
  change refl (roots 4) ∈ certifiedInnerD4xD4
  exact refl_root_mem_certifiedInnerD4xD4 4

private theorem refl_b1_mem : refl b1 ∈ certifiedInnerD4xD4 := by
  change refl (roots 5) ∈ certifiedInnerD4xD4
  exact refl_root_mem_certifiedInnerD4xD4 5

private theorem refl_b2_mem : refl b2 ∈ certifiedInnerD4xD4 := by
  change refl (roots 6) ∈ certifiedInnerD4xD4
  exact refl_root_mem_certifiedInnerD4xD4 6

private theorem refl_b3_mem : refl b3 ∈ certifiedInnerD4xD4 := by
  change refl (roots 7) ∈ certifiedInnerD4xD4
  exact refl_root_mem_certifiedInnerD4xD4 7

/-- The first binary-tetrahedral stabilizer generator acts through the inner
Weyl image of the two certified `D₄` components. -/
theorem w_mem_certifiedInnerD4xD4 : w ∈ certifiedInnerD4xD4 := by
  rw [w_eq_reflections]
  have hA1 : refl a0 * refl a1 * refl a2 ∈ certifiedInnerD4xD4 :=
    certifiedInnerD4xD4.mul_mem
      (certifiedInnerD4xD4.mul_mem refl_a0_mem refl_a1_mem) refl_a2_mem
  have hA2 : refl a0 * refl a1 * refl a3 ∈ certifiedInnerD4xD4 :=
    certifiedInnerD4xD4.mul_mem
      (certifiedInnerD4xD4.mul_mem refl_a0_mem refl_a1_mem) refl_a3_mem
  have hB1 : refl b2 * refl b0 * refl b1 ∈ certifiedInnerD4xD4 :=
    certifiedInnerD4xD4.mul_mem
      (certifiedInnerD4xD4.mul_mem refl_b2_mem refl_b0_mem) refl_b1_mem
  have hB2 : refl b3 * refl b0 * refl b1 ∈ certifiedInnerD4xD4 :=
    certifiedInnerD4xD4.mul_mem
      (certifiedInnerD4xD4.mul_mem refl_b3_mem refl_b0_mem) refl_b1_mem
  exact certifiedInnerD4xD4.mul_mem
    (certifiedInnerD4xD4.mul_mem
      (certifiedInnerD4xD4.mul_mem hA1 hA2) hB1) hB2

/-- The second binary-tetrahedral stabilizer generator acts through the inner
Weyl image of the two certified `D₄` components. -/
theorem j_mem_certifiedInnerD4xD4 : j ∈ certifiedInnerD4xD4 := by
  rw [j_eq_reflections]
  have hA1 : refl a0 * refl a2 * refl a3 ∈ certifiedInnerD4xD4 :=
    certifiedInnerD4xD4.mul_mem
      (certifiedInnerD4xD4.mul_mem refl_a0_mem refl_a2_mem) refl_a3_mem
  have hA2 : refl a0 * refl a1 * refl a2 ∈ certifiedInnerD4xD4 :=
    certifiedInnerD4xD4.mul_mem
      (certifiedInnerD4xD4.mul_mem refl_a0_mem refl_a1_mem) refl_a2_mem
  have hB1 : refl b0 * refl b1 * refl b2 ∈ certifiedInnerD4xD4 :=
    certifiedInnerD4xD4.mul_mem
      (certifiedInnerD4xD4.mul_mem refl_b0_mem refl_b1_mem) refl_b2_mem
  have hB2 : refl b0 * refl b1 * refl b3 ∈ certifiedInnerD4xD4 :=
    certifiedInnerD4xD4.mul_mem
      (certifiedInnerD4xD4.mul_mem refl_b0_mem refl_b1_mem) refl_b3_mem
  exact certifiedInnerD4xD4.mul_mem
    (certifiedInnerD4xD4.mul_mem
      (certifiedInnerD4xD4.mul_mem hA1 hA2) hB1) hB2

/-- The order-three binary-tetrahedral stabilizer generator acts through the
inner Weyl image of the two certified `D₄` components. -/
theorem r_mem_certifiedInnerD4xD4 : r ∈ certifiedInnerD4xD4 := by
  rw [r_eq_reflections]
  have hA1 :
      refl a0 * refl a1 * refl a0 * refl a2 ∈ certifiedInnerD4xD4 :=
    certifiedInnerD4xD4.mul_mem
      (certifiedInnerD4xD4.mul_mem
        (certifiedInnerD4xD4.mul_mem refl_a0_mem refl_a1_mem)
        refl_a0_mem)
      refl_a2_mem
  have hA2 :
      refl a0 * refl a3 * refl a0 * refl a2 ∈ certifiedInnerD4xD4 :=
    certifiedInnerD4xD4.mul_mem
      (certifiedInnerD4xD4.mul_mem
        (certifiedInnerD4xD4.mul_mem refl_a0_mem refl_a3_mem)
        refl_a0_mem)
      refl_a2_mem
  have hB :
      refl b1 * refl b0 * refl b2 * refl b0 ∈ certifiedInnerD4xD4 :=
    certifiedInnerD4xD4.mul_mem
      (certifiedInnerD4xD4.mul_mem
        (certifiedInnerD4xD4.mul_mem refl_b1_mem refl_b0_mem)
        refl_b2_mem)
      refl_b0_mem
  exact certifiedInnerD4xD4.mul_mem
    (certifiedInnerD4xD4.mul_mem hA1 hA2) hB

/-- The three matrices which GAP identifies as generators of the
binary-tetrahedral subsystem stabilizer. -/
def binaryTetrahedralMatrixGenerators : Fin 3 → Mat8 := ![w, j, r]

/-- The matrix monoid generated by `w`, `j`, and `r`. -/
def binaryTetrahedralMatrixMonoid : Submonoid Mat8 :=
  Submonoid.closure (Set.range binaryTetrahedralMatrixGenerators)

/-- Every matrix generated by the displayed binary-tetrahedral stabilizer
generators acts through the certified inner `W(D₄) × W(D₄)` image. -/
theorem binaryTetrahedralMatrixMonoid_le_certifiedInnerD4xD4 :
    binaryTetrahedralMatrixMonoid ≤ certifiedInnerD4xD4 := by
  apply Submonoid.closure_le.mpr
  rintro g ⟨i, rfl⟩
  fin_cases i
  · exact w_mem_certifiedInnerD4xD4
  · exact j_mem_certifiedInnerD4xD4
  · exact r_mem_certifiedInnerD4xD4

theorem r_mem_binaryTetrahedralMatrixMonoid :
    r ∈ binaryTetrahedralMatrixMonoid := by
  apply Submonoid.subset_closure
  exact ⟨2, rfl⟩

/-- Concrete counterexample to the outer-triality assertion in PDF
Proposition 6.17: the nonidentity order-three stabilizer matrix `r` lies in
the certified inner `W(D₄) × W(D₄)` image. -/
theorem r_orderThree_innerD4xD4_counterexample :
    r * r * r = (1 : Mat8) ∧
      r ≠ (1 : Mat8) ∧
      r ∈ binaryTetrahedralMatrixMonoid ∧
      r ∈ certifiedInnerD4xD4 :=
  ⟨r_pow_three, r_ne_one, r_mem_binaryTetrahedralMatrixMonoid,
    r_mem_certifiedInnerD4xD4⟩

/-- The corresponding universal outside-the-inner-image assertion is false
for the certified matrix stabilizer. -/
theorem not_all_nontrivial_orderThree_stabilizerElements_outer :
    ¬ ∀ g : Mat8,
      g ∈ binaryTetrahedralMatrixMonoid →
        g * g * g = (1 : Mat8) →
          g ≠ (1 : Mat8) →
            g ∉ certifiedInnerD4xD4 := by
  intro h
  exact h r r_mem_binaryTetrahedralMatrixMonoid r_pow_three r_ne_one
    r_mem_certifiedInnerD4xD4

/-- Corrected form of PDF Proposition 6.17 at the exact Lean certificate
boundary. The four projective A5 rows have twelve degree-five subsystem
orbits, but the displayed binary-tetrahedral stabilizer contains a
nonidentity order-three element in the certified inner Weyl image. Hence the
universal outer-triality clause is false.

The external GAP/TomLib certificate identifies this matrix action with one of
the singleton degree-five orbits in rows 4015 or 4017. That geometric
identification is not asserted by this theorem. -/
theorem correctedProposition617 :
    (RiemannResearch.E8.binaryIcosahedralSubsystemOrbitData.map fun row =>
      RiemannResearch.E8.orbitDegreeMultiplicity 5 row.d4d4OrbitHistogram).sum = 12 ∧
      (∃ g : Mat8,
        g * g * g = (1 : Mat8) ∧
        g ≠ (1 : Mat8) ∧
        g ∈ binaryTetrahedralMatrixMonoid ∧
        g ∈ certifiedInnerD4xD4) ∧
      ¬ ∀ g : Mat8,
        g ∈ binaryTetrahedralMatrixMonoid →
          g * g * g = (1 : Mat8) →
            g ≠ (1 : Mat8) →
              g ∉ certifiedInnerD4xD4 := by
  refine ⟨RiemannResearch.E8.binaryIcosahedral_degreeFiveOrbit_total, ?_, ?_⟩
  · exact ⟨r, r_orderThree_innerD4xD4_counterexample⟩
  · exact not_all_nontrivial_orderThree_stabilizerElements_outer

end RiemannResearch.E8.BinaryIcosahedralAtlas
