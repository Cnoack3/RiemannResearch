import RiemannResearch.RH.UniversalAtomCarryPresentation
import RiemannResearch.RH.FiniteCarryRamanujanDictionary
import Mathlib.Algebra.BigOperators.Group.Finset.Basic

/-!
# Detecting universal carry relations in finite Ramanujan coordinates

Source: the user's atom/carry CRT handoff, §14.3 and §14.6. Eliminating a word
gives a finite family of residue atoms. On any positive common period, its
nontrivial integrated-packet coordinates detect precisely when the word belongs
to the submodule generated by the certified floor-carry relations.
-/

noncomputable section
open scoped BigOperators

namespace RiemannResearch.RH.UniversalAtomCarry
open ArithmeticCumulative Pareto FiniteCarryRamanujanDictionary

/-- The coefficient obtained by transporting a finite word through atom elimination. -/
def wordPacketCoefficient (w : Word) (q : ℕ) : ℝ :=
  ∑ d ∈ (eliminate w).support, if q ∣ d.val then eliminate w d / (d.val : ℝ) else 0

/-- One positive common period, including for a word whose reduced support is empty. -/
def wordPeriod (w : Word) : ℕ := ∏ d ∈ (eliminate w).support, d.val

theorem wordPeriod_pos (w : Word) : 0 < wordPeriod w :=
  Finset.prod_pos (fun d _ => Nat.zero_lt_of_lt d.property)

theorem dvd_wordPeriod (w : Word) (d : Atom) (hd : d ∈ (eliminate w).support) :
    d.val ∣ wordPeriod w :=
  Finset.dvd_prod_of_mem (fun d : Atom => d.val) hd

theorem word_packet_expansion (w : Word) (L : ℕ) (hL : 0 < L)
    (hperiod : ∀ d ∈ (eliminate w).support, d.val ∣ L) (n : ℕ) :
    synthesis w n = ∑ q ∈ L.divisors, wordPacketCoefficient w q * ramanujanPacket q n := by
  classical
  change (∑ d ∈ (eliminate w).support, eliminate w d • atom d) n = _
  rw [Finset.sum_apply]
  calc
    _ = ∑ d ∈ (eliminate w).support, ∑ q ∈ L.divisors,
          (if q ∣ d.val then eliminate w d / (d.val : ℝ) else 0) * ramanujanPacket q n := by
      apply Finset.sum_congr rfl
      intro d hd
      exact multiple_atom_expansion L d.val n hL (Nat.zero_lt_of_lt d.property)
        (hperiod d hd) (eliminate w d)
    _ = _ := by
      rw [Finset.sum_comm]
      simp only [wordPacketCoefficient, Finset.sum_mul]

/-- Finite coordinates detect all defining relations. The zero packet at
conductor one is excluded from the test. -/
theorem mem_relations_iff_nontrivial_packets_vanish (w : Word) :
    w ∈ relations ↔ ∀ q ∈ (wordPeriod w).divisors, 1 < q → wordPacketCoefficient w q = 0 := by
  have hL := wordPeriod_pos w
  have hexp := word_packet_expansion w (wordPeriod w) hL (dvd_wordPeriod w)
  rw [relations_eq_ker, LinearMap.mem_ker]
  constructor
  · intro hz q hq hq1
    apply packet_coefficients_unique (wordPeriod w) hL (wordPacketCoefficient w) (fun _ => 0) _ q hq hq1
    intro n
    rw [← hexp, hz]
    simp
  · intro hz
    funext n
    rw [hexp]
    apply Finset.sum_eq_zero
    intro q hq
    by_cases h1 : q = 1
    · subst q
      simp [ramanujanPacket, Pareto.residue, Nat.mod_one]
    · have hp := Nat.pos_of_mem_divisors hq
      rw [hz q hq (by omega), zero_mul]

end RiemannResearch.RH.UniversalAtomCarry
