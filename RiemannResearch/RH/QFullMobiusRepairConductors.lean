import RiemannResearch.RH.QFullDilatedMobiusRepair
import RiemannResearch.RH.QFloorDilation
import RiemannResearch.RH.QMobiusExactHead
import RiemannResearch.NumberTheory.MobiusReciprocalSum
import Mathlib.Tactic.Abel
import Mathlib.Tactic.FieldSimp
import Mathlib.Tactic.Linarith
import Mathlib.Tactic.Ring
import Lean.Elab.Tactic.Omega

/-!
# Explicit atom support of the dilated Möbius repair

Source: user-provided `Reciprocal_Head_Investigation_2026-11-07.md`, Section 3.
The reciprocal-coefficient cancellation is exact and removes the additional
conductor-k atom introduced by dilation. All conductors of a repair of N
physical sites are at most 2N.
-/

noncomputable section
open scoped BigOperators
namespace RiemannResearch.RH.QFloorDilation
open ZetaTwoHilbert

/-- Dilation of a finite positive-conductor atom sum, retaining its correction. -/
theorem floorDilation_atom_sum (m : ℕ) (hm : 0 < m) (s : Finset ℕ)
    (c : ℕ → ℝ) (hs : ∀ d ∈ s, 0 < d) :
    floorDilation m hm (∑ d ∈ s, c d • qResidue d) =
      (∑ d ∈ s, c d • qResidue (m * d)) -
        (∑ d ∈ s, c d / (d : ℝ)) • qResidue m := by
  rw [map_sum]
  calc
    (∑ d ∈ s, floorDilation m hm (c d • qResidue d)) =
        ∑ d ∈ s, (c d • qResidue (m * d) -
          (c d / (d : ℝ)) • qResidue m) := by
      apply Finset.sum_congr rfl
      intro d hd
      rw [map_smul, floorDilation_qResidue m d hm (hs d hd),
        smul_sub, smul_smul]
      congr 1
      congr 1
      ring
    _ = _ := by rw [Finset.sum_sub_distrib, ← Finset.sum_smul]

end RiemannResearch.RH.QFloorDilation

namespace RiemannResearch.RH.QFullDilatedMobiusRepair
open ZetaTwoHilbert QFloorDilation QMobiusExactHead

/-- The correction from every old atom cancels the final compensator's correction. -/
theorem floorDilation_exactHead_atoms (m : ℕ) (hm : 0 < m) (N : ℕ) :
    floorDilation m hm (exactHead N) =
      -(∑ d ∈ Finset.Icc 1 N,
        (ArithmeticFunction.moebius d : ℝ) • qResidue (m * d)) +
      (((N + 1 : ℕ) : ℝ) * Pareto.mobiusReciprocalSum N) •
        qResidue (m * (N + 1)) := by
  rw [exactHead, map_add, map_neg, map_smul,
    floorDilation_atom_sum m hm (Finset.Icc 1 N)
      (fun d => (ArithmeticFunction.moebius d : ℝ))
      (fun d hd => (Finset.mem_Icc.mp hd).1),
    floorDilation_qResidue m (N + 1) hm (Nat.succ_pos N)]
  change -(_ - (Pareto.mobiusReciprocalSum N) • qResidue m) +
    (((N + 1 : ℕ) : ℝ) * Pareto.mobiusReciprocalSum N) •
      (qResidue (m * (N + 1)) - (1 / ((N + 1 : ℕ) : ℝ)) • qResidue m) = _
  rw [smul_sub, smul_smul]
  have hc : (((N + 1 : ℕ) : ℝ) * Pareto.mobiusReciprocalSum N) *
      (1 / ((N + 1 : ℕ) : ℝ)) = Pareto.mobiusReciprocalSum N := by
    field_simp [show ((N + 1 : ℕ) : ℝ) ≠ 0 by positivity]
  rw [hc]
  abel

/-- Every atom in the main dilated sum lies below the physical head cutoff. -/
theorem dilatedMobiusStep_main_conductor_le (N k d : ℕ)
    (hd : d ≤ N / (k + 1)) : (k + 1) * d ≤ N := by
  exact (Nat.mul_le_mul_left (k + 1) hd).trans (Nat.mul_div_le N (k + 1))

/-- The compensating conductor is bounded by N+k+1. -/
theorem dilatedMobiusStep_final_conductor_le (N k : ℕ) :
    (k + 1) * (N / (k + 1) + 1) ≤ N + (k + 1) := by
  have h := Nat.mul_div_le N (k + 1)
  nlinarith

/-- On the repair's actual index range the compensator is at most 2N. -/
theorem dilatedMobiusStep_final_conductor_le_two_head (N k : ℕ) (hk : k < N) :
    (k + 1) * (N / (k + 1) + 1) ≤ 2 * N := by
  have h := dilatedMobiusStep_final_conductor_le N k
  omega

/-- Exact bounded-conductor membership, including the complete physical tail. -/
theorem dilatedMobiusStep_mem_bounded_span (N k : ℕ) (hk : k < N) :
    dilatedMobiusStep N k ∈
      Submodule.span ℝ (qResidue '' Set.Icc 1 (2 * N)) := by
  rw [dilatedMobiusStep, floorDilation_exactHead_atoms]
  apply Submodule.add_mem
  · apply Submodule.neg_mem
    apply Submodule.sum_mem
    intro d hd
    apply Submodule.smul_mem
    apply Submodule.subset_span
    apply Set.mem_image_of_mem
    constructor
    · exact Nat.mul_pos (Nat.succ_pos k) (Finset.mem_Icc.mp hd).1
    · exact (dilatedMobiusStep_main_conductor_le N k d
        (Finset.mem_Icc.mp hd).2).trans (by omega)
  · apply Submodule.smul_mem
    apply Submodule.subset_span
    apply Set.mem_image_of_mem
    exact ⟨Nat.mul_pos (Nat.succ_pos k) (Nat.succ_pos _),
      dilatedMobiusStep_final_conductor_le_two_head N k hk⟩

/-- Every explicit repair of N sites is generated by conductors at most 2N. -/
theorem repair_mem_bounded_span (N : ℕ) (u : ℕ → ℝ) :
    repair N u ∈ Submodule.span ℝ (qResidue '' Set.Icc 1 (2 * N)) := by
  unfold repair
  apply Submodule.sum_mem
  intro k hk
  exact Submodule.smul_mem _ _
    (dilatedMobiusStep_mem_bounded_span N k (Finset.mem_range.mp hk))

end RiemannResearch.RH.QFullDilatedMobiusRepair
