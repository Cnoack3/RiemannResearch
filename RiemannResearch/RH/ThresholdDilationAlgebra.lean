import RiemannResearch.RH.ParetoDilation
import Mathlib.LinearAlgebra.Span.Defs

/-!
# Integer dilation algebra and its exact boundary mass

Source: Christian Noack, `RH_Two_Seed_Threshold.tex`, revised September 7,
2026, Sections 2, 4 and 10 (Library source identity
`libfile_7d48c5eae9388191a161c5421684dedd`).

This module proves algebraic synthesis with **every positive integer** dilation,
not merely the semigroup generated by the seeds. It also proves the exact
positive-integer pushforward formula including the mass sent to zero.
The existing `ParetoDilation` supplies the positive block weights and anchored
mean/norm identities. No RH criterion, completeness, or limiting legal repair
is assumed or proved here.
-/

open scoped BigOperators
namespace RiemannResearch.RH.Pareto
noncomputable section

/-- The unscaled raw pullback; unlike the Hilbert-space convention, it retains
the input's value at zero. -/
def rawPullback (m : ℕ) (f : ℕ → ℝ) (k : ℕ) : ℝ := f (k / m)

/-- Set the actual zero coordinate to zero, without changing any positive value. -/
def zeroAnchor (f : ℕ → ℝ) (k : ℕ) : ℝ := if k = 0 then 0 else f k

theorem dilation_comp (m n : ℕ) (f : ℕ → ℝ) :
    dilation m (dilation n f) = dilation (m * n) f := by
  funext k
  simp only [dilation, Nat.div_div_eq_div_mul, Nat.cast_mul]
  ring

theorem dilation_one (f : ℕ → ℝ) : dilation 1 f = f := by
  funext k
  simp [dilation]

theorem dilation_add (m : ℕ) (f g : ℕ → ℝ) :
    dilation m (f + g) = dilation m f + dilation m g := by
  funext k
  simp [dilation, mul_add]

theorem dilation_smul (m : ℕ) (c : ℝ) (f : ℕ → ℝ) :
    dilation m (c • f) = c • dilation m f := by
  funext k
  simp only [dilation, Pi.smul_apply, smul_eq_mul]
  ring

theorem dilation_cocycle (a n k : ℕ) :
    dilation a (residue n) k - residue n k =
      dilation n (residue a) k - residue a k := by
  rw [residue_mul_floor, residue_mul_floor, Nat.mul_comm n a]
  ring

/-- Exact residue telescoping, before passage to any closure. -/
theorem residue_pow_telescope (a e k : ℕ) :
    residue (a ^ e) k =
      ∑ j ∈ Finset.range e, dilation (a ^ j) (residue a) k := by
  induction e with
  | zero => simp [residue, Nat.mod_one]
  | succ e ih =>
    rw [Finset.sum_range_succ, ← ih, residue_mul_floor, ← pow_succ]
    ring

/-- The synthesis remains legal after an arbitrary integer dilation. -/
theorem dilation_seed_pow_telescope (m a e k : ℕ) :
    dilation m (residue (a ^ e)) k =
      ∑ j ∈ Finset.range e, dilation (m * a ^ j) (residue a) k := by
  induction e with
  | zero => simp [dilation, residue, Nat.mod_one]
  | succ e ih =>
    rw [Finset.sum_range_succ, ← ih]
    rw [residue_mul_floor, residue_mul_floor, residue_mul_floor, pow_succ]
    rw [Nat.mul_assoc]
    ring

/-- Algebraic, finite legal synthesis, without closure or an RH hypothesis. -/
def legalSeedSpan (A : Set ℕ) : Submodule ℝ (ℕ → ℝ) :=
  Submodule.span ℝ {f | ∃ a ∈ A, ∃ m : ℕ, 0 < m ∧ f = dilation m (residue a)}

theorem dilation_generator_mem (A : Set ℕ) {a m : ℕ} (ha : a ∈ A) (hm : 0 < m) :
    dilation m (residue a) ∈ legalSeedSpan A :=
  Submodule.subset_span ⟨a, ha, m, hm, rfl⟩

/-- All positive integer dilation parameters preserve the legal algebraic span. -/
theorem legalSeedSpan_dilation (A : Set ℕ) {f : ℕ → ℝ}
    (hf : f ∈ legalSeedSpan A) (m : ℕ) (hm : 0 < m) :
    dilation m f ∈ legalSeedSpan A := by
  induction hf using Submodule.span_induction with
  | mem f hf =>
    obtain ⟨a, ha, n, hn, rfl⟩ := hf
    rw [dilation_comp]
    exact dilation_generator_mem A ha (Nat.mul_pos hm hn)
  | zero =>
    have h : dilation m (0 : ℕ → ℝ) = 0 := by ext k; simp [dilation]
    rw [h]
    exact (legalSeedSpan A).zero_mem
  | add f g hf hg ihf ihg =>
    rw [dilation_add]
    exact (legalSeedSpan A).add_mem ihf ihg
  | smul c f hf ih =>
    rw [dilation_smul]
    exact (legalSeedSpan A).smul_mem c ih

theorem legalSeedSpan_zero_value (A : Set ℕ) {f : ℕ → ℝ}
    (hf : f ∈ legalSeedSpan A) : f 0 = 0 := by
  induction hf using Submodule.span_induction with
  | mem f hf =>
    obtain ⟨a, ha, m, hm, rfl⟩ := hf
    simp [dilation, residue]
  | zero => rfl
  | add f g hf hg ihf ihg => simp [ihf, ihg]
  | smul c f hf ih => simp [ih]

/-- Algebraic synthesis of every power-seed from the original seed. -/
theorem power_seed_mem_legalSeedSpan (A : Set ℕ) {a : ℕ}
    (ha : a ∈ A) (ha0 : 0 < a) (e : ℕ) : residue (a ^ e) ∈ legalSeedSpan A := by
  have he : residue (a ^ e) =
      ∑ j ∈ Finset.range e, dilation (a ^ j) (residue a) := by
    funext k
    simpa using residue_pow_telescope a e k
  rw [he]
  apply (legalSeedSpan A).sum_mem
  intro j hj
  exact dilation_generator_mem A ha (pow_pos ha0 j)

/-- Exact positive mass of the block sent to zero. -/
theorem positiveWeight_initial (m : ℕ) (hm : 0 < m) :
    (∑ k ∈ Finset.range m, positiveWeight k) = 1 - 1 / (m : ℝ) := by
  obtain ⟨n, rfl⟩ := Nat.exists_eq_succ_of_ne_zero (ne_of_gt hm)
  rw [Finset.sum_range_succ']
  simp only [positiveWeight_succ, paretoWeight_partial_sum]
  norm_num [positiveWeight, Nat.cast_add, Nat.cast_one]

/-- Positive fibers have weight w_j/m; no value-zero hypothesis is needed. -/
theorem rawPullback_positive_block (m j : ℕ) (hm : 0 < m) (hj : 0 < j)
    (f : ℕ → ℝ) :
    (∑ k ∈ Finset.Ico (m*j) (m*(j+1)), positiveWeight k * rawPullback m f k) =
      positiveWeight j / m * f j := by
  have hd (k : ℕ) (hk : k ∈ Finset.Ico (m*j) (m*(j+1))) : k / m = j := by
    apply Nat.div_eq_of_lt_le
    · simpa [Nat.mul_comm] using (Finset.mem_Ico.mp hk).1
    · simpa [Nat.mul_comm] using (Finset.mem_Ico.mp hk).2
  calc
    _ = (∑ k ∈ Finset.Ico (m*j) (m*(j+1)), positiveWeight k) * f j := by
      rw [Finset.sum_mul]
      apply Finset.sum_congr rfl
      intro k hk
      simp [rawPullback, hd k hk]
    _ = _ := by rw [positiveWeight_block m j hm hj]

/-- Raw pullback of the first block retains the boundary mass. -/
theorem rawPullback_initial_block (m : ℕ) (hm : 0 < m) (f : ℕ → ℝ) :
    (∑ k ∈ Finset.range m, positiveWeight k * rawPullback m f k) =
      (1 - 1 / (m : ℝ)) * f 0 := by
  calc
    _ = (∑ k ∈ Finset.range m, positiveWeight k) * f 0 := by
      rw [Finset.sum_mul]
      apply Finset.sum_congr rfl
      intro k hk
      simp [rawPullback, Nat.div_eq_of_lt (Finset.mem_range.mp hk)]
    _ = _ := by rw [positiveWeight_initial m hm]

/-- Finite pushforward formula with the complete boundary term. -/
theorem rawPullback_partial_sum (m N : ℕ) (hm : 0 < m) (f : ℕ → ℝ) :
    (∑ k ∈ Finset.range (m*(N+1)), positiveWeight k * rawPullback m f k) =
      (∑ j ∈ Finset.range (N+1), positiveWeight j * f j) / m +
        (1 - 1 / (m : ℝ)) * f 0 := by
  induction N with
  | zero => simpa [positiveWeight] using rawPullback_initial_block m hm f
  | succ N ih =>
    rw [show m * (N + 1 + 1) = m * (N + 1) + m by ring,
      Finset.sum_range_add, ih]
    have hs : (∑ j ∈ Finset.range (N + 1 + 1), positiveWeight j * f j) =
        (∑ j ∈ Finset.range (N + 1), positiveWeight j * f j) +
          positiveWeight (N+1) * f (N+1) := Finset.sum_range_succ _ _
    rw [hs]
    have hb := rawPullback_positive_block m (N+1) hm (by omega) f
    rw [Finset.sum_Ico_eq_sum_range] at hb
    have hb' :
        (∑ k ∈ Finset.range m,
          positiveWeight (m * (N + 1) + k) * rawPullback m f (m * (N + 1) + k)) =
          positiveWeight (N+1) / m * f (N+1) := by
      simpa [Nat.mul_add, Nat.add_sub_cancel_left] using hb
    rw [hb']
    ring

/-- Infinite positive-integer pushforward, with ordinary summability hypotheses. -/
theorem rawPullback_tsum (m : ℕ) (hm : 0 < m) (f : ℕ → ℝ)
    (hf : Summable (fun k => positiveWeight k * f k))
    (hd : Summable (fun k => positiveWeight k * rawPullback m f k)) :
    paretoMean (rawPullback m f) = paretoMean f / m +
      (1 - 1 / (m : ℝ)) * f 0 := by
  have hpn : Filter.Tendsto (fun N : ℕ => m*(N+1)) Filter.atTop Filter.atTop := by
    apply Filter.tendsto_atTop_mono (fun N => ?_) Filter.tendsto_id
    exact le_trans (Nat.le_succ N) (Nat.le_mul_of_pos_left (N+1) hm)
  have hleft := hd.hasSum.tendsto_sum_nat.comp hpn
  have hright := ((hf.hasSum.tendsto_sum_nat.comp (Filter.tendsto_add_atTop_nat 1)).div_const
    (m : ℝ)).add_const ((1 - 1 / (m : ℝ)) * f 0)
  have heq : (fun N => ∑ k ∈ Finset.range (m*(N+1)), positiveWeight k * rawPullback m f k) =
      (fun N => (∑ j ∈ Finset.range (N+1), positiveWeight j * f j) / m +
        (1 - 1 / (m : ℝ)) * f 0) := by
    funext N
    exact rawPullback_partial_sum m N hm f
  simp only [Function.comp_def] at hleft hright
  rw [heq] at hleft
  exact tendsto_nhds_unique hleft hright

/-- The raw pushforward identity for every bounded test function. -/
theorem paretoMean_rawPullback {f : ℕ → ℝ} {C : ℝ} (hC : ∀ k, |f k| ≤ C)
    (m : ℕ) (hm : 0 < m) :
    paretoMean (rawPullback m f) = paretoMean f / m +
      (1 - 1 / (m : ℝ)) * f 0 := by
  exact rawPullback_tsum m hm f (weighted_summable_of_bounded hC)
    (weighted_summable_of_bounded (fun k => hC (k / m)))

/-- The full mixed-term boundary anomaly, not just its diagonal specialization. -/
theorem paretoInner_rawPullback {f g : ℕ → ℝ} {C D : ℝ}
    (hC : ∀ k, |f k| ≤ C) (hD : ∀ k, |g k| ≤ D) (m : ℕ) (hm : 0 < m) :
    paretoInner (rawPullback m f) (rawPullback m g) = paretoInner f g / m +
      (1 - 1 / (m : ℝ)) * (f 0 * g 0) := by
  exact paretoMean_rawPullback (bounded_product hC hD) m hm

/-- Pointwise repair of the raw pullback at all positive integer coordinates. -/
theorem rawPullback_boundary_repair (m : ℕ) (hm : 0 < m) (f : ℕ → ℝ)
    (k : ℕ) (hk : 0 < k) :
    rawPullback m (zeroAnchor f) k =
      rawPullback m f k - if k < m then f 0 else 0 := by
  by_cases hkm : k < m
  · simp [rawPullback, zeroAnchor, Nat.div_eq_of_lt hkm, hkm]
  · have hdiv : k / m ≠ 0 := by
      have : 1 ≤ k / m := (Nat.le_div_iff_mul_le hm).mpr (by omega)
      omega
    simp [rawPullback, zeroAnchor, hdiv, hkm]

end
end RiemannResearch.RH.Pareto
