import RiemannResearch.RH.ThresholdHilbertLegal

/-!
# The exact cocycle in the completed Hilbert space

Source: Christian Noack, RH_Two_Seed_Threshold.tex, September 8, 2026,
Section 4, proof of the main threshold theorem (statement and proof strategy).

The finite residue cocycle extends to the closed space generated by all
positive-integer seeds. This proves the orthogonality reduction used in the
two-seed argument. Full residue density and joint adjoint rigidity are not
assumed without being stated as hypotheses.
-/

namespace RiemannResearch.RH.Pareto
noncomputable section


/-- With every positive seed available, integer dilations do not enlarge
the finite residue span. This identifies the full space in the cocycle
reduction with the discrete Nyman--Beurling residue space. -/
theorem legalSeedSpan_positive_eq_residue_span :
    legalSeedSpan {n : ℕ | 0 < n} =
      Submodule.span ℝ {f : ℕ → ℝ | ∃ n : ℕ, 0 < n ∧ f = residue n} := by
  apply le_antisymm
  · apply Submodule.span_le.mpr
    rintro f ⟨n, hn, m, hm, rfl⟩
    have he : dilation m (residue n) = residue (m*n) - residue m := by
      funext k
      exact residue_mul_floor m n k
    rw [he]
    exact Submodule.sub_mem _
      (Submodule.subset_span ⟨m*n, Nat.mul_pos hm hn, rfl⟩)
      (Submodule.subset_span ⟨m, hm, rfl⟩)
  · apply Submodule.span_le.mpr
    rintro f ⟨n, hn, rfl⟩
    exact residue_mem_legalSeedSpan _ hn

private theorem dilation_sub_sequence (m : ℕ) (f g : ℕ → ℝ) :
    dilation m (f - g) = dilation m f - dilation m g := by
  funext k
  simp [dilation, mul_sub]

/-- Every positive-seed combination has a legal seed-a cocycle difference. -/
theorem dilation_sub_mem_legalSeedSpan (A : Set ℕ) {a : ℕ}
    (ha : a ∈ A) {f : ℕ → ℝ}
    (hf : f ∈ legalSeedSpan {n : ℕ | 0 < n}) :
    dilation a f - f ∈ legalSeedSpan A := by
  induction hf using Submodule.span_induction with
  | mem f hf =>
    obtain ⟨n, hn, m, hm, rfl⟩ := hf
    have hc : dilation a (residue n) - residue n =
        dilation n (residue a) - residue a := by
      funext k
      exact dilation_cocycle a n k
    have he : dilation a (dilation m (residue n)) - dilation m (residue n) =
        dilation (m*n) (residue a) - dilation m (residue a) := by
      calc
        _ = dilation m (dilation a (residue n) - residue n) := by
          rw [dilation_sub_sequence, dilation_comp, dilation_comp, Nat.mul_comm a m]
        _ = dilation m (dilation n (residue a) - residue a) := by rw [hc]
        _ = _ := by rw [dilation_sub_sequence, dilation_comp]
    rw [he]
    exact (legalSeedSpan A).sub_mem
      (dilation_generator_mem A ha (Nat.mul_pos hm hn))
      (dilation_generator_mem A ha hm)
  | zero =>
    have he : dilation a (0 : ℕ → ℝ) - 0 = 0 := by
      funext k
      simp [dilation]
    rw [he]
    exact (legalSeedSpan A).zero_mem
  | add f g hf hg ihf ihg =>
    have he : dilation a (f+g) - (f+g) =
        (dilation a f - f) + (dilation a g - g) := by
      rw [dilation_add]
      abel
    rw [he]
    exact (legalSeedSpan A).add_mem ihf ihg
  | smul c f hf ih =>
    rw [dilation_smul, ← smul_sub]
    exact (legalSeedSpan A).smul_mem c ih

/-- The cocycle maps the full finite legal space into the seed-a legal space. -/
theorem hilbertDilation_sub_mem_legalSubspace (A : Set ℕ) {a : ℕ}
    (ha : a ∈ A) (ha0 : 0 < a) {f : ThresholdHilbert}
    (hf : f ∈ hilbertLegalSubspace {n : ℕ | 0 < n}) :
    hilbertDilation a ha0 f - f ∈ hilbertLegalSubspace A := by
  change hilbertSequence (hilbertDilation a ha0 f - f) ∈ legalSeedSpan A
  rw [show hilbertSequence (hilbertDilation a ha0 f - f) =
      hilbertSequence (hilbertDilation a ha0 f) - hilbertSequence f from
        hilbertSequenceLinear.map_sub _ _, hilbertDilation_sequence]
  exact dilation_sub_mem_legalSeedSpan A ha hf

/-- Continuity extends the exact cocycle to the genuine Hilbert closure. -/
theorem hilbertDilation_sub_mem_legalClosure (A : Set ℕ) {a : ℕ}
    (ha : a ∈ A) (ha0 : 0 < a) {f : ThresholdHilbert}
    (hf : f ∈ hilbertLegalClosure {n : ℕ | 0 < n}) :
    hilbertDilation a ha0 f - f ∈ hilbertLegalClosure A := by
  let L : ThresholdHilbert →L[ℝ] ThresholdHilbert :=
    hilbertDilationContinuous a ha0 - ContinuousLinearMap.id ℝ ThresholdHilbert
  have hmap : Set.MapsTo L
      (hilbertLegalSubspace {n : ℕ | 0 < n} : Set ThresholdHilbert)
      (hilbertLegalSubspace A : Set ThresholdHilbert) := by
    intro g hg
    exact hilbertDilation_sub_mem_legalSubspace A ha ha0 hg
  exact hmap.closure L.continuous hf

/-- An annihilator of seed-a legal vectors has adjoint defect orthogonal to
the entire full residue closure. This is unconditional. -/
theorem adjoint_sub_mem_full_orthogonal (A : Set ℕ) {a : ℕ}
    (ha : a ∈ A) (ha0 : 0 < a) {h : ThresholdHilbert}
    (hh : h ∈ (hilbertLegalClosure A)ᗮ) :
    hilbertDilationAdjoint a ha0 h - h ∈
      (hilbertLegalClosure {n : ℕ | 0 < n})ᗮ := by
  apply (Submodule.mem_orthogonal _ _).mpr
  intro f hf
  have ho := (Submodule.mem_orthogonal _ _).mp hh
    (hilbertDilation a ha0 f - f)
    (hilbertDilation_sub_mem_legalClosure A ha ha0 hf)
  rw [inner_sub_left] at ho
  rw [inner_sub_right]
  change inner ℝ f ((hilbertDilationContinuous a ha0).adjoint h) - inner ℝ f h = 0
  rw [ContinuousLinearMap.adjoint_inner_right]
  exact ho

/-- Once full residue density is available, every seed annihilator is fixed
by the corresponding actual Hilbert adjoint. -/
theorem adjoint_fixed_of_legal_orthogonal_of_full_density (A : Set ℕ) {a : ℕ}
    (ha : a ∈ A) (ha0 : 0 < a)
    (hfull : hilbertLegalClosure {n : ℕ | 0 < n} = ⊤)
    {h : ThresholdHilbert} (hh : h ∈ (hilbertLegalClosure A)ᗮ) :
    hilbertDilationAdjoint a ha0 h = h := by
  have hd := adjoint_sub_mem_full_orthogonal A ha ha0 hh
  apply ext_inner_left ℝ
  intro f
  have hf : f ∈ hilbertLegalClosure {n : ℕ | 0 < n} := by
    rw [hfull]
    trivial
  have ho := (Submodule.mem_orthogonal _ _).mp hd f hf
  rw [inner_sub_right] at ho
  exact sub_eq_zero.mp ho

end
end RiemannResearch.RH.Pareto
