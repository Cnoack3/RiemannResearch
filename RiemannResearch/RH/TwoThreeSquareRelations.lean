import RiemannResearch.RH.TwoThreeCanonicalBasis
import Mathlib.LinearAlgebra.Pi
import Mathlib.Tactic.Abel

/-!
# Every finite two-seed relation is generated by commuting squares

Source: the user-provided generalized CRT discussion, 16 September 2026.
The generators are the actual arithmetic sequences, not formal independent
symbols. The existing canonical independence theorem supplies the only
arithmetic injectivity input. This module works at each finite budget and
does not require polynomial variables or infinity-categorical descent.
-/

open scoped BigOperators

namespace RiemannResearch.RH.Pareto.FiniteTwoSeedCompletion

noncomputable section

private def finiteCombination {ι E : Type*} [Fintype ι]
    [AddCommGroup E] [Module ℝ E] (v : ι → E) : (ι → ℝ) →ₗ[ℝ] E where
  toFun c := ∑ i, c i • v i
  map_add' a b := by simp [add_smul, Finset.sum_add_distrib]
  map_smul' a b := by simp [Finset.smul_sum, smul_smul]

private def coefficientAtom {ι : Type*} [DecidableEq ι] (i : ι) : ι → ℝ :=
  fun j => if j = i then 1 else 0

private theorem finiteCombination_atom {ι E : Type*} [Fintype ι] [DecidableEq ι]
    [AddCommGroup E] [Module ℝ E] (v : ι → E) (i : ι) :
    finiteCombination v (coefficientAtom i) = v i := by
  simp [finiteCombination, coefficientAtom]

/-- Both seeds at every positive index up to the budget. -/
def fullSeedIndices (M : ℕ) : Finset (ℕ × ℕ) :=
  {2, 3} ×ˢ Finset.Icc 1 M

theorem mem_fullSeedIndices (M : ℕ) (i : ℕ × ℕ) :
    i ∈ fullSeedIndices M ↔ (i.1 = 2 ∨ i.1 = 3) ∧ 0 < i.2 ∧ i.2 ≤ M := by
  simp only [fullSeedIndices, Finset.mem_product, Finset.mem_insert,
    Finset.mem_singleton, Finset.mem_Icc]
  omega

theorem canonicalIndices_subset_full (M : ℕ) :
    canonicalIndices M ⊆ fullSeedIndices M := by
  intro i hi
  obtain ⟨hpos, hupp, hi3 | ⟨hi2, _⟩⟩ := (mem_canonicalIndices M i).mp hi
  · exact (mem_fullSeedIndices M i).mpr ⟨Or.inr hi3, hpos, hupp⟩
  · exact (mem_fullSeedIndices M i).mpr ⟨Or.inl hi2, hpos, hupp⟩

/-- The finite raw coefficient space. -/
abbrev FullSeedCoefficients (M : ℕ) := fullSeedIndices M → ℝ

/-- A raw coordinate unit, expressed by its ordinary seed-index pair. -/
def seedCoefficientUnit (M : ℕ) (i : ℕ × ℕ) : FullSeedCoefficients M :=
  fun r => if r.val = i then 1 else 0

private theorem seedCoefficientUnit_eq_atom (M : ℕ) (i : fullSeedIndices M) :
    seedCoefficientUnit M i.val = coefficientAtom i := by
  funext r
  by_cases h : r = i
  · subst r
    simp [seedCoefficientUnit, coefficientAtom]
  · have hval : r.val ≠ i.val := fun he => h (Subtype.ext he)
    simp [seedCoefficientUnit, coefficientAtom, h, hval]

private theorem coefficient_reconstruction (M : ℕ) (c : FullSeedCoefficients M) :
    (∑ i : fullSeedIndices M, c i • seedCoefficientUnit M i.val) = c := by
  simp_rw [seedCoefficientUnit_eq_atom]
  funext r
  simp [coefficientAtom, Finset.sum_apply, Pi.smul_apply, smul_eq_mul]

/-- Synthesis into actual residue-difference sequences. -/
def fullSeedSynthesis (M : ℕ) : FullSeedCoefficients M →ₗ[ℝ] (ℕ → ℝ) :=
  finiteCombination (fun i : fullSeedIndices M => dilation i.val.2 (residue i.val.1))

theorem fullSeedSynthesis_unit (M : ℕ) (i : ℕ × ℕ) (hi : i ∈ fullSeedIndices M) :
    fullSeedSynthesis M (seedCoefficientUnit M i) = dilation i.2 (residue i.1) := by
  change finiteCombination _ (seedCoefficientUnit M (⟨i, hi⟩ : fullSeedIndices M).val) = _
  rw [seedCoefficientUnit_eq_atom, finiteCombination_atom]

/-- Embed canonical coefficients in the full coefficient space. -/
def canonicalCoefficientLift (M : ℕ) :
    (canonicalIndices M → ℝ) →ₗ[ℝ] FullSeedCoefficients M :=
  finiteCombination (fun i : canonicalIndices M => seedCoefficientUnit M i.val)

private theorem canonical_unit_mem_range (M : ℕ) (i : ℕ × ℕ)
    (hi : i ∈ canonicalIndices M) :
    seedCoefficientUnit M i ∈ LinearMap.range (canonicalCoefficientLift M) := by
  refine ⟨coefficientAtom (⟨i, hi⟩ : canonicalIndices M), ?_⟩
  exact finiteCombination_atom _ _

theorem fullSeedSynthesis_canonicalCoefficientLift (M : ℕ)
    (c : canonicalIndices M → ℝ) :
    fullSeedSynthesis M (canonicalCoefficientLift M c) =
      ∑ i : canonicalIndices M, c i • canonicalFamily M i := by
  change fullSeedSynthesis M (∑ i : canonicalIndices M,
    c i • seedCoefficientUnit M i.val) = _
  rw [map_sum]
  apply Finset.sum_congr rfl
  intro i _
  rw [map_smul, fullSeedSynthesis_unit M i.val (canonicalIndices_subset_full M i.property)]
  rfl

private theorem canonical_lift_synthesis_eq_zero (M : ℕ)
    (c : canonicalIndices M → ℝ)
    (hc : fullSeedSynthesis M (canonicalCoefficientLift M c) = 0) : c = 0 := by
  rw [fullSeedSynthesis_canonicalCoefficientLift] at hc
  funext i
  exact (linearIndependent_iff'.mp (canonicalFamily_linearIndependent M))
    Finset.univ c hc i (Finset.mem_univ i)

/-- A commuting square as a relation among raw coefficients. -/
def formalSquare (M k : ℕ) : FullSeedCoefficients M :=
  seedCoefficientUnit M (2, 3*k) - seedCoefficientUnit M (3, 2*k) -
    seedCoefficientUnit M (2, k) + seedCoefficientUnit M (3, k)

/-- Exactly those commuting squares lying inside the finite budget. -/
def squareIndices (M : ℕ) : Finset ℕ := Finset.Icc 1 (M / 3)

def squareFamily (M : ℕ) (i : squareIndices M) : FullSeedCoefficients M :=
  formalSquare M i.val

def squareRelationSpan (M : ℕ) : Submodule ℝ (FullSeedCoefficients M) :=
  Submodule.span ℝ (Set.range (squareFamily M))

theorem formalSquare_mem (M k : ℕ) (hk : 0 < k) (hkM : 3*k ≤ M) :
    formalSquare M k ∈ squareRelationSpan M := by
  apply Submodule.subset_span
  exact ⟨⟨k, Finset.mem_Icc.mpr ⟨by omega, by omega⟩⟩, rfl⟩

theorem fullSeedSynthesis_formalSquare (M k : ℕ) (hk : 0 < k) (hkM : 3*k ≤ M) :
    fullSeedSynthesis M (formalSquare M k) = 0 := by
  have h23 : (2, 3*k) ∈ fullSeedIndices M :=
    (mem_fullSeedIndices M (2, 3*k)).mpr ⟨Or.inl rfl, by omega, hkM⟩
  have h32 : (3, 2*k) ∈ fullSeedIndices M :=
    (mem_fullSeedIndices M (3, 2*k)).mpr ⟨Or.inr rfl, by omega, by omega⟩
  have h2 : (2, k) ∈ fullSeedIndices M :=
    (mem_fullSeedIndices M (2, k)).mpr ⟨Or.inl rfl, hk, by omega⟩
  have h3 : (3, k) ∈ fullSeedIndices M :=
    (mem_fullSeedIndices M (3, k)).mpr ⟨Or.inr rfl, hk, by omega⟩
  simp only [formalSquare, map_add, map_sub]
  rw [fullSeedSynthesis_unit M (2, 3*k) h23,
    fullSeedSynthesis_unit M (3, 2*k) h32,
    fullSeedSynthesis_unit M (2, k) h2,
    fullSeedSynthesis_unit M (3, k) h3]
  rw [binary_three_elimination]
  abel

theorem squareRelationSpan_le_ker (M : ℕ) :
    squareRelationSpan M ≤ LinearMap.ker (fullSeedSynthesis M) := by
  apply Submodule.span_le.mpr
  rintro _ ⟨i, rfl⟩
  have hi := Finset.mem_Icc.mp i.property
  exact fullSeedSynthesis_formalSquare M i.val (by omega) (by omega)

private theorem ternary_unit_mem_range (M n : ℕ) (hn : 0 < n) (hnM : n ≤ M) :
    seedCoefficientUnit M (3, n) ∈ LinearMap.range (canonicalCoefficientLift M) := by
  apply canonical_unit_mem_range
  exact (mem_canonicalIndices M (3, n)).mpr ⟨hn, hnM, Or.inl rfl⟩

private theorem binary_unit_mem_sup (M n : ℕ) (hn : 0 < n) (hnM : n ≤ M) :
    seedCoefficientUnit M (2, n) ∈
      LinearMap.range (canonicalCoefficientLift M) ⊔ squareRelationSpan M := by
  have hall : ∀ n : ℕ, n ≤ M → 0 < n →
      seedCoefficientUnit M (2, n) ∈
        LinearMap.range (canonicalCoefficientLift M) ⊔ squareRelationSpan M := by
    intro n
    induction n using Nat.strong_induction_on with
    | h n ih =>
      intro hnM hn
      by_cases h3 : 3 ∣ n
      · obtain ⟨k, rfl⟩ := h3
        have hk : 0 < k := by omega
        have hs : formalSquare M k ∈
            LinearMap.range (canonicalCoefficientLift M) ⊔ squareRelationSpan M :=
          (show squareRelationSpan M ≤
              LinearMap.range (canonicalCoefficientLift M) ⊔ squareRelationSpan M
            from le_sup_right) (formalSquare_mem M k hk hnM)
        have ht2 : seedCoefficientUnit M (3, 2*k) ∈
            LinearMap.range (canonicalCoefficientLift M) ⊔ squareRelationSpan M :=
          (show LinearMap.range (canonicalCoefficientLift M) ≤
              LinearMap.range (canonicalCoefficientLift M) ⊔ squareRelationSpan M
            from le_sup_left) (ternary_unit_mem_range M (2*k) (by omega) (by omega))
        have ht1 : seedCoefficientUnit M (3, k) ∈
            LinearMap.range (canonicalCoefficientLift M) ⊔ squareRelationSpan M :=
          (show LinearMap.range (canonicalCoefficientLift M) ≤
              LinearMap.range (canonicalCoefficientLift M) ⊔ squareRelationSpan M
            from le_sup_left) (ternary_unit_mem_range M k hk (by omega))
        have hb := ih k (by omega) (by omega) hk
        have he : seedCoefficientUnit M (2, 3*k) =
            formalSquare M k + seedCoefficientUnit M (3, 2*k) +
              seedCoefficientUnit M (2, k) - seedCoefficientUnit M (3, k) := by
          unfold formalSquare
          abel
        rw [he]
        exact Submodule.sub_mem _ (Submodule.add_mem _
          (Submodule.add_mem _ hs ht2) hb) ht1
      · apply (show LinearMap.range (canonicalCoefficientLift M) ≤
            LinearMap.range (canonicalCoefficientLift M) ⊔ squareRelationSpan M
          from le_sup_left)
        apply canonical_unit_mem_range
        exact (mem_canonicalIndices M (2, n)).mpr ⟨hn, hnM, Or.inr ⟨rfl, h3⟩⟩
  exact hall n hnM hn

private theorem canonical_range_sup_squares_eq_top (M : ℕ) :
    LinearMap.range (canonicalCoefficientLift M) ⊔ squareRelationSpan M = ⊤ := by
  apply top_unique
  intro c _
  rw [← coefficient_reconstruction M c]
  apply Submodule.sum_mem
  intro i _
  apply Submodule.smul_mem
  obtain ⟨hi2 | hi3, hpos, hupp⟩ := (mem_fullSeedIndices M i.val).mp i.property
  · have hi : i.val = (2, i.val.2) := Prod.ext hi2 rfl
    rw [hi]
    exact binary_unit_mem_sup M i.val.2 hpos hupp
  · have hi : i.val = (3, i.val.2) := Prod.ext hi3 rfl
    rw [hi]
    exact (show LinearMap.range (canonicalCoefficientLift M) ≤
        LinearMap.range (canonicalCoefficientLift M) ⊔ squareRelationSpan M
      from le_sup_left) (ternary_unit_mem_range M i.val.2 hpos hupp)

/-- Complete finite syzygy statement: every zero arithmetic combination of the
full two-seed family is a linear combination of the ordinary 2-by-3 squares. -/
theorem fullSeedSynthesis_ker_eq_squareRelationSpan (M : ℕ) :
    LinearMap.ker (fullSeedSynthesis M) = squareRelationSpan M := by
  apply le_antisymm
  · intro c hc
    have ht : c ∈ LinearMap.range (canonicalCoefficientLift M) ⊔ squareRelationSpan M := by
      rw [canonical_range_sup_squares_eq_top]
      trivial
    rcases Submodule.mem_sup.mp ht with ⟨u, hu, v, hv, rfl⟩
    obtain ⟨d, rfl⟩ := hu
    have hv0 : fullSeedSynthesis M v = 0 := squareRelationSpan_le_ker M hv
    change fullSeedSynthesis M (canonicalCoefficientLift M d + v) = 0 at hc
    rw [map_add, hv0, add_zero] at hc
    have hd := canonical_lift_synthesis_eq_zero M d hc
    simpa [hd] using hv
  · exact squareRelationSpan_le_ker M

private theorem formalSquare_apply_binary (M k n : ℕ)
    (hn : (2, n) ∈ fullSeedIndices M) :
    formalSquare M k ⟨(2, n), hn⟩ =
      (if n = 3*k then 1 else 0) - (if n = k then 1 else 0) := by
  simp [formalSquare, seedCoefficientUnit]

/-- The commuting squares themselves are independent: the maximal active
binary pivot cannot be cancelled by another square. -/
theorem squareFamily_linearIndependent (M : ℕ) :
    LinearIndependent ℝ (squareFamily M) := by
  classical
  apply linearIndependent_iff'.mpr
  intro s c hz i hi
  by_contra hci
  let t := s.filter (fun j => c j ≠ 0)
  have hit : i ∈ t := Finset.mem_filter.mpr ⟨hi, hci⟩
  have ht : (t.image Subtype.val).Nonempty := ⟨i.val, Finset.mem_image.mpr ⟨i, hit, rfl⟩⟩
  let k := (t.image Subtype.val).max' ht
  obtain ⟨j, hjt, hjk⟩ := Finset.mem_image.mp (Finset.max'_mem _ ht)
  change j.val = k at hjk
  have hjs : j ∈ s := (Finset.mem_filter.mp hjt).1
  have hcj : c j ≠ 0 := (Finset.mem_filter.mp hjt).2
  have hji := Finset.mem_Icc.mp j.property
  have hk : 0 < k := by omega
  have hkM : 3*k ≤ M := by omega
  have hmax (a : squareIndices M) (has : a ∈ s) (hca : c a ≠ 0) : a.val ≤ k :=
    Finset.le_max' (t.image Subtype.val) a.val
      (Finset.mem_image.mpr ⟨a, Finset.mem_filter.mpr ⟨has, hca⟩, rfl⟩)
  have hpivot : (2, 3*k) ∈ fullSeedIndices M :=
    (mem_fullSeedIndices M (2, 3*k)).mpr ⟨Or.inl rfl, by omega, hkM⟩
  let pivot : fullSeedIndices M := ⟨(2, 3*k), hpivot⟩
  have hsum : (∑ a ∈ s, c a * squareFamily M a pivot) = c j := by
    calc
      _ = c j * squareFamily M j pivot := by
        apply Finset.sum_eq_single j
        · intro a has haj
          by_cases hca : c a = 0
          · simp [hca]
          · have han : a.val ≠ k := fun he => haj (Subtype.ext (he.trans hjk.symm))
            have hale := hmax a has hca
            have hleft : 3*k ≠ 3*a.val := by omega
            have hright : 3*k ≠ a.val := by omega
            simp [squareFamily, pivot, formalSquare_apply_binary, hleft, hright]
        · exact fun hnot => False.elim (hnot hjs)
      _ = c j := by
        have hright : 3*k ≠ k := by omega
        simp [squareFamily, pivot, formalSquare_apply_binary, hjk, hright]
  have heval := congrArg (fun f : FullSeedCoefficients M => f pivot) hz
  have hzero : (∑ a ∈ s, c a * squareFamily M a pivot) = 0 := by
    simpa only [Finset.sum_apply, Pi.smul_apply, smul_eq_mul, Pi.zero_apply] using heval
  exact hcj (hsum.symm.trans hzero)

/-- There is exactly one independent relation for each redundant binary column. -/
theorem finrank_fullSeedSynthesis_ker (M : ℕ) :
    Module.finrank ℝ (LinearMap.ker (fullSeedSynthesis M)) = M / 3 := by
  rw [fullSeedSynthesis_ker_eq_squareRelationSpan]
  unfold squareRelationSpan
  rw [finrank_span_eq_card (squareFamily_linearIndependent M), Fintype.card_coe]
  simp [squareIndices, Nat.card_Icc]

end
end RiemannResearch.RH.Pareto.FiniteTwoSeedCompletion
