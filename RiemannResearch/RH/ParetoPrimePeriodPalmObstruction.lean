import RiemannResearch.RH.QFullDivisorProjection
import RiemannResearch.RH.ParetoResiduePalmSineLimit
import RiemannResearch.Analysis.MontgomeryPositiveGapDensity
import Mathlib.LinearAlgebra.Matrix.Determinant.Basic
import Mathlib.MeasureTheory.Integral.DominatedConvergence

/-! # The prime-period obstruction to a legal reduced-Palm limit

The full-divisor physical dictionary at a prime period is generated by one
residue atom. A one-feature frequency kernel has zero two-point determinant,
whereas the reduced sine kernel at the integer offsets one and two has unit
determinant. On the interval from zero to three, even trace approximation
has a positive deficit for a normalized single feature. The latter statement
takes the auxiliary diagonal limit as an explicit input.

Source: the full-divisor and reduced-Palm comparison in section 4 of
Infinite_DPP_and_Sine_Limits_20261109.md.
-/

noncomputable section
open Filter MeasureTheory Set
open scoped Topology

namespace RiemannResearch.RH.QFullDivisorProjection
open ZetaTwoHilbert QSquarefreeLatticePackets QParetoEquivalence

/-- Only the conductor of the prime itself contributes to the full divisor stage. -/
theorem divisorStage_prime_eq_span {p : ℕ} (hp : p.Prime) :
    divisorStage p = Submodule.span ℝ {qResidue p} := by
  apply le_antisymm
  · apply Submodule.span_le.mpr
    rintro f ⟨d, hd, rfl⟩
    rcases (Nat.dvd_prime hp).mp hd with rfl | rfl
    · simp
    · exact Submodule.subset_span (Set.mem_singleton _)
  · apply Submodule.span_le.mpr
    rintro f (rfl : f = qResidue p)
    exact Submodule.subset_span ⟨p, dvd_refl _, rfl⟩

/-- The one-generator identity holds in complete Pareto coordinates. -/
theorem paretoStage_prime_eq_span (p : ℕ+) (hp : (p : ℕ).Prime) :
    paretoStage p = Submodule.span ℝ {paretoEquiv (qResidue (p : ℕ))} := by
  rw [paretoStage, divisorStage_prime_eq_span hp, Submodule.map_span, Set.image_singleton]
  rfl

end RiemannResearch.RH.QFullDivisorProjection

namespace RiemannResearch.RH.Pareto.ResidueMellin
open RiemannResearch.Analysis.MontgomeryPositiveGap

/-- The unfolded one-feature kernel, including an arbitrary coordinate and gauge
in its feature, has identically vanishing two-point determinant. -/
theorem oneFeatureKernel_pair_det (φ : ℝ → ℂ) (x y : ℝ) :
    Matrix.det !![φ x * star (φ x), φ x * star (φ y);
                  φ y * star (φ x), φ y * star (φ y)] = 0 := by
  rw [Matrix.det_fin_two]
  simp
  ring

theorem reducedSineKernel_pair_det_one_two :
    Matrix.det !![reducedSineKernel 1 1, reducedSineKernel 1 2;
                  reducedSineKernel 2 1, reducedSineKernel 2 2] = 1 := by
  have h1 : Real.sinc Real.pi = 0 := by
    simp [Real.sinc_of_ne_zero Real.pi_ne_zero]
  have h2 : Real.sinc (Real.pi * 2) = 0 := by
    rw [Real.sinc_of_ne_zero (by positivity), mul_comm, Real.sin_two_mul, Real.sin_pi]
    simp
  norm_num [Matrix.det_fin_two, reducedSineKernel, h1, h2, Real.sinc_neg]

/-- For unit-bounded one-feature mass on the whole line, the local trace deficit
exceeds every number below 3/2 eventually. Pointwise auxiliary convergence is
enough when the auxiliary diagonals are continuous and nonnegative. -/
theorem eventually_trace_deficit_of_one_feature
    (U : ℕ → ℝ → ℝ) (φ : ℕ → ℝ → ℂ)
    (hcont : ∀ j, Continuous (U j)) (hnon : ∀ j x, 0 ≤ U j x)
    (hlim : ∀ x, Tendsto (fun j => U j x) atTop (𝓝 (1 - Real.sinc (Real.pi * x) ^ 2)))
    (hφ : ∀ j, Integrable (fun x => ‖φ j x‖ ^ 2) ∧ (∫ x, ‖φ j x‖ ^ 2) ≤ 1)
    {δ : ℝ} (hδ : δ < 3 / 2) :
    ∀ᶠ j in atTop, δ < (∫ x in (0 : ℝ)..3, U j x) - ∫ x in (0 : ℝ)..3, ‖φ j x‖ ^ 2 := by
  let B := fun j x => min (U j x) 1
  have hB (j : ℕ) : Continuous (B j) := (hcont j).min continuous_const
  have hBlim : Tendsto (fun j => ∫ x in (0 : ℝ)..3, B j x) atTop
      (𝓝 (sineGapMass 3)) := by
    simp only [sineGapMass, intervalIntegral.integral_of_le (by norm_num : (0 : ℝ) ≤ 3)]
    apply tendsto_integral_of_dominated_convergence (fun _ : ℝ => (1 : ℝ))
    · exact fun j => (hB j).aestronglyMeasurable
    · exact integrable_const _
    · intro j
      exact ae_of_all _ fun x => by
        rw [Real.norm_eq_abs, abs_of_nonneg (le_min (hnon j x) zero_le_one)]
        exact min_le_right _ _
    · apply ae_of_all _
      intro x
      have h := (hlim x).min (tendsto_const_nhds (x := (1 : ℝ)))
      simpa [B, min_eq_left (show 1 - Real.sinc (Real.pi * x) ^ 2 ≤ 1 by
        linarith only [sq_nonneg (Real.sinc (Real.pi * x))])] using h
  have hlower : δ + 1 < sineGapMass 3 := by
    linarith only [hδ, sineGapMass_lower (by norm_num : (0 : ℝ) ≤ 3)]
  filter_upwards [hBlim.eventually_const_lt hlower] with j hj
  have hBU : (∫ x in (0 : ℝ)..3, B j x) ≤ ∫ x in (0 : ℝ)..3, U j x :=
    intervalIntegral.integral_mono_on (by norm_num) ((hB j).intervalIntegrable _ _)
      ((hcont j).intervalIntegrable _ _) (fun x _ => min_le_left _ _)
  have hlocal : (∫ x in (0 : ℝ)..3, ‖φ j x‖ ^ 2) ≤ 1 := by
    rw [intervalIntegral.integral_of_le (by norm_num : (0 : ℝ) ≤ 3)]
    exact (setIntegral_le_integral (hφ j).1 (ae_of_all _ (fun x => sq_nonneg _))).trans (hφ j).2
  linarith only [hj, hBU, hlocal]

/-- The actual auxiliary fixed-center Palm diagonals supply the pointwise limit.
For their trace comparison only continuity, nonnegativity and normalization of
the single legal feature remain in the statement. -/
theorem unfoldedPalm_eventually_trace_deficit_of_one_feature
    (N : ℕ → ℕ) (hN : Tendsto N atTop atTop) (t₀ : ℝ) (φ : ℕ → ℝ → ℂ)
    (hcont : ∀ j, Continuous (fun x => (palmAtOrigin (unfoldedResidueKernel (N j) t₀) x x).re))
    (hnon : ∀ j x, 0 ≤ (palmAtOrigin (unfoldedResidueKernel (N j) t₀) x x).re)
    (hφ : ∀ j, Integrable (fun x => ‖φ j x‖ ^ 2) ∧ (∫ x, ‖φ j x‖ ^ 2) ≤ 1)
    {δ : ℝ} (hδ : δ < 3 / 2) :
    ∀ᶠ j in atTop, δ < (∫ x in (0 : ℝ)..3,
      (palmAtOrigin (unfoldedResidueKernel (N j) t₀) x x).re) -
        ∫ x in (0 : ℝ)..3, ‖φ j x‖ ^ 2 :=
  eventually_trace_deficit_of_one_feature _ _ hcont hnon
    (fun x => (Complex.continuous_re.tendsto _).comp
      (unfoldedResidueKernel_palm_diag_tendsto N hN t₀ x)) hφ hδ

end RiemannResearch.RH.Pareto.ResidueMellin
