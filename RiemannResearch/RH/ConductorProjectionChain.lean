import RiemannResearch.RH.ParetoProgressionTails
import RiemannResearch.RH.IntegratedRamanujanHilbert
import RiemannResearch.RH.ParetoFiniteErrorObstruction
import RiemannResearch.RH.FiniteDilationFamilyGap
import RiemannResearch.Analysis.ExhaustiveProjectionWalk
import RiemannResearch.Analysis.ResidualGainProduct

/-!
# Actual divisor-conductor projection chains

Source: user-provided `RH_Controlled_Conductor_Schur_2026-09-10.md`,
Sections 2 and 7. The spaces are generated by the actual integrated Ramanujan
packets in the complete Pareto Hilbert space. Finite error positivity,
the exact gain recursion, and the cofinal closure criterion are proved.
Nonsummability of the actual relative gains is not asserted.
-/

open Filter
open scoped BigOperators Topology
noncomputable section
namespace RiemannResearch.RH.Pareto.ConductorProjection

def conductors (Q : ℕ) : Finset ℕ := Q.divisors.filter (fun q => 1 < q)

def space (Q : ℕ) : Submodule ℝ ThresholdHilbert :=
  Submodule.span ℝ (Set.range (fun q : conductors Q => ramanujanPacketHilbert q))

instance space_finiteDimensional (Q : ℕ) : FiniteDimensional ℝ (space Q) :=
  FiniteDimensional.span_of_finite ℝ (Set.finite_range _)

theorem space_mono {Q L : ℕ} (hQL : Q ∣ L) (hL : 0 < L) : space Q ≤ space L := by
  apply Submodule.span_mono
  rintro _ ⟨q, rfl⟩
  refine ⟨⟨q.val, ?_⟩, rfl⟩
  obtain ⟨hq, hq1⟩ := Finset.mem_filter.mp q.property
  exact Finset.mem_filter.mpr ⟨Nat.mem_divisors.mpr
    ⟨dvd_trans (Nat.dvd_of_mem_divisors hq) hQL, hL.ne'⟩, hq1⟩

theorem coordinate_zero {Q k : ℕ} (hQk : Q ∣ k)
    {f : ThresholdHilbert} (hf : f ∈ space Q) : hilbertSequence f k = 0 := by
  induction hf using Submodule.span_induction with
  | mem f hf =>
    obtain ⟨q, rfl⟩ := hf
    rw [hilbertSequence_ramanujanPacketHilbert]
    exact ramanujanPacket_eq_zero_of_dvd
      (dvd_trans (Nat.dvd_of_mem_divisors (Finset.mem_filter.mp q.property).1) hQk)
  | zero => cases k <;> simp [hilbertSequence]
  | add f g hf hg ihf ihg =>
    have he := congrFun (hilbertSequenceLinear.map_add f g) k
    change hilbertSequence (f+g) k = hilbertSequence f k + hilbertSequence g k at he
    rw [he, ihf, ihg, add_zero]
  | smul a f hf ih =>
    have he := congrFun (hilbertSequenceLinear.map_smul a f) k
    change hilbertSequence (a • f) k = a * hilbertSequence f k at he
    rw [he, ih, mul_zero]

def residual (Q : ℕ) : ThresholdHilbert :=
  hilbertOne - (space Q).starProjection hilbertOne

def energy (Q : ℕ) : ℝ := ‖residual Q‖ ^ 2

theorem energy_atom_floor (Q : ℕ) (hQ : 0 < Q) : positiveWeight Q ≤ energy Q := by
  apply hilbert_error_lower_of_zero_coordinate _ Q hQ
  exact coordinate_zero (dvd_refl Q) ((space Q).starProjection_apply_mem _)

theorem energy_pos (Q : ℕ) (hQ : 0 < Q) : 0 < energy Q := by
  have hw : 0 < positiveWeight Q := by unfold positiveWeight; positivity
  exact hw.trans_le (energy_atom_floor Q hQ)

def gain (Q L : ℕ) : ℝ :=
  ‖(space L).starProjection hilbertOne - (space Q).starProjection hilbertOne‖ ^ 2

theorem energy_step {Q L : ℕ} (hQL : Q ∣ L) (hL : 0 < L) :
    energy Q = energy L + gain Q L :=
  Analysis.ExhaustiveWalk.nested_projection_energy (space Q) (space L)
    (space_mono hQL hL) hilbertOne

def relativeGain (Q L : ℕ) : ℝ := gain Q L / energy Q

theorem relativeGain_nonneg (Q L : ℕ) : 0 ≤ relativeGain Q L :=
  div_nonneg (sq_nonneg _) (sq_nonneg _)

theorem relativeGain_lt_one {Q L : ℕ} (hQ : 0 < Q) (hL : 0 < L)
    (hQL : Q ∣ L) : relativeGain Q L < 1 := by
  apply (div_lt_one (energy_pos Q hQ)).mpr
  have he := energy_step hQL hL
  linarith [energy_pos L hL]

theorem energy_recurrence {Q L : ℕ} (hQ : 0 < Q) (hL : 0 < L)
    (hQL : Q ∣ L) : energy L = energy Q * (1 - relativeGain Q L) := by
  have he := energy_step hQL hL
  unfold relativeGain
  field_simp [ne_of_gt (energy_pos Q hQ)]
  nlinarith

/-- The cumulative-gain criterion for the actual conductor projections.
No normal equations, inversion, or positivity provider is assumed. -/
theorem energy_tendsto_zero_iff_gain_not_summable (Q : ℕ → ℕ)
    (hQ : ∀ n, 0 < Q n) (hstep : ∀ n, Q n ∣ Q (n+1)) :
    Tendsto (fun n => energy (Q n)) atTop (𝓝 0) ↔
      ¬Summable (fun n => relativeGain (Q n) (Q (n+1))) :=
  Analysis.ResidualGain.residual_tendsto_zero_iff_not_summable
    (energy_pos (Q 0) (hQ 0)) (fun n => relativeGain_nonneg _ _)
    (fun n => relativeGain_lt_one (hQ n) (hQ (n+1)) (hstep n))
    (fun n => energy_recurrence (hQ n) (hQ (n+1)) (hstep n))

def fullPacketSpace : Submodule ℝ ThresholdHilbert :=
  Submodule.span ℝ {f | ∃ q : ℕ, 1 < q ∧ f = ramanujanPacketHilbert q}

theorem space_le_full (Q : ℕ) : space Q ≤ fullPacketSpace := by
  apply Submodule.span_le.mpr
  rintro _ ⟨q, rfl⟩
  exact Submodule.subset_span ⟨q.val, (Finset.mem_filter.mp q.property).2, rfl⟩

theorem iSup_space_eq_full (Q : ℕ → ℕ) (hQ : ∀ n, 0 < Q n)
    (hcofinal : ∀ q : ℕ, 0 < q → ∃ n, q ∣ Q n) :
    (⨆ n, space (Q n)) = fullPacketSpace := by
  apply le_antisymm
  · exact iSup_le (fun n => space_le_full (Q n))
  · apply Submodule.span_le.mpr
    rintro _ ⟨q, hq, rfl⟩
    obtain ⟨n, hn⟩ := hcofinal q (by omega)
    apply (le_iSup (fun n => space (Q n)) n)
    apply Submodule.subset_span
    exact ⟨⟨q, Finset.mem_filter.mpr
      ⟨Nat.mem_divisors.mpr ⟨hn, (hQ n).ne'⟩, hq⟩⟩, rfl⟩

/-- Cofinality identifies exactly which closure is exhausted. It does not
assert that the constant target belongs to that closure. -/
theorem energy_tendsto_zero_iff_mem_closure (Q : ℕ → ℕ)
    (hQ : ∀ n, 0 < Q n) (hmono : ∀ m n, m ≤ n → Q m ∣ Q n)
    (hcofinal : ∀ q : ℕ, 0 < q → ∃ n, q ∣ Q n) :
    Tendsto (fun n => energy (Q n)) atTop (𝓝 0) ↔
      hilbertOne ∈ fullPacketSpace.topologicalClosure := by
  have hm : Monotone (fun n => space (Q n)) :=
    fun m n hmn => space_mono (hmono m n hmn) (hQ n)
  have hp := Submodule.starProjection_tendsto_closure_iSup
    (fun n => space (Q n)) hm hilbertOne
  rw [iSup_space_eq_full Q hQ hcofinal] at hp
  have he : Tendsto (fun n => energy (Q n)) atTop
      (𝓝 (‖hilbertOne - fullPacketSpace.topologicalClosure.starProjection hilbertOne‖^2)) :=
    (tendsto_const_nhds.sub hp).norm.pow 2
  have hz : ‖hilbertOne - fullPacketSpace.topologicalClosure.starProjection hilbertOne‖^2 = 0 ↔
      hilbertOne ∈ fullPacketSpace.topologicalClosure := by
    rw [sq_eq_zero_iff, norm_eq_zero, sub_eq_zero, eq_comm,
      Submodule.starProjection_eq_self_iff]
  constructor
  · intro h
    exact hz.mp (tendsto_nhds_unique he h)
  · intro h
    simpa only [hz.mpr h, energy, residual] using he



/-- The complete mass of the zero residue class is an unavoidable error at
fixed conductor, not merely the single-coordinate mass `positiveWeight Q`. -/
theorem energy_progression_floor (Q : ℕ) (hQ : 0 < Q) :
    progressionWeight Q Q ≤ energy Q := by
  have hcoordinate (j : ℕ) :
      hilbertSequence (residual Q) (Q + Q * j) = 1 := by
    have hk : 0 < Q + Q * j := Nat.add_pos_left hQ _
    have hz : hilbertSequence ((space Q).starProjection hilbertOne)
        (Q + Q * j) = 0 :=
      coordinate_zero (dvd_add (dvd_refl Q) (dvd_mul_right Q j))
        ((space Q).starProjection_apply_mem _)
    simp [residual, hilbertSequence_sub, hilbertOne_sequence, zeroAnchor, hQ.ne', hz]
  have hinj : Function.Injective (fun j : ℕ => Q + Q * j) := by
    intro i j hij
    exact Nat.eq_of_mul_eq_mul_left hQ (Nat.add_left_cancel hij)
  rw [energy, hilbert_norm_weighted_sq]
  change (∑' j, positiveWeight (Q + Q * j)) ≤ _
  apply (progressionWeight_summable Q Q hQ).tsum_le_of_sum_range_le
  intro N
  have hinjN : Set.InjOn (fun j : ℕ => Q + Q * j) (Finset.range N : Set ℕ) :=
    hinj.injOn
  calc
    (∑ j ∈ Finset.range N, positiveWeight (Q + Q * j)) =
        ∑ k ∈ (Finset.range N).image (fun j => Q + Q * j),
          positiveWeight k * (hilbertSequence (residual Q) k) ^ 2 := by
      rw [Finset.sum_image hinjN]
      apply Finset.sum_congr rfl
      intro j _
      rw [hcoordinate j]
      simp
    _ ≤ ∑' k, positiveWeight k * (hilbertSequence (residual Q) k) ^ 2 :=
      (hilbertSequence_square_summable (residual Q)).sum_le_tsum _
        (fun k _ => mul_nonneg (positiveWeight_nonneg k) (sq_nonneg _))

end RiemannResearch.RH.Pareto.ConductorProjection

namespace RiemannResearch.RH.Pareto.ConductorProjection
open Filter
open scoped BigOperators Topology

/-- Every actual finite conductor gain is retained in the additive accounting. -/
theorem energy_chain_telescoping (Q : ℕ → ℕ) (hQ : ∀ n, 0 < Q n)
    (hstep : ∀ n, Q n ∣ Q (n+1)) (n : ℕ) :
    energy (Q n) = energy (Q 0) - ∑ i ∈ Finset.range n, gain (Q i) (Q (i+1)) := by
  induction n with
  | zero => simp
  | succ n ih =>
    rw [Finset.sum_range_succ]
    have he := energy_step (hstep n) (hQ (n+1))
    linarith

/-- The exact survival product for the actual full Pareto projection errors. -/
theorem energy_chain_product (Q : ℕ → ℕ) (hQ : ∀ n, 0 < Q n)
    (hstep : ∀ n, Q n ∣ Q (n+1)) (n : ℕ) :
    energy (Q n) = energy (Q 0) *
      ∏ i ∈ Finset.range n, (1 - relativeGain (Q i) (Q (i+1))) :=
  Analysis.ResidualGain.recurrence_eq_mul_product
    (d := fun i => energy (Q i))
    (r := fun i => relativeGain (Q i) (Q (i+1)))
    (fun i => energy_recurrence (hQ i) (hQ (i+1)) (hstep i)) n

/-- The logarithmic divergence criterion for the actual arithmetic gains. -/
theorem energy_tendsto_zero_iff_log_sum (Q : ℕ → ℕ) (hQ : ∀ n, 0 < Q n)
    (hstep : ∀ n, Q n ∣ Q (n+1)) :
    Tendsto (fun n => energy (Q n)) atTop (𝓝 0) ↔
      Tendsto (fun N => ∑ i ∈ Finset.range N,
        -Real.log (1 - relativeGain (Q i) (Q (i+1)))) atTop atTop :=
  (energy_tendsto_zero_iff_gain_not_summable Q hQ hstep).trans
    ((not_summable_iff_tendsto_nat_atTop_of_nonneg
      (fun i => relativeGain_nonneg (Q i) (Q (i+1)))).trans
      (Analysis.ResidualGain.log_gain_sum_tendsto_atTop_iff
        (fun i => relativeGain_nonneg (Q i) (Q (i+1)))
        (fun i => relativeGain_lt_one (hQ i) (hQ (i+1)) (hstep i))).symm)

end RiemannResearch.RH.Pareto.ConductorProjection
