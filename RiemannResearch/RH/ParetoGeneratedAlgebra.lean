import RiemannResearch.RH.ThresholdDilationAlgebra
import RiemannResearch.RH.ParetoPeriodicRegrouping
import RiemannResearch.RH.ParetoLegalStructure
import RiemannResearch.RH.ParetoProgressionTaylor
import Mathlib.Analysis.SpecificLimits.Basic

/-!
# The nonunital algebra generated by the legal two-seed family

The closure below inserts no constant function. Nevertheless binary OR polynomials
belong to it and converge to one in the genuine Pareto squared norm. These are
algebra approximants, not legal linear approximants; no RH conclusion follows.
-/

open scoped BigOperators
open Filter

namespace RiemannResearch.RH.Pareto
noncomputable section

/-- Finite closure of the actual legal span under addition, real scaling and
pointwise multiplication. There is deliberately no constructor for the unit. -/
inductive InNonunitalSeedAlgebra (A : Set ℕ) : (ℕ → ℝ) → Prop
  | of_legal {f} : f ∈ legalSeedSpan A → InNonunitalSeedAlgebra A f
  | add {f g} : InNonunitalSeedAlgebra A f → InNonunitalSeedAlgebra A g →
      InNonunitalSeedAlgebra A (f + g)
  | smul (c : ℝ) {f} : InNonunitalSeedAlgebra A f →
      InNonunitalSeedAlgebra A (c • f)
  | mul {f g} : InNonunitalSeedAlgebra A f → InNonunitalSeedAlgebra A g →
      InNonunitalSeedAlgebra A (f * g)

theorem InNonunitalSeedAlgebra.sub {A : Set ℕ} {f g : ℕ → ℝ}
    (hf : InNonunitalSeedAlgebra A f) (hg : InNonunitalSeedAlgebra A g) :
    InNonunitalSeedAlgebra A (f - g) := by
  simpa only [neg_one_smul, sub_eq_add_neg] using
    hf.add (InNonunitalSeedAlgebra.smul (-1) hg)

/-- The missing unit is genuine: every finite algebra expression is zero at zero. -/
theorem InNonunitalSeedAlgebra.zero_value {A : Set ℕ} {f : ℕ → ℝ}
    (hf : InNonunitalSeedAlgebra A f) : f 0 = 0 := by
  induction hf with
  | of_legal hf => exact legalSeedSpan_zero_value A hf
  | add hf hg ihf ihg => simp [ihf, ihg]
  | smul c hf ih => simp [ih]
  | mul hf hg ihf ihg => simp [ihf, ihg]

theorem one_not_inNonunitalSeedAlgebra (A : Set ℕ) :
    ¬ InNonunitalSeedAlgebra A (1 : ℕ → ℝ) := by
  intro h
  have hz := h.zero_value
  norm_num at hz

/-- The `j`th binary digit, itself a scaled legal dilation of the seed 2. -/
def binaryDigit (j n : ℕ) : ℝ := ((n / 2 ^ j) % 2 : ℕ)

theorem binaryDigit_mem_legalSeedSpan (j : ℕ) :
    binaryDigit j ∈ legalSeedSpan ({2, 3} : Set ℕ) := by
  have hmem := (legalSeedSpan ({2, 3} : Set ℕ)).smul_mem
    (1 / ((2 ^ j : ℕ) : ℝ))
    (dilation_generator_mem ({2, 3} : Set ℕ) (a := 2) (m := 2 ^ j)
      (by simp) (by positivity))
  have heq : (1 / ((2 ^ j : ℕ) : ℝ)) • dilation (2 ^ j) (residue 2) =
      binaryDigit j := by
    funext n
    have hpow : ((2 ^ j : ℕ) : ℝ) ≠ 0 := by positivity
    simp only [Pi.smul_apply, smul_eq_mul, dilation, residue, binaryDigit]
    field_simp [hpow]
  rwa [heq] at hmem

theorem binaryDigit_zero_or_one (j n : ℕ) :
    binaryDigit j n = 0 ∨ binaryDigit j n = 1 := by
  have hm := Nat.mod_lt (n / 2 ^ j) (by decide : 0 < 2)
  have hh : (n / 2 ^ j) % 2 = 0 ∨ (n / 2 ^ j) % 2 = 1 := by omega
  rcases hh with hh | hh <;> simp [binaryDigit, hh]

/-- OR is synthesized using only addition, subtraction and multiplication. -/
def binaryOr : ℕ → ℕ → ℝ
  | 0 => 0
  | K + 1 => binaryOr K + binaryDigit K - binaryOr K * binaryDigit K

theorem binaryOr_inNonunitalSeedAlgebra (K : ℕ) :
    InNonunitalSeedAlgebra ({2, 3} : Set ℕ) (binaryOr K) := by
  induction K with
  | zero => exact .of_legal (Submodule.zero_mem _)
  | succ K ih =>
    have hb : InNonunitalSeedAlgebra ({2, 3} : Set ℕ) (binaryDigit K) :=
      .of_legal (binaryDigit_mem_legalSeedSpan K)
    exact (ih.add hb).sub (ih.mul hb)

/-- The apparent constant term cancels in the OR polynomial. -/
theorem binaryOr_eq_one_sub_prod (K n : ℕ) :
    binaryOr K n = 1 - ∏ j ∈ Finset.range K, (1 - binaryDigit j n) := by
  induction K with
  | zero => simp [binaryOr]
  | succ K ih =>
    simp only [binaryOr, Pi.sub_apply, Pi.add_apply, Pi.mul_apply,
      Finset.prod_range_succ, ih]
    ring

/-- The zero set of the OR polynomial is the complete divisibility class. -/
theorem binaryOr_eq_indicator (K n : ℕ) :
    binaryOr K n = if n % 2 ^ K = 0 then 0 else 1 := by
  induction K with
  | zero => simp [binaryOr, Nat.mod_one]
  | succ K ih =>
    have hp : 2 ^ K ≠ (0 : ℕ) := by positivity
    have hz : n % (2 ^ K * 2) = 0 ↔
        n % 2 ^ K = 0 ∧ (n / 2 ^ K) % 2 = 0 := by
      rw [Nat.mod_mul, Nat.add_eq_zero_iff]
      simp [hp]
    have hm := Nat.mod_lt (n / 2 ^ K) (by decide : 0 < 2)
    by_cases ha : n % 2 ^ K = 0 <;>
      by_cases hb : (n / 2 ^ K) % 2 = 0
    · have hc : n % (2 ^ K * 2) = 0 := hz.mpr ⟨ha, hb⟩
      simp [binaryOr, ih, binaryDigit, ha, hb, pow_succ, hc]
    · have hc : n % (2 ^ K * 2) ≠ 0 := by simp [hz, hb]
      have hb1 : (n / 2 ^ K) % 2 = 1 := by omega
      simp [binaryOr, ih, binaryDigit, ha, hb1, pow_succ, hc]
    · have hc : n % (2 ^ K * 2) ≠ 0 := by simp [hz, ha]
      simp [binaryOr, ih, binaryDigit, ha, hb, pow_succ, hc]
    · have hc : n % (2 ^ K * 2) ≠ 0 := by simp [hz, ha]
      have hb1 : (n / 2 ^ K) % 2 = 1 := by omega
      simp [binaryOr, ih, binaryDigit, ha, hb1, pow_succ, hc]

theorem binaryOr_eq_one_sub_divisibility (K n : ℕ) :
    binaryOr K n = 1 - if 2 ^ K ∣ n then (1 : ℝ) else 0 := by
  rw [binaryOr_eq_indicator]
  by_cases hn : 2 ^ K ∣ n
  · simp [hn, Nat.mod_eq_zero_of_dvd hn]
  · have hm : n % 2 ^ K ≠ 0 := fun h => hn (Nat.dvd_of_mod_eq_zero h)
    simp [hn, hm]

private theorem sub_small_mod_ne_zero {q Q b : ℕ}
    (hdiv : q ∣ Q) (hb : 0 < b) (hbq : b < q) (hbQ : b ≤ Q) :
    (Q - b) % q ≠ 0 := by
  intro hz
  have he := congrArg (fun n : ℕ => n % q) (Nat.sub_add_cancel hbQ)
  simp only [Nat.add_mod, hz, Nat.mod_eq_zero_of_dvd hdiv,
    Nat.mod_eq_of_lt hbq, zero_add] at he
  omega

/-- At least two binary digits give an algebra approximant violating the
reflection invariant of every finite legal span built from positive seeds. -/
theorem binaryOr_not_mem_legalSeedSpan (A : Set ℕ)
    (hA : ∀ a ∈ A, 0 < a) (K : ℕ) (hK : 2 ≤ K) :
    binaryOr K ∉ legalSeedSpan A := by
  intro hf
  obtain ⟨d, hd, href⟩ := legalSeedSpan_hasLegalReflectionPeriod A hA hf
  have hq : 4 ≤ 2 ^ K := by
    obtain ⟨J, rfl⟩ := Nat.exists_eq_add_of_le hK
    have hp : 0 < (2 ^ J : ℕ) := by positivity
    rw [pow_add]
    norm_num
    omega
  have hQ : 2 ^ K ≤ d * 2 ^ K := Nat.le_mul_of_pos_left (2 ^ K) hd
  have hdiv : 2 ^ K ∣ d * 2 ^ K := dvd_mul_left (2 ^ K) d
  have hfirst : 1 % 2 ^ K ≠ 0 := by
    rw [Nat.mod_eq_of_lt (by omega : 1 < 2 ^ K)]
    decide
  have hlast : (d * 2 ^ K - 1) % 2 ^ K ≠ 0 :=
    sub_small_mod_ne_zero hdiv (by omega) (by omega) (by omega)
  have hprev : (d * 2 ^ K - 1 - 1) % 2 ^ K ≠ 0 := by
    rw [show d * 2 ^ K - 1 - 1 = d * 2 ^ K - 2 by omega]
    exact sub_small_mod_ne_zero hdiv (by omega) (by omega) (by omega)
  have hr := (href (d * 2 ^ K) (dvd_mul_right d (2 ^ K))).2 1 (by omega)
  norm_num [binaryOr_eq_indicator, hfirst, hlast, hprev] at hr

/-- The complete Pareto error, including all positive multiples of the period. -/
theorem binaryOr_error_eq_progressionWeight (K : ℕ) :
    paretoInner (1 - binaryOr K) (1 - binaryOr K) =
      progressionWeight (2 ^ K) (2 ^ K) := by
  let Q := 2 ^ K
  have hQ : 0 < Q := by dsimp [Q]; positivity
  have hb : ∀ n, |(1 - binaryOr K) n| ≤ (1 : ℝ) := by
    intro n
    simp only [Pi.sub_apply, Pi.one_apply, binaryOr_eq_indicator]
    split_ifs <;> norm_num
  have hp : ∀ n, (1 - binaryOr K) (n + Q) = (1 - binaryOr K) n := by
    intro n
    simp [binaryOr_eq_indicator, Q, Nat.add_mod]
  rw [periodic_paretoInner Q hQ (1 - binaryOr K) hb hp]
  let last : Fin Q := ⟨Q - 1, by omega⟩
  have hlast : last.val + 1 = Q := by dsimp [last]; omega
  calc
    _ = progressionWeight Q (last.val + 1) *
        ((1 - binaryOr K) (last.val + 1)) ^ 2 := by
      apply Finset.sum_eq_single last
      · intro r _ hr
        have hlt : r.val + 1 < Q := by
          have hneq : r.val ≠ last.val := fun h => hr (Fin.ext h)
          dsimp [last] at hneq
          have := r.isLt
          omega
        have hne : r.val + 1 ≠ 0 := by omega
        have hmod : (r.val + 1) % 2 ^ K = r.val + 1 := Nat.mod_eq_of_lt hlt
        simp [binaryOr_eq_indicator, hmod, hne]
      · simp
    _ = _ := by simp [hlast, binaryOr_eq_indicator, Q]

/-- A geometric bound on algebra approximation, obtained from an elementary
certified bound for the full progression mass. -/
theorem binaryOr_error_le (K : ℕ) :
    paretoInner (1 - binaryOr K) (1 - binaryOr K) ≤
      2 / (((2 ^ K : ℕ) : ℝ) ^ 2) := by
  rw [binaryOr_error_eq_progressionWeight]
  have hp : 0 < (2 ^ K : ℕ) := by positivity
  have hr : 0 < ((2 ^ K : ℕ) : ℝ) := by positivity
  have hb := progressionWeight_upper_one (2 ^ K) (2 ^ K) hp
  unfold positiveWeight at hb
  calc
    _ ≤ 1 / (((2 ^ K : ℕ) : ℝ) * (((2 ^ K : ℕ) : ℝ) + 1)) +
        1 / (((2 ^ K : ℕ) : ℝ) * (((2 ^ K : ℕ) : ℝ) + 1)) := hb
    _ = 2 / (((2 ^ K : ℕ) : ℝ) * (((2 ^ K : ℕ) : ℝ) + 1)) := by ring
    _ ≤ _ := by
      apply div_le_div_of_nonneg_left (by norm_num) (by positivity)
      nlinarith

/-- The sharper Basel bound for the same complete algebra approximation error. -/
theorem binaryOr_error_le_basel (K : ℕ) :
    paretoInner (1 - binaryOr K) (1 - binaryOr K) ≤
      Real.pi ^ 2 / (6 * (((2 ^ K : ℕ) : ℝ) ^ 2)) := by
  rw [binaryOr_error_eq_progressionWeight]
  have hp : 0 < (2 ^ K : ℕ) := by positivity
  have hb := (progressionWeight_head_basel_bounds (2 ^ K) 0 hp).2
  rw [progressionWeight_split (2 ^ K) 0 hp] at hb
  simpa only [Nat.zero_add, add_sub_cancel_left] using hb

/-- Pointwise multiplication removes the difficulty of approximating one;
this limit concerns the generated algebra and asserts no legal linear recovery. -/
theorem binaryOr_error_tendsto_zero :
    Tendsto (fun K => paretoInner (1 - binaryOr K) (1 - binaryOr K))
      atTop (nhds 0) := by
  have ht : Tendsto (fun K : ℕ => (1 / 4 : ℝ) ^ K) atTop (nhds 0) :=
    tendsto_pow_atTop_nhds_zero_of_lt_one (by norm_num) (by norm_num)
  have hd (K : ℕ) : (((2 ^ K : ℕ) : ℝ) ^ 2) = (4 : ℝ) ^ K := by
    push_cast
    rw [← pow_mul, Nat.mul_comm K 2, pow_mul]
    norm_num
  have hu : Tendsto (fun K : ℕ => 2 / (((2 ^ K : ℕ) : ℝ) ^ 2))
      atTop (nhds 0) := by
    simp_rw [hd]
    simpa [div_eq_mul_inv, inv_pow] using ht.const_mul 2
  apply squeeze_zero (fun K => ?_) binaryOr_error_le hu
  unfold paretoInner
  exact tsum_nonneg (fun n => mul_nonneg (positiveWeight_nonneg n)
    (mul_self_nonneg _))

end
end RiemannResearch.RH.Pareto
