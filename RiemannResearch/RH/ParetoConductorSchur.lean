import RiemannResearch.RH.ParetoConductorHilbert
import RiemannResearch.RH.ParetoNewPacketPeriodicity
import RiemannResearch.LinearAlgebra.ConditionalSchurDecomposition

/-!
# The exact Schur decomposition for the actual full-weight conductor model

Source: user-provided `RH_Controlled_Conductor_Schur_2026-09-10.md`, §§2--4.
The old legal space, full coarse function space, and constant target are
constructed from actual weighted packet samples. All projection and
orthogonality assumptions of the general Schur identities are discharged.
The corresponding Gram entries are complete infinite Pareto inner products
by `conductorHilbert_inner`. No all-scale gain bound is claimed.
-/
namespace RiemannResearch.RH.Pareto
open RiemannResearch.LinearAlgebra.WeightedQuotientHilbert
open RiemannResearch.LinearAlgebra.ConditionalSchur
noncomputable section

/-- An actual old-periodic function belongs to the full coarse Hilbert subspace. -/
theorem conductorHilbert_mem_coarse_of_periodic (N b : ℕ) (hN : 0 < N)
    (f : ℕ → ℝ) (hp : ∀ k, f (k+N) = f k) :
    conductorHilbert N b f ∈
      coarseSpace (conductorQuotient N b hN) (conductorFineWeight N b) := by
  refine ⟨fun r : Fin N => f (r.val+1), ?_⟩
  change coordinates (conductorFineWeight N b)
      ((fun r : Fin N => f (r.val+1)) ∘ conductorQuotient N b hN) =
    coordinates (conductorFineWeight N b) (conductorSample N b f)
  apply congrArg (coordinates (conductorFineWeight N b))
  funext i
  change f (i.val % N + 1) = f (i.val + 1)
  have hi : i.val+1 = (i.val % N + 1) + N*(i.val/N) := by
    have h := Nat.mod_add_div i.val N
    omega
  rw [hi, periodic_add_mul N f hp]

/-- The complete finite old legal space is generated by its actual divisor packets. -/
def conductorOldSpace (N b : ℕ) : Submodule ℝ (EuclideanSpace ℝ (Fin (N*b))) :=
  Submodule.span ℝ ((fun q => conductorHilbert N b (ramanujanPacket q)) ''
    {q : ℕ | q ∣ N ∧ 1 < q})

/-- Every old legal packet lies in the actual full coarse function space. -/
theorem conductorOldSpace_le_coarse (N b : ℕ) (hN : 0 < N) :
    conductorOldSpace N b ≤
      coarseSpace (conductorQuotient N b hN) (conductorFineWeight N b) := by
  apply Submodule.span_le.2
  rintro _ ⟨q, hq, rfl⟩
  exact conductorHilbert_mem_coarse_of_periodic N b hN (ramanujanPacket q)
    (ramanujanPacket_period_of_dvd q N hq.1)

/-- The target is genuinely coarse; there is no erroneous periodicity at coordinate zero. -/
theorem conductorHilbert_one_mem_coarse (N b : ℕ) (hN : 0 < N) :
    conductorHilbert N b (fun _ => (1 : ℝ)) ∈
      coarseSpace (conductorQuotient N b hN) (conductorFineWeight N b) :=
  conductorHilbert_mem_coarse_of_periodic N b hN (fun _ => (1 : ℝ)) (fun _ => rfl)

/-- Every exact signed Schur entry splits into the actual mean and fluctuation entries. -/
theorem conductor_schur_gram_split (N b : ℕ) (hN : 0 < N)
    (f g : ℕ → ℝ) :
    inner ℝ (packetResidual (conductorOldSpace N b) (conductorHilbert N b f))
      (packetResidual (conductorOldSpace N b) (conductorHilbert N b g)) =
      inner ℝ
        (meanPart (conductorOldSpace N b)
          (coarseSpace (conductorQuotient N b hN) (conductorFineWeight N b))
          (conductorHilbert N b f))
        (meanPart (conductorOldSpace N b)
          (coarseSpace (conductorQuotient N b hN) (conductorFineWeight N b))
          (conductorHilbert N b g)) +
      inner ℝ
        (fluctuation (coarseSpace (conductorQuotient N b hN) (conductorFineWeight N b))
          (conductorHilbert N b f))
        (fluctuation (coarseSpace (conductorQuotient N b hN) (conductorFineWeight N b))
          (conductorHilbert N b g)) := by
  exact gram_split _ _ (conductorOldSpace_le_coarse N b hN) _ _

/-- The actual old residual belongs to the complete coarse function space. -/
theorem conductor_residual_mem_coarse (N b : ℕ) (hN : 0 < N) :
    packetResidual (conductorOldSpace N b) (conductorHilbert N b (fun _ => (1 : ℝ))) ∈
      coarseSpace (conductorQuotient N b hN) (conductorFineWeight N b) :=
  target_residual_mem _ _ (conductorOldSpace_le_coarse N b hN)
    (conductorHilbert_one_mem_coarse N b hN)

/-- Equation (3.6)/(1.1) for the actual old legal residual and any sampled new combination. -/
theorem conductor_schur_objective (N b : ℕ) (hN : 0 < N) (f : ℕ → ℝ) :
    ‖packetResidual (conductorOldSpace N b) (conductorHilbert N b (fun _ => (1 : ℝ))) -
      packetResidual (conductorOldSpace N b) (conductorHilbert N b f)‖^2 =
      ‖packetResidual (conductorOldSpace N b) (conductorHilbert N b (fun _ => (1 : ℝ))) -
        meanPart (conductorOldSpace N b)
          (coarseSpace (conductorQuotient N b hN) (conductorFineWeight N b))
          (conductorHilbert N b f)‖^2 +
      ‖fluctuation (coarseSpace (conductorQuotient N b hN) (conductorFineWeight N b))
        (conductorHilbert N b f)‖^2 := by
  exact residual_objective _ _ (conductorOldSpace_le_coarse N b hN)
    (conductor_residual_mem_coarse N b hN) _

/-- The actual marked score only sees the weighted mean of each new packet. -/
theorem conductor_schur_score (N b : ℕ) (hN : 0 < N) (f : ℕ → ℝ) :
    inner ℝ (packetResidual (conductorOldSpace N b) (conductorHilbert N b f))
      (packetResidual (conductorOldSpace N b) (conductorHilbert N b (fun _ => (1 : ℝ)))) =
      inner ℝ (meanPart (conductorOldSpace N b)
        (coarseSpace (conductorQuotient N b hN) (conductorFineWeight N b))
        (conductorHilbert N b f))
      (packetResidual (conductorOldSpace N b) (conductorHilbert N b (fun _ => (1 : ℝ)))) := by
  exact score_eq_mean_score _ _ (conductorOldSpace_le_coarse N b hN)
    (conductor_residual_mem_coarse N b hN) _

end
end RiemannResearch.RH.Pareto
