/-! # Dyadic dilation and the first physical site in Mellin determinants

The normalized dyadic dilation multiplies every critical-line Mellin feature by
the same unimodular function of frequency. Its finite projection determinants
therefore agree for every frequency tuple, including repeated ordinates. The
original and dilated legal spaces have different first physical site marginals.
For the sine-process correlation convention see Arias de Reyna and Rodgers,
https://arxiv.org/abs/2311.13441, Section 5.
-/

noncomputable section
open scoped BigOperators
namespace RiemannResearch.RH.Pareto.MellinFrequency
open CoefficientStabilization CoefficientStabilization.TailCapacity IntegerDPP HistoricalTargets

/-- Critical-line factor of normalized dyadic dilation. -/
def dyadicMellinPhase (t : ℝ) : ℂ :=
  ((1 / Real.sqrt 2 : ℝ) : ℂ) * (2 : ℂ) ^ (1 - criticalPoint t)

private theorem dyadicMellinPhase_norm (t : ℝ) : ‖dyadicMellinPhase t‖ = 1 := by
  have hc := Complex.norm_cpow_eq_rpow_re_of_pos (by norm_num : (0 : ℝ) < 2)
    (1 - criticalPoint t)
  have hs : 0 < Real.sqrt 2 := Real.sqrt_pos.mpr (by norm_num)
  have hp : (1 - criticalPoint t).re = 1 / 2 := by
    rw [Complex.sub_re, Complex.one_re, criticalPoint_re]
    norm_num
  rw [dyadicMellinPhase, norm_mul, Complex.norm_real, Real.norm_eq_abs,
    abs_of_pos (div_pos zero_lt_one hs)]
  rw [show ‖(2 : ℂ) ^ (1 - criticalPoint t)‖ = (2 : ℝ) ^ (1 / 2 : ℝ) by
    simpa only [Complex.ofReal_ofNat, hp] using hc, ← Real.sqrt_eq_rpow]
  field_simp [hs.ne']

theorem mellin_normalized_double (f : ThresholdHilbert) (t : ℝ) :
    paretoMellin (hilbertNormalizedDilation 2 (by decide) f) (criticalPoint t) =
      dyadicMellinPhase t * paretoMellin f (criticalPoint t) := by
  change paretoMellin ((1 / Real.sqrt 2 : ℝ) • hilbertDilation 2 (by decide) f) _ = _
  rw [paretoMellin_smul, paretoMellin_dilation]
  simp only [dyadicMellinPhase, Nat.cast_ofNat, Complex.real_smul, mul_assoc]

theorem normalized_double_modes_orthonormal :
    Orthonormal ℝ (fun j : ℕ => hilbertNormalizedDilation 2 (by decide) (residueMode j)) :=
  (hilbertNormalizedDilation 2 (by decide)).orthonormal_comp_iff.mpr residueMode_orthonormal

/-- Projection kernel for the orthonormal images of the original finite modes. -/
def doubledModeKernel (n : ℕ) (t u : ℝ) : ℂ :=
  ∑ j : Fin n, paretoMellin (hilbertNormalizedDilation 2 (by decide) (residueMode j))
    (criticalPoint t) * star (paretoMellin
    (hilbertNormalizedDilation 2 (by decide) (residueMode j)) (criticalPoint u))

private theorem doubledModeKernel_eq (n : ℕ) (t u : ℝ) :
    doubledModeKernel n t u =
      dyadicMellinPhase t * (star (dyadicMellinPhase u) * kernel n t u) := by
  rw [doubledModeKernel, kernel_eq_mode_sum]
  simp only [mellin_normalized_double, star_mul, Finset.mul_sum, modeFeature]
  apply Finset.sum_congr rfl
  intro j _
  ring

/-- All correlation determinants agree on exactly the same frequency tuple. -/
theorem doubledModeKernel_det_eq {ι : Type*} [Fintype ι] [DecidableEq ι]
    (n : ℕ) (t : ι → ℝ) :
    Matrix.det (fun i j => doubledModeKernel n (t i) (t j)) =
      Matrix.det (fun i j => kernel n (t i) (t j)) := by
  let a (i : ι) := dyadicMellinPhase (t i)
  let b (i : ι) := star (a i)
  let A : Matrix ι ι ℂ := fun i j => kernel n (t i) (t j)
  have hab (i : ι) : a i * b i = 1 := by
    change dyadicMellinPhase (t i) * (starRingEnd ℂ) (dyadicMellinPhase (t i)) = 1
    rw [Complex.mul_conj, Complex.normSq_eq_norm_sq, dyadicMellinPhase_norm]
    norm_num
  have he : (fun i j => doubledModeKernel n (t i) (t j)) =
      Matrix.of (fun i j => a i * (Matrix.of (fun i j => b j * A i j)) i j) := by
    funext i j
    exact doubledModeKernel_eq n _ _
  rw [he, Matrix.det_mul_column, Matrix.det_mul_row, ← mul_assoc, ← Finset.prod_mul_distrib]
  simp only [hab, Finset.prod_const_one, one_mul]
  rfl

/-- The closed space generated by the dyadic images of legal vectors. -/
abbrev doubledLegalSpace : Submodule ℝ ThresholdHilbert :=
  (closedSpace.map (hilbertNormalizedDilation 2 (by decide)).toLinearMap).topologicalClosure

theorem doubledLegalSpace_le : doubledLegalSpace ≤ closedSpace := by
  apply Submodule.topologicalClosure_minimal _ ?_ (Submodule.isClosed_topologicalClosure _)
  rintro _ ⟨f, hf, rfl⟩
  change (1 / Real.sqrt 2 : ℝ) • hilbertDilation 2 (by decide) f ∈ closedSpace
  exact closedSpace.smul_mem _ (closedSpace_dilation hf _ _)

private theorem normalized_double_inner_first (f : ThresholdHilbert) :
    inner ℝ (hilbertNormalizedDilation 2 (by decide) f) (countingBasis 0) = 0 := by
  have h := doubleDilation_inner_firstPoint f
  rw [paretoPoint_eq_sqrt_smul_countingBasis, real_inner_smul_right] at h
  have hzero := (mul_eq_zero.mp h).resolve_left ((Real.sqrt_pos.mpr (paretoWeight_pos 0)).ne')
  change inner ℝ ((1 / Real.sqrt 2 : ℝ) • doubleDilation f) (countingBasis 0) = 0
  rw [real_inner_smul_left, hzero, mul_zero]

/-- The first-site marginal of the dyadically dilated legal space is zero. -/
theorem doubledLegal_first_site_zero :
    inner ℝ (doubledLegalSpace.starProjection (countingBasis 0))
      (doubledLegalSpace.starProjection (countingBasis 0)) = 0 := by
  have h : doubledLegalSpace ≤ (innerSL ℝ (countingBasis 0)).ker := by
    apply Submodule.topologicalClosure_minimal _ ?_ (ContinuousLinearMap.isClosed_ker _)
    rintro _ ⟨f, _, rfl⟩
    change inner ℝ (countingBasis 0) (hilbertNormalizedDilation 2 (by decide) f) = 0
    rw [real_inner_comm, normalized_double_inner_first]
  have hm := doubledLegalSpace.starProjection_apply_mem (countingBasis 0)
  have hz : inner ℝ (countingBasis 0) (doubledLegalSpace.starProjection (countingBasis 0)) = 0 :=
    h hm
  have hh := Submodule.starProjection_inner_eq_zero (K := doubledLegalSpace) (countingBasis 0)
    (doubledLegalSpace.starProjection (countingBasis 0)) hm
  rw [inner_sub_left, hz, zero_sub, neg_eq_zero] at hh
  exact hh

private theorem first_site_finite_eq_capacity (n : ℕ) :
    integerKernel n 0 0 = fullCapacity n / 2 := by
  linarith only [vacancy_eq_fullCapacity n, vacancy_eq_kernel_complement n]

theorem first_site_finite_le_limiting (n : ℕ) :
    integerKernel n 0 0 ≤ limitingKernel 0 0 := by
  have h := limitingVacancy_le_vacancy n
  rw [limitingVacancy_eq_kernel_complement, vacancy_eq_kernel_complement] at h
  linarith only [h]

theorem first_site_kernel_rank_one :
    integerKernel 1 0 0 = 1 / (2 * Real.log 2) := by
  rw [first_site_finite_eq_capacity, fullCapacity_one_exact]
  ring

/-- The original legal projection has a positive first-site marginal. -/
theorem first_site_kernel_parity_lower :
    1 / (2 * Real.log 2) ≤ limitingKernel 0 0 := by
  rw [← first_site_kernel_rank_one]
  exact first_site_finite_le_limiting 1

/-- Exact first-site marginal of the legal two-conductor projection. -/
theorem first_site_kernel_rank_two :
    integerKernel 2 0 0 =
      let a := Real.log 2 / 4
      let b := Real.log 2 / 6 + Real.log 3 / 12 - Real.pi / (18 * Real.sqrt 3)
      let c := 2 * Real.log 3 / 9 - Real.pi / (27 * Real.sqrt 3)
      (c / 8 - b / 6 + a / 18) / (a * c - b ^ 2) := by
  have h00 : (fullGram 2) 0 0 = Real.log 2 / 4 := by
    change inner ℝ (residueAtom 0) (residueAtom 0) = _
    rw [real_inner_self_eq_norm_sq, residueAtom_zero_norm_sq]
  have h01 : (fullGram 2) 0 1 =
      Real.log 2 / 6 + Real.log 3 / 12 - Real.pi / (18 * Real.sqrt 3) :=
    residueAtom_inner_zero_one
  have h10 : (fullGram 2) 1 0 = (fullGram 2) 0 1 := real_inner_comm (residueAtom 0) (residueAtom 1)
  have h11 : (fullGram 2) 1 1 = 2 * Real.log 3 / 9 - Real.pi / (27 * Real.sqrt 3) := by
    change inner ℝ (residueAtom 1) (residueAtom 1) = _
    rw [real_inner_self_eq_norm_sq, residueAtom_one_norm_sq]
  rw [first_site_finite_eq_capacity, fullCapacity_two_entries, Matrix.det_fin_two,
    h10, h01, h00, h11]
  dsimp only
  simp only [pow_two]
  ring

