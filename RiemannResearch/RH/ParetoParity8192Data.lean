/-! # Conductor-8192 integer Pareto trial

The coefficient rows come from the supplied Pareto finite-limit computation. Entry zero represents
conductor 2. The signed integer coefficients use the common scale 10^9.
The integer head rounds each nonnegative term upward, including divisible
numerators without an extra unit.
-/

open scoped BigOperators
namespace RiemannResearch.RH.Pareto.PrimePowerSchur.Conductor8192



/-- Store a row of signed 31-bit digits in a natural number. Each digit
has a bias of 2^30. Expansion leaves a single numeral for kernel reduction. -/
syntax "signedRow![" term,* "]" : term
macro_rules
  | `(signedRow![$xs,*]) => do
    let mut total : Nat := 0
    let mut place : Nat := 1
    for x in xs.getElems do
      let z : Int ← match x with
        | `(-$v:num) => pure (-Int.ofNat v.getNat)
        | `($v:num) => pure (Int.ofNat v.getNat)
        | _ => Lean.Macro.throwErrorAt x "expected a signed integer literal"
      let biased := z + (2^30 : Int)
      if biased < 0 || (2^31 : Int) ≤ biased then
        Lean.Macro.throwErrorAt x "coefficient does not fit in a signed 31-bit digit"
      total := total + biased.toNat * place
      place := place * 2^31
    return Lean.Syntax.mkNumLit (toString total)

