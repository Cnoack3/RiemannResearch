private theorem residueUpper5040_eq_int (k : ℕ) :
    residueUpper5040 (k + 1) =
      (weightNumerator5040 k : ℝ) / (weightDenominator5040 k : ℝ) := by
  have h := RiemannResearch.Analysis.residue_upper_common_denominator
    ((k : ℝ) + 1) 5040 (by positivity) (by norm_num)
  simpa only [residueUpper5040, weightNumerator5040, weightDenominator5040,
    Nat.cast_add, Nat.cast_one, Int.cast_add, Int.cast_mul, Int.cast_natCast,
    Int.cast_ofNat, Int.cast_zero, Int.cast_one, add_assoc,
    show (5040 : ℝ) + 1 = 5041 from by norm_num,
    show (2 : ℝ) * 5040 = 10080 from by norm_num] using h

private theorem residueCap5040_bound (k : ℕ) (hk : k < 5040) :
    residueUpper5040 (k + 1) * (1 - legalWitness5040 (k + 1)) ^ 2 ≤
      (residueCapInt5040 k : ℝ) / 10000000000 := by
  have hc : (10000000000 : ℝ) * (weightNumerator5040 k : ℝ) *
      (10000 - (witnessNumerator5040 (k + 1) : ℝ)) ^ 2 ≤
      (residueCapInt5040 k : ℝ) * 10000 ^ 2 * (weightDenominator5040 k : ℝ) := by
    exact_mod_cast (residueCapInt5040_all k hk)
  have hB : (0 : ℝ) < (weightDenominator5040 k : ℝ) := by
    simp only [weightDenominator5040, Int.cast_mul, Int.cast_add,
      Int.cast_natCast, Int.cast_ofNat, Int.cast_zero, Int.cast_one]
    positivity
  rw [residueUpper5040_eq_int, legalWitness5040_eq_int]
  have he : 1 - (witnessNumerator5040 (k + 1) : ℝ) / 10000 =
      (10000 - (witnessNumerator5040 (k + 1) : ℝ)) / 10000 := by ring
  rw [he]
  exact RiemannResearch.Analysis.upper_certificate_of_cross_mul
    _ _ _ _ _ _ hB (by norm_num) (by norm_num) hc

private theorem residueCap5040_sum_lt :
    (∑ r : Fin 5040, (residueCapInt5040 r.val : ℝ) / 10000000000) <
      (39 : ℝ) / 1000 := by
  have h : (∑ r : Fin 5040, (residueCapInt5040 r.val : ℝ)) = 389331321 := by
    exact_mod_cast residueCapInt5040_sum
  rw [← Finset.sum_div, h]
  norm_num

/-- Exact integer caps control the full residue error of the actual legal witness. -/
theorem legalWitness5040_upper_certificate :
    (∑ r : Fin 5040, residueUpper5040 (r.val + 1) *
      (1 - legalWitness5040 (r.val + 1)) ^ 2) < (39 : ℝ) / 1000 := by
  apply lt_of_le_of_lt _ residueCap5040_sum_lt
  exact Finset.sum_le_sum fun r _ => residueCap5040_bound r.val r.isLt

/-- Analytic weights are kept intact and need only the proved pointwise enclosure. -/
theorem legalWitness5040_error_lt_of_weights
    (w : Fin 5040 → ℝ)
    (hw : ∀ r, w r ≤ residueUpper5040 (r.val + 1)) :
    (∑ r : Fin 5040, w r * (1 - legalWitness5040 (r.val + 1)) ^ 2) <
      (39 : ℝ) / 1000 := by
  apply lt_of_le_of_lt _ legalWitness5040_upper_certificate
  exact Finset.sum_le_sum fun r _ =>
    mul_le_mul_of_nonneg_right (hw r) (sq_nonneg _)
end
