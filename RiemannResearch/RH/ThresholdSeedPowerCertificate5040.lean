/-- Two exact progression terms and the telescoping bound for the remaining tail. -/
def residueUpper5040 (r : ℕ) : ℝ :=
  1 / ((r : ℝ) * (r + 1)) +
  1 / (((r : ℝ) + 5040) * (r + 5041)) +
  1 / (5040 * ((r : ℝ) + 5041))

