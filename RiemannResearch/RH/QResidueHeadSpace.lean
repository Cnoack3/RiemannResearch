/-!
# The entire zero-head space of a finite residue dictionary

Source: user-provided Squarefree_Lattice_Log_Exp_Theory_2026-10-16,
Sections 8 and 9. This proves the exhaustive affine-direction assertion;
the finite dictionary here need not be squarefree. All vectors and heads
are in the actual Q Hilbert space.
-/

noncomputable section
open scoped BigOperators
namespace RiemannResearch.RH.QResidueHeadSpace
open ZetaTwoHilbert ArithmeticCumulative QSquarefreeLatticePackets

def dictionary (s : Finset ℕ) : Submodule ℝ QHilbert :=
  Submodule.span ℝ (Set.range fun d : s => qResidue (d : ℕ))

def headNull (H : ℕ) : Submodule ℝ QHilbert where
  carrier := {f | ∀ n, 0 < n → n ≤ H → qSequence f n = 0}
  zero_mem' := by intro n hn hnH; change qSequenceLinear 0 n = 0; simp
  add_mem' := by
    intro f g hf hg n hn hnH
    change qSequenceLinear (f + g) n = 0
    simp only [map_add, Pi.add_apply]
    change qSequence f n + qSequence g n = 0
    rw [hf n hn hnH, hg n hn hnH, add_zero]
  smul_mem' := by
    intro a f hf n hn hnH
    change qSequenceLinear (a • f) n = 0
    simp only [map_smul, Pi.smul_apply, smul_eq_mul]
    change a * qSequence f n = 0
    rw [hf n hn hnH, mul_zero]

def freeConductors (s : Finset ℕ) (H r : ℕ) : Finset ℕ :=
  s.filter fun d => H < d ∧ d ≠ r

def zeroHeadSpan (s : Finset ℕ) (H r : ℕ) : Submodule ℝ QHilbert :=
  Submodule.span ℝ (Set.range fun d : freeConductors s H r =>
    compensatedResidue (d : ℕ) r)

theorem synthesis_sequence (s : Finset ℕ) (c : ℕ → ℝ) (n : ℕ) :
    qSequence (∑ d ∈ s, c d • qResidue d) n =
      ∑ d ∈ s, c d * residueFraction d n := by
  change qSequenceLinear (∑ d ∈ s, c d • qResidue d) n = _
  simp only [map_sum, map_smul, Finset.sum_apply, Pi.smul_apply, smul_eq_mul]
  simp only [show ∀ d, qSequenceLinear (qResidue d) = residueFraction d from
    fun d => qSequence_qResidue d]

theorem mem_dictionary_iff (s : Finset ℕ) (f : QHilbert) :
    f ∈ dictionary s ↔ ∃ c : ℕ → ℝ, (∑ d ∈ s, c d • qResidue d) = f := by
  classical
  constructor
  · intro hf
    obtain ⟨c, hc⟩ := (Submodule.mem_span_range_iff_exists_fun ℝ).mp hf
    let a : ℕ → ℝ := fun d => if hd : d ∈ s then c ⟨d, hd⟩ else 0
    refine ⟨a, ?_⟩
    rw [Finset.sum_subtype s (fun _ => Iff.rfl)]
    calc
      _ = ∑ d : s, c d • qResidue (d : ℕ) := by
        apply Finset.sum_congr rfl
        intro d hd
        simp only [a, dif_pos d.property]
      _ = f := hc
  · rintro ⟨c, rfl⟩
    exact (dictionary s).sum_mem fun d hd =>
      (dictionary s).smul_mem _ (Submodule.subset_span ⟨⟨d, hd⟩, rfl⟩)

theorem zeroHeadSpan_le_dictionary (s : Finset ℕ) (H r : ℕ) (hr : r ∈ s) :
    zeroHeadSpan s H r ≤ dictionary s := by
  apply Submodule.span_le.mpr
  rintro f ⟨d, rfl⟩
  have hd := (Finset.mem_filter.mp d.property).1
  exact (dictionary s).sub_mem
    (Submodule.subset_span ⟨⟨d, hd⟩, rfl⟩)
    ((dictionary s).smul_mem _ (Submodule.subset_span ⟨⟨r, hr⟩, rfl⟩))

theorem zeroHeadSpan_le_headNull (s : Finset ℕ) (H r : ℕ)
    (hrH : H < r) :
    zeroHeadSpan s H r ≤ headNull H := by
  apply Submodule.span_le.mpr
  rintro f ⟨d, rfl⟩ n hn hnH
  have hd := (Finset.mem_filter.mp d.property).2.1
  exact compensatedResidue_head d r n (by omega) (by omega) (by omega) (by omega)

/-- Every zero-head legal perturbation is generated by all compensated
conductors above the head, with the anchor removed. -/
theorem inf_headNull_eq_zeroHeadSpan (s : Finset ℕ)
    (hs : ∀ d ∈ s, 1 < d) (H r : ℕ) (hH : 0 < H)
    (hr : r ∈ s) (hrH : H < r) :
    dictionary s ⊓ headNull H = zeroHeadSpan s H r := by
  classical
  apply le_antisymm
  · intro f hf
    obtain ⟨c, rfl⟩ := (mem_dictionary_iff s f).mp hf.1
    have hh : ∀ n, 0 < n → n ≤ H →
        (∑ d ∈ s, c d * residueFraction d n) = 0 := by
      intro n hn hnH
      rw [← synthesis_sequence]
      exact hf.2 n hn hnH
    obtain ⟨hz, hc⟩ := (Pareto.residueFraction_zero_head_iff s c hs H hH).mp hh
    have heq : (∑ d ∈ s, c d • qResidue d) =
        ∑ d ∈ s, c d • compensatedResidue d r := by
      simpa only [id_eq] using zeroSlope_eq_compensated_sum s id c r hz
    rw [heq]
    have he : (∑ d ∈ freeConductors s H r, c d • compensatedResidue d r) =
        ∑ d ∈ s, c d • compensatedResidue d r := by
      apply Finset.sum_subset (Finset.filter_subset _ _)
      intro d hd hdnot
      by_cases hdH : d ≤ H
      · simp [hc d hd hdH]
      · have hdr : d = r := by
          by_contra hne
          exact hdnot (Finset.mem_filter.mpr ⟨hd, by omega, hne⟩)
        subst d
        have hrR : (r : ℝ) ≠ 0 := by
          exact_mod_cast (show r ≠ 0 by omega)
        simp [compensatedResidue, div_self hrR]
    rw [← he]
    exact (zeroHeadSpan s H r).sum_mem fun d hd =>
      (zeroHeadSpan s H r).smul_mem _ (Submodule.subset_span ⟨⟨d, hd⟩, rfl⟩)
  · exact le_inf (zeroHeadSpan_le_dictionary s H r hr)
      (zeroHeadSpan_le_headNull s H r hrH)

/-- Any seed with the requested head gives the entire affine feasible set. -/
theorem exact_head_iff_sub_mem_zeroHeadSpan (s : Finset ℕ)
    (hs : ∀ d ∈ s, 1 < d) (H r : ℕ) (hH : 0 < H)
    (hr : r ∈ s) (hrH : H < r) (B : QHilbert)
    (hB : B ∈ dictionary s)
    (hBh : ∀ n, 0 < n → n ≤ H → qSequence B n = 1) (f : QHilbert) :
    (f ∈ dictionary s ∧ ∀ n, 0 < n → n ≤ H → qSequence f n = 1) ↔
      f - B ∈ zeroHeadSpan s H r := by
  rw [← inf_headNull_eq_zeroHeadSpan s hs H r hH hr hrH]
  constructor
  · rintro ⟨hf, hh⟩
    refine ⟨(dictionary s).sub_mem hf hB, ?_⟩
    intro n hn hnH
    change qSequenceLinear (f - B) n = 0
    simp only [map_sub, Pi.sub_apply]
    change qSequence f n - qSequence B n = 0
    rw [hh n hn hnH, hBh n hn hnH, sub_self]
  · rintro ⟨hf, hh⟩
    refine ⟨?_, ?_⟩
    · have ha := (dictionary s).add_mem hf hB
      simpa only [sub_add_cancel] using ha
    · intro n hn hnH
      have he := hh n hn hnH
      change qSequenceLinear (f - B) n = 0 at he
      simp only [map_sub, Pi.sub_apply] at he
      change qSequence f n - qSequence B n = 0 at he
      rw [hBh n hn hnH] at he
      exact sub_eq_zero.mp he

/-- Distinct compensated directions retain linear independence. -/
theorem compensated_linearIndependent (s : Finset ℕ)
    (hs : ∀ d ∈ s, 1 < d) (H r : ℕ) (hr : r ∈ s) :
    LinearIndependent ℝ
      (fun d : freeConductors s H r => compensatedResidue (d : ℕ) r) := by
  classical
  let I := ↥(freeConductors s H r)
  let e : Option I → ℕ := fun o => o.elim r (fun d => (d : ℕ))
  have he2 : ∀ o, 1 < e o := by
    intro o
    cases o with
    | none => exact hs r hr
    | some d => exact hs d (Finset.mem_filter.mp d.property).1
  have hei : Function.Injective e := by
    intro a b hab
    cases a with
    | none =>
      cases b with
      | none => rfl
      | some j =>
        exact False.elim ((Finset.mem_filter.mp j.property).2.2 hab.symm)
    | some i =>
      cases b with
      | none =>
        exact False.elim ((Finset.mem_filter.mp i.property).2.2 hab)
      | some j =>
        have hij : i = j := Subtype.ext hab
        exact congrArg Option.some hij
  have hv := QCovarianceInvertibility.qResidue_linearIndependent e he2 hei
  apply Fintype.linearIndependent_iff.mpr
  intro c hc i
  let a : Option I → ℝ := fun o => o.elim
    (-(∑ d : I, c d * ((r : ℝ) / (d : ℕ)))) c
  have ha : (∑ o, a o • qResidue (e o)) = 0 := by
    simp only [Fintype.sum_option, a, e, Option.elim_none, Option.elim_some]
    simp only [compensatedResidue, smul_sub, smul_smul, Finset.sum_sub_distrib,
      ← Finset.sum_smul] at hc
    simpa only [neg_smul, sub_eq_add_neg, add_comm] using hc
  exact Fintype.linearIndependent_iff.mp hv a ha (some i)


open RiemannResearch.Analysis.FiniteHilbertGram

/-- The actual inverse-Gram optimizer in the entire exact-head affine space. -/
def affineOptimizer (s : Finset ℕ) (hs : ∀ d ∈ s, 1 < d)
    (H r : ℕ) (hr : r ∈ s) (B t : QHilbert) : QHilbert :=
  B + Fintype.linearCombination ℝ
    (fun d : freeConductors s H r => compensatedResidue (d : ℕ) r)
    (inverseCoeff (compensated_linearIndependent s hs H r hr) (t - B))

theorem affineOptimizer_feasible (s : Finset ℕ) (hs : ∀ d ∈ s, 1 < d)
    (H r : ℕ) (hH : 0 < H) (hr : r ∈ s) (hrH : H < r)
    (B t : QHilbert) (hB : B ∈ dictionary s)
    (hBh : ∀ n, 0 < n → n ≤ H → qSequence B n = 1) :
    affineOptimizer s hs H r hr B t ∈ dictionary s ∧
      ∀ n, 0 < n → n ≤ H →
        qSequence (affineOptimizer s hs H r hr B t) n = 1 := by
  apply (exact_head_iff_sub_mem_zeroHeadSpan s hs H r hH hr hrH B hB hBh _).mpr
  simp only [affineOptimizer, add_sub_cancel_left, Fintype.linearCombination_apply]
  exact (zeroHeadSpan s H r).sum_mem fun d _ =>
    (zeroHeadSpan s H r).smul_mem _ (Submodule.subset_span ⟨d, rfl⟩)

/-- The exact complete-Q value; every signed cross term is in the Gram inverse. -/
theorem affineOptimizer_error_formula (s : Finset ℕ) (hs : ∀ d ∈ s, 1 < d)
    (H r : ℕ) (hr : r ∈ s) (B t : QHilbert) :
    let v := fun d : freeConductors s H r => compensatedResidue (d : ℕ) r
    let hv := compensated_linearIndependent s hs H r hr
    ‖t - affineOptimizer s hs H r hr B t‖ ^ 2 =
      ‖t - B‖ ^ 2 - ∑ d, inverseCoeff hv (t - B) d * cross v (t - B) d := by
  simpa only [affineOptimizer, sub_add_eq_sub_sub] using
    residual_schur_value (compensated_linearIndependent s hs H r hr) (t - B)

/-- The norm-square remainder for every feasible legal vector, not only
a prescribed packet family or a scalar-constrained ansatz. -/
theorem affineOptimizer_error_decomposition (s : Finset ℕ)
    (hs : ∀ d ∈ s, 1 < d) (H r : ℕ) (hH : 0 < H)
    (hr : r ∈ s) (hrH : H < r) (B t : QHilbert)
    (hB : B ∈ dictionary s)
    (hBh : ∀ n, 0 < n → n ≤ H → qSequence B n = 1)
    (f : QHilbert) (hf : f ∈ dictionary s)
    (hfh : ∀ n, 0 < n → n ≤ H → qSequence f n = 1) :
    ‖t - f‖ ^ 2 = ‖t - affineOptimizer s hs H r hr B t‖ ^ 2 +
      ‖f - affineOptimizer s hs H r hr B t‖ ^ 2 := by
  have hm := (exact_head_iff_sub_mem_zeroHeadSpan s hs H r hH hr hrH B hB hBh f).mp
    ⟨hf, hfh⟩
  obtain ⟨c, hc⟩ := (Submodule.mem_span_range_iff_exists_fun ℝ).mp hm
  let v := fun d : freeConductors s H r => compensatedResidue (d : ℕ) r
  let hv := compensated_linearIndependent s hs H r hr
  have hfc : f = B + Fintype.linearCombination ℝ v c := by
    change Fintype.linearCombination ℝ v c = f - B at hc
    rw [hc]
    abel
  have hdiff : f - affineOptimizer s hs H r hr B t =
      Fintype.linearCombination ℝ v (c - inverseCoeff hv (t - B)) := by
    rw [hfc, affineOptimizer, map_sub]
    abel
  rw [hdiff, hfc]
  simpa only [affineOptimizer, sub_add_eq_sub_sub] using residual_completion hv (t - B) c

theorem affineOptimizer_minimizes (s : Finset ℕ) (hs : ∀ d ∈ s, 1 < d)
    (H r : ℕ) (hH : 0 < H) (hr : r ∈ s) (hrH : H < r)
    (B t : QHilbert) (hB : B ∈ dictionary s)
    (hBh : ∀ n, 0 < n → n ≤ H → qSequence B n = 1)
    (f : QHilbert) (hf : f ∈ dictionary s)
    (hfh : ∀ n, 0 < n → n ≤ H → qSequence f n = 1) :
    ‖t - affineOptimizer s hs H r hr B t‖ ^ 2 ≤ ‖t - f‖ ^ 2 := by
  rw [affineOptimizer_error_decomposition s hs H r hH hr hrH B t hB hBh f hf hfh]
  exact le_add_of_nonneg_right (sq_nonneg _)


theorem affineOptimizer_unique (s : Finset ℕ) (hs : ∀ d ∈ s, 1 < d)
    (H r : ℕ) (hH : 0 < H) (hr : r ∈ s) (hrH : H < r)
    (B t : QHilbert) (hB : B ∈ dictionary s)
    (hBh : ∀ n, 0 < n → n ≤ H → qSequence B n = 1)
    (f : QHilbert) (hf : f ∈ dictionary s)
    (hfh : ∀ n, 0 < n → n ≤ H → qSequence f n = 1)
    (he : ‖t - f‖ ^ 2 = ‖t - affineOptimizer s hs H r hr B t‖ ^ 2) :
    f = affineOptimizer s hs H r hr B t := by
  have hd := affineOptimizer_error_decomposition s hs H r hH hr hrH B t hB hBh f hf hfh
  have hz : ‖f - affineOptimizer s hs H r hr B t‖ ^ 2 = 0 := by linarith
  exact sub_eq_zero.mp (norm_eq_zero.mp (sq_eq_zero_iff.mp hz))

/-- An arbitrary feasible physical head determines the entire affine set. -/
theorem same_head_iff_sub_mem_zeroHeadSpan (s : Finset ℕ)
    (hs : ∀ d ∈ s, 1 < d) (H r : ℕ) (hH : 0 < H)
    (hr : r ∈ s) (hrH : H < r) (B : QHilbert)
    (hB : B ∈ dictionary s) (f : QHilbert) :
    (f ∈ dictionary s ∧ ∀ n, 0 < n → n ≤ H →
      qSequence f n = qSequence B n) ↔
      f - B ∈ zeroHeadSpan s H r := by
  rw [← inf_headNull_eq_zeroHeadSpan s hs H r hH hr hrH]
  constructor
  · rintro ⟨hf, hh⟩
    refine ⟨(dictionary s).sub_mem hf hB, ?_⟩
    intro n hn hnH
    change qSequenceLinear (f - B) n = 0
    simp only [map_sub, Pi.sub_apply]
    change qSequence f n - qSequence B n = 0
    rw [hh n hn hnH, sub_self]
  · rintro ⟨hf, hh⟩
    refine ⟨?_, ?_⟩
    · have ha := (dictionary s).add_mem hf hB
      simpa only [sub_add_cancel] using ha
    · intro n hn hnH
      have he := hh n hn hnH
      change qSequenceLinear (f - B) n = 0 at he
      simp only [map_sub, Pi.sub_apply] at he
      exact sub_eq_zero.mp he

/-- The inverse-Gram optimizer preserves every feasible head, not just a constant head. -/
theorem affineOptimizer_same_head (s : Finset ℕ) (hs : ∀ d ∈ s, 1 < d)
    (H r : ℕ) (hH : 0 < H) (hr : r ∈ s) (hrH : H < r)
    (B t : QHilbert) (hB : B ∈ dictionary s) :
    affineOptimizer s hs H r hr B t ∈ dictionary s ∧
      ∀ n, 0 < n → n ≤ H →
        qSequence (affineOptimizer s hs H r hr B t) n = qSequence B n := by
  apply (same_head_iff_sub_mem_zeroHeadSpan s hs H r hH hr hrH B hB _).mpr
  simp only [affineOptimizer, add_sub_cancel_left, Fintype.linearCombination_apply]
  exact (zeroHeadSpan s H r).sum_mem fun d _ =>
    (zeroHeadSpan s H r).smul_mem _ (Submodule.subset_span ⟨d, rfl⟩)

/-- Exact completion on the entire affine set, for an arbitrary prescribed head. -/
theorem affineOptimizer_completion_of_mem (s : Finset ℕ)
    (hs : ∀ d ∈ s, 1 < d) (H r : ℕ) (hr : r ∈ s) (B t f : QHilbert)
    (hf : f - B ∈ zeroHeadSpan s H r) :
    ‖t - f‖ ^ 2 = ‖t - affineOptimizer s hs H r hr B t‖ ^ 2 +
      ‖f - affineOptimizer s hs H r hr B t‖ ^ 2 := by
  obtain ⟨c, hc⟩ := (Submodule.mem_span_range_iff_exists_fun ℝ).mp hf
  let v := fun d : freeConductors s H r => compensatedResidue (d : ℕ) r
  let hv := compensated_linearIndependent s hs H r hr
  have hfc : f = B + Fintype.linearCombination ℝ v c := by
    change Fintype.linearCombination ℝ v c = f - B at hc
    rw [hc]
    abel
  have hdiff : f - affineOptimizer s hs H r hr B t =
      Fintype.linearCombination ℝ v (c - inverseCoeff hv (t - B)) := by
    rw [hfc, affineOptimizer, map_sub]
    abel
  rw [hdiff, hfc]
  simpa only [affineOptimizer, sub_add_eq_sub_sub] using residual_completion hv (t - B) c

/-- Minimum norm and the complete norm-square remainder for every same-head vector. -/
theorem affineOptimizer_same_head_completion (s : Finset ℕ)
    (hs : ∀ d ∈ s, 1 < d) (H r : ℕ) (hH : 0 < H)
    (hr : r ∈ s) (hrH : H < r) (B t : QHilbert)
    (hB : B ∈ dictionary s) (f : QHilbert) (hf : f ∈ dictionary s)
    (hhead : ∀ n, 0 < n → n ≤ H → qSequence f n = qSequence B n) :
    ‖t - f‖ ^ 2 = ‖t - affineOptimizer s hs H r hr B t‖ ^ 2 +
      ‖f - affineOptimizer s hs H r hr B t‖ ^ 2 := by
  exact affineOptimizer_completion_of_mem s hs H r hr B t f
    ((same_head_iff_sub_mem_zeroHeadSpan s hs H r hH hr hrH B hB f).mp ⟨hf, hhead⟩)

end RiemannResearch.RH.QResidueHeadSpace

/-!
## Minimum energy while preserving every prescribed head value

Source: the user's minimum-energy exact-head research agenda, Section 10,
28 October 2026. The projection construction covers every H, including zero.
The explicit compensated-basis formula additionally uses 0 < H < r.
-/
namespace RiemannResearch.RH.QResidueHeadSpace
open ZetaTwoHilbert QSquarefreeLatticePackets
open RiemannResearch.Analysis.FiniteHilbertGram

instance dictionary_finiteDimensional (s : Finset ℕ) :
    FiniteDimensional ℝ (dictionary s) :=
  FiniteDimensional.span_of_finite ℝ (Set.finite_range _)

instance headKernel_finiteDimensional (s : Finset ℕ) (H : ℕ) :
    FiniteDimensional ℝ ↥(dictionary s ⊓ headNull H) := by
  let i : ↥(dictionary s ⊓ headNull H) →ₗ[ℝ] dictionary s :=
    { toFun := fun x => ⟨x.val, x.property.1⟩
      map_add' := by intros; rfl
      map_smul' := by intros; rfl }
  exact FiniteDimensional.of_injective i (by
    intro x y h
    apply Subtype.ext
    exact congrArg (fun z : dictionary s => (z : QHilbert)) h)

def exactHeadAdjustment (s : Finset ℕ) (H : ℕ) (F : QHilbert) : QHilbert :=
  F - (dictionary s ⊓ headNull H).starProjection F

theorem same_head_sub_mem (s : Finset ℕ) (H : ℕ) (F f : QHilbert)
    (hF : F ∈ dictionary s) (hf : f ∈ dictionary s)
    (hh : ∀ n, 0 < n → n ≤ H → qSequence f n = qSequence F n) :
    f - F ∈ dictionary s ⊓ headNull H := by
  refine ⟨(dictionary s).sub_mem hf hF, ?_⟩
  intro n hn hnH
  change qSequenceLinear (f - F) n = 0
  simp only [map_sub, Pi.sub_apply]
  change qSequence f n - qSequence F n = 0
  exact sub_eq_zero.mpr (hh n hn hnH)

theorem exactHeadAdjustment_same_head (s : Finset ℕ) (H : ℕ) (F : QHilbert)
    (hF : F ∈ dictionary s) :
    exactHeadAdjustment s H F ∈ dictionary s ∧
      ∀ n, 0 < n → n ≤ H →
        qSequence (exactHeadAdjustment s H F) n = qSequence F n := by
  have hp := (dictionary s ⊓ headNull H).starProjection_apply_mem F
  refine ⟨(dictionary s).sub_mem hF hp.1, ?_⟩
  intro n hn hnH
  change qSequenceLinear (F - (dictionary s ⊓ headNull H).starProjection F) n = _
  simp only [map_sub, Pi.sub_apply]
  change qSequence F n - qSequence ((dictionary s ⊓ headNull H).starProjection F) n =
    qSequence F n
  rw [hp.2 n hn hnH, sub_zero]

theorem exactHeadAdjustment_completion_of_mem (s : Finset ℕ) (H : ℕ)
    (F f : QHilbert) (hf : f - F ∈ dictionary s ⊓ headNull H) :
    ‖f‖ ^ 2 = ‖exactHeadAdjustment s H F‖ ^ 2 +
      ‖f - exactHeadAdjustment s H F‖ ^ 2 := by
  let W := dictionary s ⊓ headNull H
  have hw : f - exactHeadAdjustment s H F ∈ W := by
    have hm := W.add_mem hf (W.starProjection_apply_mem F)
    have he : f - exactHeadAdjustment s H F = (f - F) + W.starProjection F := by
      dsimp [exactHeadAdjustment, W]
      abel
    rw [he]
    exact hm
  have ho := Submodule.starProjection_inner_eq_zero F
    (f - exactHeadAdjustment s H F) hw
  change inner ℝ (exactHeadAdjustment s H F) (f - exactHeadAdjustment s H F) = 0 at ho
  have he : f = exactHeadAdjustment s H F + (f - exactHeadAdjustment s H F) := by abel
  calc
    ‖f‖ ^ 2 = ‖exactHeadAdjustment s H F + (f - exactHeadAdjustment s H F)‖ ^ 2 :=
      congrArg (fun x : QHilbert => ‖x‖ ^ 2) he
    _ = _ := by rw [norm_add_sq_real, ho]; ring

theorem exactHeadAdjustment_energy (s : Finset ℕ) (H : ℕ) (F : QHilbert) :
    ‖exactHeadAdjustment s H F‖ ^ 2 =
      ‖F‖ ^ 2 - ‖(dictionary s ⊓ headNull H).starProjection F‖ ^ 2 := by
  have h := exactHeadAdjustment_completion_of_mem s H F F (by simp)
  have he : F - exactHeadAdjustment s H F =
      (dictionary s ⊓ headNull H).starProjection F := by
    dsimp [exactHeadAdjustment]
    abel
  rw [he] at h
  linarith

theorem exactHeadAdjustment_completion (s : Finset ℕ) (H : ℕ) (F f : QHilbert)
    (hF : F ∈ dictionary s) (hf : f ∈ dictionary s)
    (hh : ∀ n, 0 < n → n ≤ H → qSequence f n = qSequence F n) :
    ‖f‖ ^ 2 = ‖exactHeadAdjustment s H F‖ ^ 2 +
      ‖f - exactHeadAdjustment s H F‖ ^ 2 :=
  exactHeadAdjustment_completion_of_mem s H F f (same_head_sub_mem s H F f hF hf hh)

theorem exactHeadAdjustment_isLeast (s : Finset ℕ) (H : ℕ)
    (F : QHilbert) (hF : F ∈ dictionary s) :
    IsLeast {E : ℝ | ∃ f : QHilbert, f ∈ dictionary s ∧
      (∀ n, 0 < n → n ≤ H → qSequence f n = qSequence F n) ∧ ‖f‖ ^ 2 = E}
      (‖exactHeadAdjustment s H F‖ ^ 2) := by
  constructor
  · obtain ⟨hm, hh⟩ := exactHeadAdjustment_same_head s H F hF
    exact ⟨_, hm, hh, rfl⟩
  · rintro E ⟨f, hf, hh, rfl⟩
    rw [exactHeadAdjustment_completion s H F f hF hf hh]
    exact le_add_of_nonneg_right (sq_nonneg _)

theorem exactHeadAdjustment_unique (s : Finset ℕ) (H : ℕ) (F f : QHilbert)
    (hF : F ∈ dictionary s) (hf : f ∈ dictionary s)
    (hh : ∀ n, 0 < n → n ≤ H → qSequence f n = qSequence F n)
    (he : ‖f‖ ^ 2 = ‖exactHeadAdjustment s H F‖ ^ 2) :
    f = exactHeadAdjustment s H F := by
  have hc := exactHeadAdjustment_completion s H F f hF hf hh
  have hz : ‖f - exactHeadAdjustment s H F‖ ^ 2 = 0 := by linarith
  exact sub_eq_zero.mp (norm_eq_zero.mp (sq_eq_zero_iff.mp hz))

theorem exactHeadAdjustment_seed_independent (s : Finset ℕ) (H : ℕ)
    (F F' : QHilbert) (hF : F ∈ dictionary s) (hF' : F' ∈ dictionary s)
    (hh : ∀ n, 0 < n → n ≤ H → qSequence F' n = qSequence F n) :
    exactHeadAdjustment s H F' = exactHeadAdjustment s H F := by
  have hm := same_head_sub_mem s H F F' hF hF' hh
  have hp := Submodule.starProjection_eq_self_iff.mpr hm
  have he : F' = F + (F' - F) := by abel
  calc
    _ = exactHeadAdjustment s H (F + (F' - F)) := congrArg (exactHeadAdjustment s H) he
    _ = _ := by
      simp only [exactHeadAdjustment, map_add, hp]
      abel

instance zeroHeadSpan_finiteDimensional (s : Finset ℕ) (H r : ℕ) :
    FiniteDimensional ℝ (zeroHeadSpan s H r) :=
  FiniteDimensional.span_of_finite ℝ (Set.finite_range _)

theorem exactHeadAdjustment_matrix_value (s : Finset ℕ)
    (hs : ∀ d ∈ s, 1 < d) (H r : ℕ) (hH : 0 < H)
    (hr : r ∈ s) (hrH : H < r) (F : QHilbert) :
    let v := fun d : freeConductors s H r => compensatedResidue (d : ℕ) r
    ‖exactHeadAdjustment s H F‖ ^ 2 =
      ‖F‖ ^ 2 - dotProduct (cross v F) ((gramMatrix v)⁻¹.mulVec (cross v F)) := by
  let v := fun d : freeConductors s H r => compensatedResidue (d : ℕ) r
  let hv := compensated_linearIndependent s hs H r hr
  dsimp only
  unfold exactHeadAdjustment
  simp only [inf_headNull_eq_zeroHeadSpan s hs H r hH hr hrH]
  have hp : Fintype.linearCombination ℝ v (inverseCoeff hv F) =
      (zeroHeadSpan s H r).starProjection F :=
    synthesis_inverseCoeff_eq_projection hv F
  rw [← hp, inverseCoeff_eq_inv_mulVec hv F]
  exact residual_matrix_value hv F

