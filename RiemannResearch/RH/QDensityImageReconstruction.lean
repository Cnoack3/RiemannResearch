import RiemannResearch.RH.QFullTargetTotality
import RiemannResearch.RH.QFullDensityConditionalConverse
import RiemannResearch.RH.ParetoRamanujanSquarefreeAnnihilator

/-!
# Reconstructing the zeta-two space from the density image

Start with S = B(V). The physical target in S is B applied to the constant.
The single operation h(n) ↦ h(n)/(n+1) on S has dense image in L²(Q).
-/

noncomputable section
namespace RiemannResearch.RH.QDensityImageReconstruction

open ZetaTwoHilbert ZetaTwoProbability QFullResidueProjection QDensityMetric
open QReciprocalMetric QDensityMetricInverse QDensityClosureTransfer
local notation "R" => QShiftedReciprocal.B

/-- The closed space generated by just the density images. -/
def S : Submodule ℝ QHilbert := QFullResidueProjection.closure.map B.toLinearMap

theorem image_closed : IsClosed (S : Set QHilbert) := by
  rw [S, ← densityClosure_eq_image]
  exact Submodule.isClosed_topologicalClosure _

instance : S.HasOrthogonalProjection := by
  let _ : CompleteSpace S := image_closed.completeSpace_coe
  infer_instance

theorem image_target_iff : B qOne ∈ S ↔ qOne ∈ QFullResidueProjection.closure := by
  rw [S, ← densityClosure_eq_image]
  exact density_target_mem_iff

/-- A single target inside S is equivalent to S already being the whole space. -/
theorem image_total_iff_target : S = ⊤ ↔ B qOne ∈ S := by
  change QFullResidueProjection.closure.map B.toLinearMap = ⊤ ↔ _
  rw [← densityClosure_eq_image]
  exact densityClosure_eq_top_iff.trans
    (QFullTargetTotality.closure_eq_top_iff_one_mem.trans image_target_iff.symm)

/-- The RH target is an ordinary zeta-two orthogonal projection in S alone. -/
theorem image_projection_iff :
    S.starProjection (B qOne) = B qOne ↔ qOne ∈ QFullResidueProjection.closure :=
  Submodule.starProjection_eq_self_iff.trans image_target_iff

theorem riemannHypothesis_of_image_target (h : B qOne ∈ S) : RiemannHypothesis :=
  riemannHypothesis_of_qOne_mem_full_closure (image_target_iff.mp h)

/-- Removing the shift from a density image gives its reciprocal image. -/
theorem reciprocal_density_image (f : QHilbert) : zetaTwo • R (B f) = D f := by
  rw [R_eq_inverse, inverse_B, D_eq_density, smul_sub, smul_smul,
    mul_one_div_cancel zetaTwo_pos.ne', one_smul]

/-- One fixed multiplier applied to S reconstructs the entire ambient space. -/
theorem shifted_image_dense : (S.map (R).toLinearMap).topologicalClosure = ⊤ := by
  apply top_unique
  rw [← full_D_map_dense]
  apply Submodule.topologicalClosure_minimal _ _ (Submodule.isClosed_topologicalClosure _)
  rintro _ ⟨v,hv,rfl⟩
  change D v ∈ (S.map (R).toLinearMap).topologicalClosure
  rw [← reciprocal_density_image]
  apply (S.map (R).toLinearMap).topologicalClosure.smul_mem
  exact Submodule.le_topologicalClosure _ ⟨B v,⟨v,legalSpan.le_topologicalClosure hv,rfl⟩,rfl⟩

open scoped BigOperators

/-- Row d is the raw residue and column q is the packet. -/
def packetEntry (d q : ℕ) : ℝ :=
  if d ∣ q then (ArithmeticFunction.moebius (q/d) : ℝ) else 0

theorem packetEntry_below {d q : ℕ} (hq : 0 < q) (h : q < d) : packetEntry d q = 0 := by
  have hnd : ¬ d ∣ q := fun hd => (Nat.not_le_of_gt h) (Nat.le_of_dvd hq hd)
  simp [packetEntry, hnd]

theorem packetEntry_diag {q : ℕ} (hq : 0 < q) : packetEntry q q = 1 := by
  simp [packetEntry, Nat.div_self hq]

/-- Multiplication by the density preserves every entry of the triangular packet expansion. -/
theorem density_packet_expansion (q : ℕ) :
    B (QRamanujanPackets.qRamanujanPacket q) =
      ∑ d ∈ q.divisors, packetEntry d q • B ((d : ℝ) • qResidue d) := by
  classical
  rw [QRamanujanPackets.qRamanujanPacket, map_sum]
  apply Finset.sum_congr rfl
  intro d hd
  simp only [packetEntry, if_pos (Nat.dvd_of_mem_divisors hd), map_smul, smul_smul]

/-- The inverse matrix has entry one at d dividing a, and zero elsewhere. -/
theorem density_residue_expansion (a : ℕ) (ha : 0 < a) :
    B ((a : ℝ) • qResidue a) = ∑ d ∈ a.divisors, B (QRamanujanPackets.qRamanujanPacket d) := by
  rw [← QRamanujanPackets.qRamanujanPacket_divisor_sum a ha, map_sum]

/-- The single family of density-twisted residues at squarefree conductors. -/
def squarefreeImage : Submodule ℝ QHilbert :=
  ((Submodule.span ℝ (qResidue '' ParetoRamanujanSquarefreeAnnihilator.squarefreeConductors)).map
    B.toLinearMap).topologicalClosure

/-- First exchange squarefree packets for residues on their divisor lattice,
then change the physical measure and multiply both sides by the density. -/
theorem squarefree_transfer (f : QHilbert) :
    B f ∈ squarefreeImage ↔ ZetaTwoParetoTransfer.toPareto f ∈
      ParetoRamanujanSquarefreeAnnihilator.squarefreeRamanujanClosure := by
  unfold squarefreeImage
  rw [mem_density_closure_iff]
  apply RamanujanTransfer.legal_closure_iff_ramanujan
  · intro d hd
    exact lt_trans Nat.zero_lt_one hd.1
  · intro d hd q hqd hq
    refine ⟨hq, Nat.squarefree_iff_prime_squarefree.mpr ?_⟩
    intro p hp hpp
    exact (Nat.squarefree_iff_prime_squarefree.mp hd.2 p hp) (dvd_trans hpp hqd)

/-- In the density-image formulation the transported constant is B applied to one. -/
theorem squarefree_target_iff :
    B qOne ∈ squarefreeImage ↔ Pareto.hilbertOne ∈
      ParetoRamanujanSquarefreeAnnihilator.squarefreeRamanujanClosure := by
  simpa only [ZetaTwoParetoTransfer.toPareto_qOne] using squarefree_transfer qOne

/-- The squarefree restriction still omits the density image of conductor four. -/
theorem squarefree_omits_four : B (qResidue 4) ∉ squarefreeImage := by
  intro hm
  have h := (squarefree_transfer _).mp hm
  rw [ZetaTwoParetoTransfer.toPareto_qResidue 4 (by norm_num)] at h
  have hz := ParetoRamanujanSquarefreeAnnihilator.fourSiteWitness_mem_ramanujan_orthogonal _ h
  rw [real_inner_comm, ParetoRamanujanSquarefreeAnnihilator.fourSiteWitness_pairing_residue_four] at hz
  norm_num at hz

private theorem squarefree_residue_span :
    Submodule.span ℝ (qResidue '' ParetoRamanujanSquarefreeAnnihilator.squarefreeConductors) =
      qSquarefreeCRTSpan := by
  unfold qSquarefreeCRTSpan
  congr 1
  ext f
  constructor
  · rintro ⟨d,hd,rfl⟩
    exact ⟨⟨d,hd.1,hd.2⟩,rfl⟩
  · rintro ⟨d,rfl⟩
    exact ⟨d.val,⟨d.property.1,d.property.2⟩,rfl⟩

theorem squarefree_image_target_iff_q :
    B qOne ∈ squarefreeImage ↔ qOne ∈ qSquarefreeCRTSpan.topologicalClosure := by
  unfold squarefreeImage
  rw [mem_density_closure_iff, squarefree_residue_span]

/-- Squarefree density-image approximation implies RH without any analytic provider. -/
theorem rh_of_squarefree_image (h : B qOne ∈ squarefreeImage) : RiemannHypothesis :=
  riemannHypothesis_of_qOne_mem_full_closure
    (QFullDensityConditionalConverse.squarefreeClosure_le_full (squarefree_image_target_iff_q.mp h))

/-- Bagchi, Remark 8, in density-image coordinates. The published analytic
input for the forward direction is Báez-Duarte, Theorem 2 (2003). -/
theorem rh_iff_squarefree_image
    (hBD : Pareto.BaezDuarte.BaezDuarteMobiusApproximation) :
    RiemannHypothesis ↔ B qOne ∈ squarefreeImage := by
  refine ⟨fun hRH => squarefree_image_target_iff_q.mpr ?_, rh_of_squarefree_image⟩
  exact qSquarefreeClosure_iff_paretoSquarefreeClosure.mpr
    (Pareto.BaezDuarte.squarefreeClosure_of_baezDuarteMobiusApproximation hBD hRH)

#print axioms rh_of_squarefree_image
#print axioms rh_iff_squarefree_image

#print axioms squarefree_transfer
#print axioms squarefree_target_iff

#print axioms image_total_iff_target
#print axioms shifted_image_dense

end RiemannResearch.RH.QDensityImageReconstruction
