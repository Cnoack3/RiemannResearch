/-- Each bounded integer block is checked by kernel reduction; the
28 exact row totals cancel for every one of the 68 legal generators. -/
private theorem dualNumeratorInt2520_annihilates_generator (j : Fin 68) :
    (∑ r : Fin 2520, dualNumeratorInt2520 r * conductor2520GeneratorInt j (r.val+1)) = 0 := by
  have he : (∑ r : Fin 2520, dualNumeratorInt2520 r *
      conductor2520GeneratorInt j (r.val+1)) =
      ∑ r : Fin 2520, dualPairingTerm2520 j (0+r.val) := by
    apply Finset.sum_congr rfl
    intro r _
    unfold dualPairingTerm2520
    have hr : (⟨r.val % 2520, Nat.mod_lt _ (by norm_num)⟩ : Fin 2520) = r := by
      apply Fin.ext
      exact Nat.mod_eq_of_lt r.isLt
    simp only [zero_add, hr]
  rw [he]
  rw [dualPairingTerm2520_sum_split j 0 90 2430, dualPairingTerm2520_row0]
  rw [dualPairingTerm2520_sum_split j 90 90 2340, dualPairingTerm2520_row1]
  rw [dualPairingTerm2520_sum_split j 180 90 2250, dualPairingTerm2520_row2]
  rw [dualPairingTerm2520_sum_split j 270 90 2160, dualPairingTerm2520_row3]
  rw [dualPairingTerm2520_sum_split j 360 90 2070, dualPairingTerm2520_row4]
  rw [dualPairingTerm2520_sum_split j 450 90 1980, dualPairingTerm2520_row5]
  rw [dualPairingTerm2520_sum_split j 540 90 1890, dualPairingTerm2520_row6]
  rw [dualPairingTerm2520_sum_split j 630 90 1800, dualPairingTerm2520_row7]
  rw [dualPairingTerm2520_sum_split j 720 90 1710, dualPairingTerm2520_row8]
  rw [dualPairingTerm2520_sum_split j 810 90 1620, dualPairingTerm2520_row9]
  rw [dualPairingTerm2520_sum_split j 900 90 1530, dualPairingTerm2520_row10]
  rw [dualPairingTerm2520_sum_split j 990 90 1440, dualPairingTerm2520_row11]
  rw [dualPairingTerm2520_sum_split j 1080 90 1350, dualPairingTerm2520_row12]
  rw [dualPairingTerm2520_sum_split j 1170 90 1260, dualPairingTerm2520_row13]
