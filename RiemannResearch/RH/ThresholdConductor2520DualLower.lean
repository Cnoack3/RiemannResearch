/-- Common numerator of the two retained rational progression masses. -/
private def lowerWeightNumerator2520 (k : ℕ) : ℤ :=
  let r : ℤ := (k : ℤ) + 1
  r * (r + 1) + (r + 2520) * (r + 2521)

private def lowerWeightDenominator2520 (k : ℕ) : ℤ :=
  let r : ℤ := (k : ℤ) + 1
  r * (r + 1) * ((r + 2520) * (r + 2521))

/-- Signed integer cross multiplication retains the entire dual expression. -/
private def dualLowerCapCheck2520 (k : ℕ) : Prop :=
  let r : Fin 2520 := ⟨k % 2520, Nat.mod_lt _ (by norm_num)⟩
  dualLowerNumeratorInt2520 r * (100000000 : ℤ)^2 * lowerWeightNumerator2520 r.val ≤
    (10000000000 : ℤ) *
      (2 * dualNumeratorInt2520 r * 100000000 * lowerWeightNumerator2520 r.val -
        (dualNumeratorInt2520 r)^2 * lowerWeightDenominator2520 r.val)

private instance (k : ℕ) : Decidable (dualLowerCapCheck2520 k) :=
  by unfold dualLowerCapCheck2520; infer_instance

