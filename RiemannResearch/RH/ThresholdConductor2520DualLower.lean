private theorem dualNumerator2520_annihilates_generator (j : Fin 68) :
    (∑ r : Fin 2520, dualNumerator2520 r * conductor2520Generator j (r.val+1)) = 0 := by
  simp only [dualNumerator2520, conductor2520Generator_eq_int]
  exact_mod_cast (dualNumeratorInt2520_annihilates_generator j)

private theorem dual2520_annihilates_generator (j : Fin 68) :
    (∑ r : Fin 2520, dual2520 r * conductor2520Generator j (r.val+1)) = 0 := by
  simp only [dual2520, div_mul_eq_mul_div]
  rw [← Finset.sum_div, dualNumerator2520_annihilates_generator, zero_div]

private theorem dual2520_annihilates_combination (c : Fin 68 → ℝ) :
    (∑ r : Fin 2520, dual2520 r * conductor2520Combination c (r.val+1)) = 0 := by
  unfold conductor2520Combination
  calc
    _ = ∑ r : Fin 2520, ∑ j : Fin 68,
        c j * (dual2520 r * conductor2520Generator j (r.val+1)) := by
      apply Finset.sum_congr rfl
      intro r _
      rw [Finset.mul_sum]
      apply Finset.sum_congr rfl
      intro j _
      ring
    _ = ∑ j : Fin 68, ∑ r : Fin 2520,
        c j * (dual2520 r * conductor2520Generator j (r.val+1)) := by
      rw [Finset.sum_comm]
    _ = ∑ j : Fin 68, c j *
        (∑ r : Fin 2520, dual2520 r * conductor2520Generator j (r.val+1)) := by
      simp only [Finset.mul_sum]
    _ = 0 := by simp only [dual2520_annihilates_generator, mul_zero, Finset.sum_const_zero]

private def dualLowerNumeratorNat2520 (k : ℕ) : ℤ :=
  dualLowerNumeratorInt2520 ⟨k % 2520, Nat.mod_lt _ (by norm_num)⟩

private theorem dualLowerNumeratorNat2520_sum_split (offset n m : ℕ) :
    (∑ r : Fin (n+m), dualLowerNumeratorNat2520 (offset+r.val)) =
      (∑ r : Fin n, dualLowerNumeratorNat2520 (offset+r.val)) +
        ∑ r : Fin m, dualLowerNumeratorNat2520 ((offset+n)+r.val) := by
  rw [Fin.sum_univ_add]
  simp only [Fin.val_natAdd, Fin.val_castAdd, Nat.add_assoc]

