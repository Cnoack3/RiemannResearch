theorem conductor2520Combination_periodic (c : Fin 68 → ℝ) :
    Function.Periodic (conductor2520Combination c) 2520 := by
  intro k
  simp only [conductor2520Combination, conductor2520Generator_periodic]

theorem conductor2520Combination_error_bound (c : Fin 68 → ℝ) (k : ℕ) :
    (1-conductor2520Combination c k)^2 ≤
      ∑ r : Fin 2520, (1-conductor2520Combination c r.val)^2 := by
  exact RiemannResearch.Analysis.periodic_square_error_bound
    (conductor2520Combination c) 2520 (by norm_num) (conductor2520Combination_periodic c) k

theorem conductor2520Combination_error_summable (c : Fin 68 → ℝ) :
    Summable (fun k : ℕ => positiveWeight (k+1) *
      (1-conductor2520Combination c (k+1))^2) := by
  have hw : Summable (fun k : ℕ => positiveWeight (k+1)) :=
    positiveWeight_summable.comp_injective (by intro a b h; exact Nat.add_right_cancel h)
  apply Summable.of_nonneg_of_le
    (fun k => mul_nonneg (positiveWeight_nonneg _) (sq_nonneg _))
    (fun k => mul_le_mul_of_nonneg_left (conductor2520Combination_error_bound c _)
      (positiveWeight_nonneg _))
    (hw.mul_right _)

theorem conductor2520Combination_add_multiple (c : Fin 68 → ℝ) (r j : ℕ) :
    conductor2520Combination c (r+2520*j) = conductor2520Combination c r := by
  induction j with
  | zero => simp
  | succ j ih =>
    have h : r+2520*(j+1) = (r+2520*j)+2520 := by omega
    rw [h, conductor2520Combination_periodic c, ih]

theorem conductor2520Combination_exact_error (c : Fin 68 → ℝ) :
    (∑' k : ℕ, positiveWeight (k+1) * (1-conductor2520Combination c (k+1))^2) =
      ∑ r : Fin 2520, progressionWeight 2520 (r.val+1) *
        (1-conductor2520Combination c (r.val+1))^2 := by
  rw [Nat.sumByResidueClasses (conductor2520Combination_error_summable c) 2520]
  apply Finset.sum_congr rfl
  intro r _
  calc
    _ = ∑' j : ℕ, positiveWeight ((r.val+1)+2520*j) *
        (1-conductor2520Combination c (r.val+1))^2 := by
      apply tsum_congr
      intro j
      have h : r.val+2520*j+1 = (r.val+1)+2520*j := by omega
      rw [h, conductor2520Combination_add_multiple]
    _ = _ := by rw [tsum_mul_right]; rfl

/-- Unconditional full infinite-error lower bound for the conductor-2520 legal span. -/
theorem conductor2520Combination_full_error_gt (c : Fin 68 → ℝ) :
    (419 : ℝ) / 10000 <
      ∑' k : ℕ, positiveWeight (k+1) * (1-conductor2520Combination c (k+1))^2 := by
  rw [conductor2520Combination_exact_error]
  exact conductor2520_error_gt_of_weights c _ fun r =>
    residueLower2520_le_progressionWeight (r.val+1)

