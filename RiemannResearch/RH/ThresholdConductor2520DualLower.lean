private theorem residueLower2520_eq_int (k : ℕ) :
    residueLower2520 (k + 1) =
      (lowerWeightNumerator2520 k : ℝ) / (lowerWeightDenominator2520 k : ℝ) := by
  have h := RiemannResearch.Analysis.residue_lower_common_denominator
    ((k : ℝ) + 1) 2520 (by positivity) (by norm_num)
  simpa only [residueLower2520, lowerWeightNumerator2520, lowerWeightDenominator2520,
    Nat.cast_add, Nat.cast_one, Int.cast_add, Int.cast_mul, Int.cast_natCast,
    Int.cast_ofNat, Int.cast_zero, Int.cast_one, add_assoc,
    show (2520 : ℝ) + 1 = 2521 from by norm_num] using h

private theorem dualLowerCap2520_pointwise (r : Fin 2520) :
    dualLowerCap2520 r ≤ 2 * dual2520 r - (dual2520 r)^2 / residueLower2520 (r.val+1) := by
  have hc : (dualLowerNumeratorInt2520 r : ℝ) * (100000000 : ℝ)^2 *
        (lowerWeightNumerator2520 r.val : ℝ) ≤ (10000000000 : ℝ) *
      (2 * (dualNumeratorInt2520 r : ℝ) * 100000000 *
          (lowerWeightNumerator2520 r.val : ℝ) -
        (dualNumeratorInt2520 r : ℝ)^2 * (lowerWeightDenominator2520 r.val : ℝ)) := by
    have hi := dualLowerCapInt2520_pointwise r
    dsimp only [dualLowerCapCheck2520] at hi
    have hr : (⟨r.val % 2520, Nat.mod_lt _ (by norm_num)⟩ : Fin 2520) = r := by
      apply Fin.ext
      exact Nat.mod_eq_of_lt r.isLt
    rw [hr] at hi
    simp only [Nat.mod_eq_of_lt r.isLt] at hi
    exact_mod_cast hi
  have hA : (0 : ℝ) < (lowerWeightNumerator2520 r.val : ℝ) := by
    simp only [lowerWeightNumerator2520, Int.cast_mul, Int.cast_add,
      Int.cast_natCast, Int.cast_ofNat, Int.cast_zero, Int.cast_one]
    positivity
  have hB : (0 : ℝ) < (lowerWeightDenominator2520 r.val : ℝ) := by
    simp only [lowerWeightDenominator2520, Int.cast_mul, Int.cast_add,
      Int.cast_natCast, Int.cast_ofNat, Int.cast_zero, Int.cast_one]
    positivity
  rw [residueLower2520_eq_int]
  exact RiemannResearch.Analysis.lower_certificate_of_cross_mul _ _ _ _ _ _ hA hB (by norm_num) (by norm_num) hc

private theorem dual2520_lower_certificate :
    (419 : ℝ) / 10000 <
      ∑ r : Fin 2520, (2 * dual2520 r - (dual2520 r)^2 / residueLower2520 (r.val+1)) := by
  apply lt_of_lt_of_le _ (Finset.sum_le_sum (fun r _ => dualLowerCap2520_pointwise r))
  have hs : (∑ r : Fin 2520, (dualLowerNumeratorInt2520 r : ℝ)) = 419528990 := by
    exact_mod_cast dualLowerNumeratorInt2520_sum
  simp only [dualLowerCap2520]
  rw [← Finset.sum_div, hs]
  norm_num

/-- Every combination of all 68 conductor-2520 legal generators has error > .0419
for every true weight vector dominating the two retained progression terms. -/
theorem conductor2520_error_gt_of_weights (c : Fin 68 → ℝ)
    (w : Fin 2520 → ℝ) (hw : ∀ r, residueLower2520 (r.val+1) ≤ w r) :
    (419 : ℝ) / 10000 <
      ∑ r : Fin 2520, w r * (1-conductor2520Combination c (r.val+1))^2 := by
  apply lt_of_lt_of_le dual2520_lower_certificate
  apply le_trans (weighted_error_lower_of_dual
    (fun r => residueLower2520 (r.val+1)) dual2520
    (fun r => conductor2520Combination c (r.val+1))
    (by intro r; unfold residueLower2520; positivity)
    (dual2520_annihilates_combination c))
  exact Finset.sum_le_sum fun r _ => mul_le_mul_of_nonneg_right (hw r) (sq_nonneg _)

theorem residueLower2520_le_progressionWeight (r : ℕ) :
    residueLower2520 r ≤ progressionWeight 2520 r := by
  have he : residueLower2520 r = positiveWeight r + positiveWeight (r+2520) := by
    simp only [residueLower2520, positiveWeight, Nat.cast_add, Nat.cast_ofNat]
    congr 1 <;> congr 1 <;> ring
  rw [he, progressionWeight_split 2520 r (by norm_num),
    progressionWeight_split 2520 (r+2520) (by norm_num)]
  have hn := progressionWeight_nonneg 2520 (r+2520+2520)
  linarith

