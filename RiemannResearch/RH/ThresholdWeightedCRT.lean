import RiemannResearch.LinearAlgebra.WeightedFiniteQuotient
import RiemannResearch.RH.ParetoPeriodicRegrouping

/-!
# Exact conditional CRT matrices for the infinite Pareto weights

Source: user-provided `RH_Two_Seed_Threshold.tex`, September 8, 2026,
Section 10, equations `eq:crt-weights`, `eq:conditional-matrix` and
`eq:crt-exact-error`. The fine coordinates `(r,s)` mean the positive
representative `r+1+N*s` modulo `N*b`. In particular `(N-1,b-1)` retains
the complete zero congruence class. Every positive integer refinement factor
is allowed, without a restriction to a semigroup generated by 2 and 3.
All weights below are the actual infinite arithmetic progression sums.
-/

open scoped BigOperators

namespace RiemannResearch.LinearAlgebra.WeightedFiniteQuotient

noncomputable section

variable {ι κ : Type*} [Fintype ι] [Fintype κ] [DecidableEq ι]

theorem pushforward_fst (z : ι × κ → ℝ) (r : ι) :
    pushforward Prod.fst z r = ∑ s, z (r, s) := by
  simp only [pushforward, Fintype.sum_prod_type]
  rw [Finset.sum_comm]
  simp

end
end RiemannResearch.LinearAlgebra.WeightedFiniteQuotient

namespace RiemannResearch.RH.Pareto

noncomputable section

open RiemannResearch.LinearAlgebra.WeightedFiniteQuotient

/-- Genuine finer quotient weights in a positive residue chart. -/
def refinementWeight (N b : ℕ) (p : Fin N × Fin b) : ℝ :=
  progressionWeight (N * b) (p.1.val + 1 + N * p.2.val)

theorem refinementWeight_pos (N b : ℕ) (hN : 0 < N) (hb : 0 < b)
    (p : Fin N × Fin b) : 0 < refinementWeight N b p := by
  exact progressionWeight_pos (N * b) (p.1.val + 1 + N * p.2.val)
    (Nat.mul_pos hN hb) (by omega)

/-- Exact identification of the conditional denominator with the coarser
infinite quotient weight. No tail or boundary term is discarded. -/
theorem refinementWeight_pushforward (N b : ℕ) (hN : 0 < N) (hb : 0 < b)
    (r : Fin N) :
    pushforward Prod.fst (refinementWeight N b) r =
      progressionWeight N (r.val + 1) := by
  rw [pushforward_fst]
  exact (progressionWeight_compatibility N b (r.val + 1) hN hb).symm

theorem refinementWeight_mass_ne_zero (N b : ℕ) (hN : 0 < N) (hb : 0 < b)
    (r : Fin N) : pushforward Prod.fst (refinementWeight N b) r ≠ 0 := by
  rw [refinementWeight_pushforward N b hN hb]
  exact ne_of_gt (progressionWeight_pos N (r.val + 1) hN (by omega))

theorem refinementWeight_normalization (N b : ℕ) (hN : 0 < N) (hb : 0 < b) :
    (∑ p, refinementWeight N b p) = 1 := by
  rw [← pushforward_total Prod.fst (refinementWeight N b)]
  simp_rw [refinementWeight_pushforward N b hN hb]
  exact progressionWeight_normalization N hN

/-- Exact weighted conditional matrix in the `N` by `b` residue chart. -/
def refinementAverage (N b : ℕ) (x : Fin N × Fin b → ℝ) : Fin N → ℝ :=
  RiemannResearch.LinearAlgebra.WeightedFiniteQuotient.average
    Prod.fst (refinementWeight N b) x

theorem refinementAverage_formula (N b : ℕ) (hN : 0 < N) (hb : 0 < b)
    (x : Fin N × Fin b → ℝ) (r : Fin N) :
    refinementAverage N b x r =
      (∑ s : Fin b, progressionWeight (N * b) (r.val + 1 + N * s.val) * x (r, s)) /
        progressionWeight N (r.val + 1) := by
  unfold refinementAverage RiemannResearch.LinearAlgebra.WeightedFiniteQuotient.average
  rw [pushforward_fst, refinementWeight_pushforward N b hN hb]
  rfl

/-- Repetition followed by the true weighted CRT average is exactly the identity. -/
theorem refinementAverage_pullback (N b : ℕ) (hN : 0 < N) (hb : 0 < b)
    (g : Fin N → ℝ) :
    refinementAverage N b (fun p => g p.1) = g := by
  exact average_pullback Prod.fst (refinementWeight N b)
    (refinementWeight_mass_ne_zero N b hN hb) g

theorem refinementAverage_preserves_mean (N b : ℕ) (hN : 0 < N) (hb : 0 < b)
    (x : Fin N × Fin b → ℝ) :
    (∑ r : Fin N, progressionWeight N (r.val + 1) * refinementAverage N b x r) =
      ∑ p, refinementWeight N b p * x p := by
  have h := average_preserves_sum Prod.fst (refinementWeight N b) x
    (refinementWeight_mass_ne_zero N b hN hb)
  simpa only [refinementAverage, refinementWeight_pushforward N b hN hb] using h

/-- The concrete infinite-weight CRT decomposition retains the full fine defect. -/
theorem refinement_error_decomposition (N b : ℕ) (hN : 0 < N) (hb : 0 < b)
    (x : Fin N × Fin b → ℝ) (g : Fin N → ℝ) :
    (∑ p, refinementWeight N b p * (x p - g p.1) ^ 2) =
      (∑ p, refinementWeight N b p *
        (x p - refinementAverage N b x p.1) ^ 2) +
      ∑ r : Fin N, progressionWeight N (r.val + 1) *
        (refinementAverage N b x r - g r) ^ 2 := by
  have h := error_decomposition Prod.fst (refinementWeight N b) x g
    (refinementWeight_mass_ne_zero N b hN hb)
  simpa only [refinementAverage, refinementWeight_pushforward N b hN hb] using h

/-- Two genuine arithmetic refinements, with the exact positive representatives. -/
theorem progressionWeight_refinement_tower (N b c r : ℕ)
    (hN : 0 < N) (hb : 0 < b) (hc : 0 < c) :
    progressionWeight N r = ∑ s : Fin b, ∑ t : Fin c,
      progressionWeight (N * b * c) (r + N * s.val + N * b * t.val) := by
  rw [progressionWeight_compatibility N b r hN hb]
  apply Finset.sum_congr rfl
  intro s _
  exact progressionWeight_compatibility (N * b) c (r + N * s.val)
    (Nat.mul_pos hN hb) hc

end
end RiemannResearch.RH.Pareto
