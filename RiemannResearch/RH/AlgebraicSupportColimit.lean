import RiemannResearch.RH.PrimeSupportAlgebraDescent
import Mathlib.CategoryTheory.Limits.IsLimit
import Mathlib.Topology.Baire.CompleteMetrizable
import Mathlib.Topology.Baire.Lemmas

/-!
# The ordinary algebra colimit of the prime-support quotients

The algebraic colimit kills the supremum of the finite-stage ideals. Taking its
Hausdorff quotient kills the closure of that ideal, which is the whole mixed
ideal. The comparison to the screened scalar quotient is canonical.
-/

noncomputable section

open CategoryTheory
namespace RiemannResearch.RH.Pareto.PrimePowerSchur.MixedConductorBasis
open CoefficientStabilization LegalMeanAlgebra
open scoped LegalMeanAlgebra

/-- The ideal generated by all the stages before taking a topological closure. -/
def algebraicSupportIdeal : Ideal closedSpace := ⨆ n, supportIdeal n

theorem supportIdeal_le_algebraic (n : ℕ) : supportIdeal n ≤ algebraicSupportIdeal :=
  le_iSup supportIdeal n

theorem algebraicSupportIdeal_le_mixed : algebraicSupportIdeal ≤ mixedIdeal :=
  iSup_le supportIdeal_le_mixed

section IdealTower
variable {A : Type} [CommRing A] [Algebra ℝ A] (I : ℕ → Ideal A) (hI : Monotone I)

private theorem idealCocone_rep (s : Limits.Cocone (idealTower I hI)) (n : ℕ) (v : A) :
    (s.ι.app n) (Ideal.Quotient.mk (I n) v) = (s.ι.app 0) (Ideal.Quotient.mk (I 0) v) :=
  ConcreteCategory.congr_hom (s.w (homOfLE (Nat.zero_le n))) (Ideal.Quotient.mk (I 0) v)

private def idealUnionDesc (s : Limits.Cocone (idealTower I hI)) : (A ⧸ ⨆ n, I n) →ₐ[ℝ] s.pt := by
  let T : A →ₐ[ℝ] s.pt := (s.ι.app 0).hom.comp (Ideal.Quotient.mkₐ ℝ (I 0))
  have hT : (⨆ n, I n) ≤ RingHom.ker T.toRingHom := by
    refine iSup_le fun n v hv => ?_
    change (s.ι.app 0) (Ideal.Quotient.mk (I 0) v) = 0
    rw [← idealCocone_rep I hI s n v, (Ideal.Quotient.eq_zero_iff_mem).2 hv]
    exact map_zero (s.ι.app n).hom
  exact Ideal.Quotient.liftₐ _ T (fun v hv => hT hv)

/-- In ordinary real algebras an increasing tower of quotient ideals has colimit
the quotient by their supremum. -/
def idealUnionIsColimit : Limits.IsColimit (idealCocone I hI (⨆ n, I n) (le_iSup I)) where
  desc s := AlgCat.ofHom (idealUnionDesc I hI s)
  fac s n := by
    apply ConcreteCategory.hom_ext
    intro q
    obtain ⟨v, rfl⟩ := Ideal.Quotient.mk_surjective q
    exact (idealCocone_rep I hI s n v).symm
  uniq s f hf := by
    apply ConcreteCategory.hom_ext
    intro q
    obtain ⟨v, rfl⟩ := Ideal.Quotient.mk_surjective q
    exact ConcreteCategory.congr_hom (hf 0) (Ideal.Quotient.mk (I 0) v)

end IdealTower

/-- Cocone in ordinary real algebras, before Hausdorff separation. -/
def algebraicSupportCocone : Limits.Cocone supportAlgebraTower :=
  idealCocone supportIdeal supportIdeal_mono algebraicSupportIdeal supportIdeal_le_algebraic

/-- The full categorical universal property, with arbitrary algebra targets. -/
def algebraicSupportIsColimit : Limits.IsColimit algebraicSupportCocone :=
  idealUnionIsColimit supportIdeal supportIdeal_mono

/-- The canonical comparison to the Hausdorff algebra quotient. -/
def supportSeparation :
    (closedSpace ⧸ algebraicSupportIdeal) →ₐ[ℝ] (closedSpace ⧸ mixedIdeal) :=
  Ideal.Quotient.factorₐ ℝ algebraicSupportIdeal_le_mixed

theorem supportSeparation_eq_colimit_desc :
    AlgCat.ofHom supportSeparation = algebraicSupportIsColimit.desc supportAlgebraCocone := by
  apply ConcreteCategory.hom_ext
  intro q
  obtain ⟨v, rfl⟩ := Ideal.Quotient.mk_surjective q
  rfl

theorem supportSeparation_shortExact :
    supportSeparation.toLinearMap.shortComplexKer.ShortExact := by
  apply LinearMap.shortExact_shortComplexKer
  intro q
  obtain ⟨v, rfl⟩ := Ideal.Quotient.mk_surjective q
  exact ⟨Ideal.Quotient.mk algebraicSupportIdeal v, rfl⟩

theorem supportSeparation_kernel_mk_iff (v : closedSpace) :
    Ideal.Quotient.mk algebraicSupportIdeal v ∈ supportSeparation.toLinearMap.ker ↔
      v ∈ mixedIdeal :=
  Ideal.Quotient.eq_zero_iff_mem

/-- Closing the algebraic support ideal kills precisely the mixed closure. -/
theorem algebraicSupportIdeal_closure : algebraicSupportIdeal.closure = mixedIdeal := by
  apply le_antisymm
  · exact closure_minimal algebraicSupportIdeal_le_mixed
      (isClosed_eq legalPacketMean.continuous continuous_const)
  · let K : Submodule ℝ mixedClosure :=
      (algebraicSupportIdeal.closure.restrictScalars ℝ).comap legalMixedInclusion.toLinearMap
    have hK : IsClosed (K : Set mixedClosure) :=
      (isClosed_closure : IsClosed (closure (algebraicSupportIdeal : Set closedSpace))).preimage
        legalMixedInclusion.continuous
    have hs : (⨆ n, supportSpace n) ≤ K := by
      refine iSup_le fun n x hx => ?_
      change legalMixedInclusion x ∈ closure (algebraicSupportIdeal : Set closedSpace)
      exact subset_closure (supportIdeal_le_algebraic n
        (show legalMixedInclusion x ∈ supportIdeal n from ⟨x, hx, rfl⟩))
    have hd := Submodule.topologicalClosure_minimal _ hs hK
    rw [supportSpace_dense] at hd
    intro v hv
    exact hd (show (⟨v.val, (mem_mixedIdeal v).1 hv⟩ : mixedClosure) ∈ ⊤ from trivial)

/-- Continuity of the comparison for the quotient topologies. -/
theorem supportSeparation_continuous : Continuous supportSeparation :=
  (QuotientRing.isOpenQuotientMap_mk algebraicSupportIdeal).isQuotientMap.continuous_iff.2
    (QuotientRing.isOpenQuotientMap_mk mixedIdeal).continuous

/-- The comparison kills exactly the closure of zero in the algebraic colimit. -/
theorem supportSeparation_kernel_eq_closure_zero :
    (supportSeparation.toLinearMap.ker : Set (closedSpace ⧸ algebraicSupportIdeal)) =
      closure ({0} : Set (closedSpace ⧸ algebraicSupportIdeal)) := by
  let q := Ideal.Quotient.mk algebraicSupportIdeal
  have hp : q ⁻¹' ({0} : Set (closedSpace ⧸ algebraicSupportIdeal)) =
      (algebraicSupportIdeal : Set closedSpace) := by
    ext v
    exact Ideal.Quotient.eq_zero_iff_mem
  have hc := (QuotientRing.isOpenMap_coe algebraicSupportIdeal).preimage_closure_eq_closure_preimage
    (QuotientRing.isOpenQuotientMap_mk algebraicSupportIdeal).continuous
    ({0} : Set (closedSpace ⧸ algebraicSupportIdeal))
  change q ⁻¹' closure ({0} : Set (closedSpace ⧸ algebraicSupportIdeal)) =
    closure (q ⁻¹' ({0} : Set (closedSpace ⧸ algebraicSupportIdeal))) at hc
  rw [hp] at hc
  have hm : closure (algebraicSupportIdeal : Set closedSpace) = (mixedIdeal : Set closedSpace) :=
    congrArg (fun I : Ideal closedSpace => (I : Set closedSpace)) algebraicSupportIdeal_closure
  rw [hm] at hc
  ext z
  obtain ⟨v, rfl⟩ := Ideal.Quotient.mk_surjective z
  exact (supportSeparation_kernel_mk_iff v).trans (Set.ext_iff.mp hc v).symm

/-- The support filtration exhausts the mixed space only after taking its closure. -/
theorem exists_mixed_outside_support_stages :
    ∃ m : mixedClosure, ∀ n : ℕ, m ∉ supportSpace n := by
  let : CompleteSpace mixedClosure :=
    (show IsClosed (mixedClosure : Set ThresholdHilbert) from isClosed_closure).completeSpace_coe
  by_contra! h
  have hcover : (⋃ n : ℕ, (supportSpace n : Set mixedClosure)) = Set.univ :=
    Set.eq_univ_of_forall fun m => Set.mem_iUnion.mpr (h m)
  obtain ⟨n, hn⟩ := nonempty_interior_of_iUnion_of_closed
    (fun n : ℕ => (show IsClosed (supportSpace n : Set mixedClosure) from isClosed_closure))
    hcover
  have ht : supportSpace n = ⊤ := (supportSpace n).eq_top_of_nonempty_interior' hn
  have hle : (⊤ : Submodule ℝ mixedClosure) ≤ supportSpace (n + 1) := by
    simpa only [ht] using supportSpace_mono (Nat.le_succ n)
  exact (supportSpace_strict (n + 1) (Nat.succ_pos n)).not_ge (le_top.trans hle)

/-- The algebraic directed union of support ideals is strictly smaller than the
mixed ideal. -/
theorem supportIdeal_iSup_lt_mixed : algebraicSupportIdeal < mixedIdeal := by
  refine lt_of_le_of_ne (iSup_le supportIdeal_le_mixed) ?_
  intro he
  obtain ⟨m, hm⟩ := exists_mixed_outside_support_stages
  have hv : legalMixedInclusion m ∈ algebraicSupportIdeal := by
    rw [he]
    exact legalPacketMean_legalMixedInclusion m
  obtain ⟨n, hn⟩ :=
    (Submodule.mem_iSup_of_directed supportIdeal supportIdeal_mono.directed_le).mp hv
  obtain ⟨m', hm', he'⟩ := hn
  have em : m' = m :=
    Subtype.ext (congrArg (fun v : closedSpace => (v : ThresholdHilbert)) he')
  exact hm n (em ▸ hm')

/-- The canonical comparison from the algebraic quotient by the union to the
Hausdorff quotient by the mixed ideal has nontrivial kernel. -/
theorem supportIdeal_comparison_not_injective :
    ¬ Function.Injective supportSeparation := by
  intro hi
  apply supportIdeal_iSup_lt_mixed.not_ge
  intro v hv
  apply (Ideal.Quotient.eq_zero_iff_mem).mp
  apply hi
  change supportSeparation (Ideal.Quotient.mk algebraicSupportIdeal v) = supportSeparation 0
  rw [map_zero]
  change Ideal.Quotient.mk mixedIdeal v = 0
  exact (Ideal.Quotient.eq_zero_iff_mem).mpr hv

/-- The kernel is precisely the image of the mixed ideal under the algebraic quotient. -/
theorem supportSeparation_ker_eq_mixed_image :
    supportSeparation.toLinearMap.ker =
      (mixedIdeal.restrictScalars ℝ).map
        (Ideal.Quotient.mkₐ ℝ algebraicSupportIdeal).toLinearMap := by
  ext z
  constructor
  · obtain ⟨v, rfl⟩ := Ideal.Quotient.mk_surjective z
    exact fun hv => ⟨v, (supportSeparation_kernel_mk_iff v).1 hv, rfl⟩
  · rintro ⟨v, hv, rfl⟩
    exact (supportSeparation_kernel_mk_iff v).2 hv

/-- In ordinary real algebras the closed-ideal quotient fails the colimit universal property. -/
theorem supportAlgebraCocone_not_isColimit :
    ¬ Nonempty (Limits.IsColimit supportAlgebraCocone) := by
  rintro ⟨h⟩
  apply supportIdeal_comparison_not_injective
  let f := h.desc algebraicSupportCocone
  have hleft (q : closedSpace ⧸ algebraicSupportIdeal) : f (supportSeparation q) = q := by
    obtain ⟨v, rfl⟩ := Ideal.Quotient.mk_surjective q
    exact ConcreteCategory.congr_hom (h.fac algebraicSupportCocone 0)
      (Ideal.Quotient.mk (supportIdeal 0) v)
  exact Function.LeftInverse.injective hleft

end RiemannResearch.RH.Pareto.PrimePowerSchur.MixedConductorBasis
