/-- Product 1·3·...·(2n−1), with the empty product at n=0. -/
def oddProduct : ℕ → ℕ
  | 0 => 1
  | n+1 => (2*n+1) * oddProduct n

/-- Monomial coefficient of 2^n n! L_j^(-1/2)(2y), for k ≤ j ≤ n. -/
def monomialCoefficient (n j k : ℕ) : ℤ :=
  let choose := j.factorial / (k.factorial * (j-k).factorial)
  let odd := oddProduct j / oddProduct k
  let common := 2^(n-j) * (n.factorial / j.factorial)
  (-4 : ℤ)^k * ((common * choose * odd : ℕ) : ℤ)

/-- Joint-scale monomial coefficients for a finite Gaussian–Laguerre pair.
Each row uses the closed coefficient (-4)^k binom(j,k) (2j−1)!!/(2k−1)!!.
The Fourier side includes the eigenvalue (-1)^j. -/
def polynomialsOf (weights : List ℤ) : List ℤ × List ℤ :=
  let n := weights.length - 1
  let expand (fourier : Bool) (k : ℕ) := ((List.range (n-k+1)).map fun h =>
    let j := k+h
    let parity : ℤ := if fourier then (-1)^j else 1
    parity * weights.getD j 0 * monomialCoefficient n j k).sum
  ((List.range weights.length).map (expand false),
   (List.range weights.length).map (expand true))

