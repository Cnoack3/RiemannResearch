set_option maxRecDepth 100000 in
set_option maxHeartbeats 12000000 in
private theorem inputCheck : checkQuadratics inputQuadratics
    (clearScale (10^19) inputPolynomial) = true := by decide +kernel

set_option maxRecDepth 100000 in
set_option maxHeartbeats 12000000 in
private theorem fourierCheck : checkQuadratics fourierQuadratics
    (clearScale (10^19) (scale (-1) (shift 3 fourierPolynomial))) = true := by decide +kernel

/-- The Fourier normalization is strictly positive. -/
theorem fourierPolynomial_zero_pos : 0 < value fourierPolynomial 0 := by
  rw [value_at_zero, Int.cast_pos]
  decide +kernel

theorem inputPolynomial_pos {x : ℝ} (hx : 0 ≤ x) : 0 < value inputPolynomial x :=
  positive_of_scaled_quadratics (10^19) (by norm_num) _ _ inputCheck hx

theorem fourierPolynomial_neg {x : ℝ} (hx : 3 ≤ x) : value fourierPolynomial x < 0 := by
  have h := positive_of_scaled_quadratics (10^19) (by norm_num) _ _ fourierCheck
    (sub_nonneg.mpr hx)
  rw [value_scale, value_shift] at h
  have hx' : ((3 : ℤ) : ℝ)+(x-3)=x := by push_cast; ring
  rw [hx'] at h
  simpa using h

