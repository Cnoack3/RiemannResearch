[Unit]
Description=Private GCS bridge for native Lake artifact caching
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=cri_2025
ExecStart=/usr/bin/python3 /home/cri_2025/lean-projects/RiemannResearch/tools/lean_gcs_bridge.py --project project-c5cfd87b-fbe8-47ea-9d0 --bucket riemann_lean_cache --port 8765 --temp-dir /home/cri_2025/.local/share/lean-gcs-cache/tmp --credentials-file /home/cri_2025/.config/lean-gcs-cache/hmac.json
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
