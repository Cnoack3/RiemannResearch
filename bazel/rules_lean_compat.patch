diff --git a/lean/private/forbid_sorry.lean b/lean/private/forbid_sorry.lean
new file mode 100644
index 0000000..3e68a95
--- /dev/null
+++ b/lean/private/forbid_sorry.lean
@@ -0,0 +1,21 @@
+import Lean
+
+open Lean
+
+/-- Check compiled declarations even when source code suppresses sorry warnings. -/
+def main (args : List String) : IO UInt32 := do
+  let [moduleName, setupFile, sysroot] := args
+    | throw <| IO.userError "expected module name, setup file, and toolchain root"
+  initSearchPath sysroot
+  let json ← IO.ofExcept <| Json.parse (← IO.FS.readFile setupFile)
+  let setup : ModuleSetup ← IO.ofExcept <| fromJson? json
+  let module := moduleName.toName
+  let env ← importModules #[{ module, importAll := true }] {} (arts := setup.importArts)
+  let some index := env.header.moduleNames.findIdx? (· == module)
+    | throw <| IO.userError s!"missing compiled module {moduleName}"
+  let mut failed := false
+  for info in env.header.moduleData[index]!.constants do
+    if info.type.hasSorry || (info.value? (allowOpaque := true)).any (·.hasSorry) then
+      IO.eprintln s!"error: {moduleName}: {info.name} uses sorry, but forbid_sorry is enabled"
+      failed := true
+  return if failed then 1 else 0
