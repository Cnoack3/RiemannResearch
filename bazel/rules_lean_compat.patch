@@ -0,0 +1,163 @@
+#!/usr/bin/env python3
+"""Turn an isolated Lake cache fetch into a portable prebuilt-module repository.
+
+Only the requested import closure survives. In particular, Lake's locally built
+cache executable, traces, setup JSON, Git checkouts and download cache do not.
+"""
+
+import argparse
+import json
+from pathlib import Path
+import re
+import shutil
+
+SUFFIXES = (".olean", ".olean.private", ".olean.server", ".ir", ".ir.sig")
+STDLIB = {"Init", "Lean", "Std", "Lake"}
+
+
+def strip_comments(text):
+    """Remove nested Lean comments while preserving header line boundaries."""
+    out = []
+    i = depth = 0
+    quoted = False
+    while i < len(text):
+        pair = text[i:i + 2]
+        if depth:
+            if pair == "/-":
+                depth += 1
+                i += 2
+            elif pair == "-/":
+                depth -= 1
+                i += 2
+            else:
+                if text[i] == "\n":
+                    out.append("\n")
+                i += 1
+        elif quoted:
+            out.append(text[i])
+            if text[i] == "\\" and i + 1 < len(text):
+                i += 1
+                out.append(text[i])
+            elif text[i] == '"':
+                quoted = False
+            i += 1
+        elif pair == "/-":
+            out.append(" ")
+            depth = 1
+            i += 2
+        elif pair == "--":
+            end = text.find("\n", i)
+            i = len(text) if end < 0 else end
+        else:
+            quoted = text[i] == '"'
+            out.append(text[i])
+            i += 1
+    if depth:
+        raise ValueError("unterminated Lean block comment")
+    return "".join(out)
+
+
+def header(text):
+    imports = []
+    module_system = expect_module = allow_all = False
+    for token in strip_comments(text).split():
+        if expect_module:
+            if allow_all and token == "all":
+                allow_all = False
+                continue
+            imports.append(token)
+            expect_module = False
+        elif token == "module":
+            module_system = True
+        elif token in ("prelude", "public", "meta"):
+            continue
+        elif token == "import":
+            expect_module = allow_all = True
+        else:
+            break
+    return list(dict.fromkeys(imports)), module_system
+
+
+def normalize(bootstrap, output, modules, packages_dir=None):
+    bootstrap, output = Path(bootstrap), Path(output)
+    manifest = json.loads((bootstrap / "lake-manifest.json").read_text())
+    packages_dir = Path(packages_dir) if packages_dir else bootstrap / manifest.get("packagesDir", ".lake/packages")
+    roots = [bootstrap]
+    for package in manifest.get("packages", []):
+        root = packages_dir / package["name"]
+        if package.get("subDir"):
+            root /= package["subDir"]
+        roots.append(root)
+
+    graph, artifacts = {}, {}
+    pending = list(modules or ["Mathlib"])
+    while pending:
+        mod = pending.pop()
+        if mod in graph or mod.split(".")[0] in STDLIB:
+            continue
+        if not re.fullmatch(r"[^\s/\\]+(?:\.[^\s/\\]+)*", mod):
+            raise ValueError("invalid module name: " + mod)
+        relative = Path(*mod.split("."))
+        matches = [(root, root / relative.with_suffix(".lean")) for root in roots]
+        matches = [(root, source) for root, source in matches if source.is_file()]
+        if len(matches) != 1:
+            raise ValueError("expected one source for %s, found %d" % (mod, len(matches)))
+        root, source = matches[0]
+        imports, module_system = header(source.read_text())
+        graph[mod] = imports
+        pending.extend(imports)
+        prefix = root / ".lake/build/lib/lean" / relative
+        files = [(suffix, Path(str(prefix) + suffix)) for suffix in SUFFIXES]
+        required = SUFFIXES if module_system else (".olean",)
+        missing = [suffix for suffix, path in files if suffix in required and not path.is_file()]
+        if missing:
+            raise ValueError("cache is missing compiled outputs for %s: %s" % (mod, ", ".join(missing)))
+        artifacts[mod] = [(suffix, path) for suffix, path in files if path.is_file()]
+
+    lines = ['load("@rules_lean//lean:defs.bzl", "lean_prebuilt_library")',
+             'package(default_visibility = ["//visibility:public"])', ""]
+    q = lambda value: json.dumps(value, ensure_ascii=False, sort_keys=True)
+    all_files = []
+    for mod in sorted(graph):
+        files = []
+        for suffix, source in artifacts[mod]:
+            relative = "lib/lean/" + mod.replace(".", "/") + suffix
+            target = output / relative
+            target.parent.mkdir(parents=True, exist_ok=True)
+            # A real file keeps this repository independent of its bootstrap and
+            # other external repositories. File modes are intentionally normalized.
+            shutil.copyfile(source, target)
+            target.chmod(0o644)
+            files.append(relative)
+        all_files.extend(files)
+        deps = [":" + dep for dep in graph[mod] if dep in graph]
+        lines.extend([
+            "lean_prebuilt_library(", "    name = %s," % q(mod),
+            "    srcs = %s," % q(files), '    root = "lib/lean",',
+            "    internal_imports = %s," % q({mod: graph[mod]}),
+            "    deps = %s," % q(deps), ")", "",
+        ])
+    # The aggregate also carries exact module metadata, so consumers can select
+    # just their own transitive imports instead of declaring all Mathlib inputs.
+    lines.extend([
+        "lean_prebuilt_library(", '    name = "mathlib",',
+        "    srcs = %s," % q(all_files), '    root = "lib/lean",',
+        "    internal_imports = %s," % q(graph), ")", "",
+    ])
+    (output / "BUILD.bazel").write_text("\n".join(lines))
+    (output / "modules.json").write_text(q(graph) + "\n")
+    print("Prepared %d modules (%d compiled files)" % (len(graph), len(all_files)))
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--bootstrap", required=True)
+    parser.add_argument("--output", required=True)
+    parser.add_argument("--packages-dir")
+    parser.add_argument("modules", nargs="*")
+    args = parser.parse_args()
+    normalize(args.bootstrap, args.output, args.modules, args.packages_dir)
+
+
+if __name__ == "__main__":
+    main()
