load("@rules_lean//lean:defs.bzl", "lean_library")

package(default_visibility = ["//visibility:public"])

exports_files([
    "MODULE.bazel",
    "lake-manifest.json",
    "lakefile.toml",
    "lean-toolchain",
])

_LEAN_FLAGS = [
    "-Dpp.unicode.fun=true",
    "-DrelaxedAutoImplicit=false",
    "-Dweak.linter.mathlibStandardSet=true",
    "-DmaxSynthPendingDepth=3",
]

# The rule creates one action per source and follows its exact import closure.
lean_library(
    name = "RiemannResearch",
    srcs = glob(
        ["RiemannResearch.lean", "RiemannResearch/**/*.lean"],
        exclude = ["RiemannResearch/Basic.lean"],
    ),
    deps = [
        ":basic",
        "@mathlib//:mathlib",
        "@LeanArchitect//:Architect",
        "@PrimeNumberTheoremAnd//:PrimeNumberTheoremAnd.SmoothExistence",
        "@PrimeNumberTheoremAnd//:PrimeNumberTheoremAnd.Mathlib.Analysis.Asymptotics.Asymptotics",
    ],
    extra_flags = _LEAN_FLAGS,
    forbid_sorry = True,
)

lean_library(
    name = "basic",
    srcs = ["RiemannResearch/Basic.lean"],
    deps = ["@mathlib//:Mathlib.Tactic.NormNum"],
    extra_flags = _LEAN_FLAGS,
    forbid_sorry = True,
)

alias(name = "smoke", actual = ":basic")
